---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/800.css';
import { ADMIN_COOKIE_NAME as COOKIE_NAME, verifySessionToken } from '../../../../lib/adminSession';

export const prerender = false;

const SUPABASE_URL =
  (import.meta.env.PUBLIC_SUPABASE_URL ??
  import.meta.env.VITE_SUPABASE_URL ??
  process.env.PUBLIC_SUPABASE_URL ??
  process.env.VITE_SUPABASE_URL ??
  process.env['PUBLIC-SUPABASE_URL'] ?? '').trim().replace(/^["']|["']$/g, '').replace(/\/$/, '');

const SUPABASE_KEY =
  (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_ANON_KEY ??
  process.env.PUBLIC_SUPABASE_ANON_KEY ??
  process.env.VITE_SUPABASE_ANON_KEY ??
  process.env['PUBLIC-SUPABASE_ANON_KEY'] ?? '').trim().replace(/^["']|["']$/g, '');
const ADMIN_SESSION_SECRET =
  import.meta.env.ADMIN_SESSION_SECRET ?? process.env.ADMIN_SESSION_SECRET ?? '';

const legalDocs = [
  { id: 'politica-datos', title: 'Política de Tratamiento de Datos' },
  { id: 'privacidad',     title: 'Aviso de Privacidad' },
  { id: 'terminos',       title: 'Términos y Condiciones' },
  { id: 'manual',         title: 'Manual de Procedimientos' },
  { id: 'sarlaft',        title: 'SARLAFT' },
];

const isAuth = verifySessionToken(Astro.cookies.get(COOKIE_NAME)?.value, ADMIN_SESSION_SECRET);
if (!isAuth) return Astro.redirect('/admin/landing-page');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Normatividad — Admin FINTEGRAR</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <style is:global>
    :root {
      --admin-surface: var(--color-admin-surface);
      --admin-border: var(--color-admin-border);
      --admin-border-hover: var(--color-admin-border-hover);
      --admin-text-muted: var(--color-admin-text-muted);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--ff-sans);
      background: var(--admin-surface);
      color: var(--color-navy);
      min-height: 100vh;
    }

    .admin-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      min-height: 100vh;
    }

        .sidebar {
      background: var(--color-navy);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    .sidebar-brand {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 1.5rem 1.25rem 1.25rem;
      border-bottom: 1px solid rgba(var(--color-white-rgb), 0.07);
    }
    .sidebar-brand-icon {
      width: 36px; height: 36px;
      background: var(--color-brand-yellow);
      border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .sidebar-brand-icon svg { color: var(--color-navy); }
    .sidebar-brand-text strong {
      display: block; font-size: 0.9rem; font-weight: var(--fw-extrabold); color: var(--color-white);
    }
    .sidebar-brand-text span {
      font-size: 0.7rem; color: rgba(var(--color-white-rgb), 0.35); font-weight: var(--fw-medium);
    }
    .sidebar-nav { flex: 1; padding: 1rem 0.75rem; }
    .sidebar-nav-label {
      font-size: 0.62rem; font-weight: var(--fw-extrabold);      text-transform: uppercase; color: rgba(var(--color-white-rgb), 0.25);
      padding: 0 0.5rem; margin-bottom: 0.5rem; margin-top: 1.25rem;
    }
    .sidebar-nav-label:first-child { margin-top: 0; }
    .sidebar-link {
      display: flex; align-items: center; gap: 0.625rem;
      padding: 0.6rem 0.75rem; border-radius: var(--radius-sm);
      font-size: 0.8125rem; font-weight: var(--fw-semibold);
      color: rgba(var(--color-white-rgb), 0.55);
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
      margin-bottom: 0.125rem;
    }
    .sidebar-link svg { flex-shrink: 0; opacity: 0.7; }
    .sidebar-link:hover { background: rgba(var(--color-white-rgb), 0.07); color: var(--color-white); }
    .sidebar-link:hover svg { opacity: 1; }
    .sidebar-link.is-active { background: rgba(var(--color-brand-yellow-rgb), 0.14); color: var(--color-brand-yellow); }
    .sidebar-link.is-active svg { opacity: 1; }
    .sidebar-footer {
      padding: 1rem 0.75rem;
      border-top: 1px solid rgba(var(--color-white-rgb), 0.07);
    }
    .sidebar-logout {
      display: flex; align-items: center; gap: 0.625rem;
      padding: 0.6rem 0.75rem; border-radius: var(--radius-sm);
      font-size: 0.8rem; font-weight: var(--fw-semibold);
      color: rgba(var(--color-white-rgb), 0.35);
      cursor: pointer; border: none; background: transparent;
      width: 100%; text-align: left;
      transition: background 0.15s, color 0.15s;
    }
    .sidebar-logout:hover { background: rgba(var(--color-danger-rgb), 0.12); color: var(--color-danger-light); }

        .main-content { display: flex; flex-direction: column; min-height: 100vh; }

    .topbar {
      background: var(--color-white);
      border-bottom: 1px solid var(--admin-border);
      box-shadow: 0 1px 4px rgba(var(--color-navy-rgb), 0.05);
      padding: 0 2rem; height: 60px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; position: sticky; top: 0; z-index: 10;
    }
    .topbar-breadcrumb {
      display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem;
    }
    .topbar-breadcrumb a {
      color: var(--admin-text-muted); text-decoration: none; font-weight: var(--fw-medium);
      transition: color 0.15s;
    }
    .topbar-breadcrumb a:hover { color: var(--color-navy); }
    .topbar-breadcrumb span { color: var(--admin-border); }
    .topbar-breadcrumb strong { color: var(--color-navy); font-weight: var(--fw-bold); }
    .topbar-right { display: flex; align-items: center; gap: 1rem; }
    .topbar-badge {
      display: inline-flex; align-items: center; gap: 0.375rem;
      background: var(--color-success-bg); color: var(--color-success-text);
      border-radius: var(--radius-full); padding: 0.3rem 0.75rem;
      font-size: 0.7rem; font-weight: var(--fw-bold);
    }
    .topbar-badge-dot { width: 6px; height: 6px; background: var(--color-success-dot); border-radius: 50%; }
    .topbar-visit {
      display: inline-flex; align-items: center; gap: 0.375rem;
      font-size: 0.8rem; font-weight: var(--fw-semibold); color: var(--admin-text-muted);
      text-decoration: none; transition: color 0.15s;
    }
    .topbar-visit:hover { color: var(--color-navy); }

        .page-content { flex: 1; padding: 2rem; max-width: 1000px; }

    .page-header {
      display: flex; align-items: flex-start;
      justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .page-header-text h1 {
      font-size: 1.375rem; font-weight: var(--fw-extrabold); color: var(--color-navy); margin-bottom: 0.25rem;
    }
    .page-header-text p { font-size: 0.875rem; color: var(--admin-text-muted); }

    .add-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      background: var(--color-navy); color: var(--color-white);
      font-size: 0.875rem; font-weight: var(--fw-bold);
      border: none; border-radius: var(--radius-sm); cursor: pointer;
      box-shadow: 0 2px 8px rgba(var(--color-navy-rgb), 0.2);
      transition: opacity 0.15s, box-shadow 0.15s;
      white-space: nowrap; flex-shrink: 0;
    }
    .add-btn:hover { opacity: 0.88; box-shadow: 0 4px 14px rgba(var(--color-navy-rgb), 0.28); }

        .stats-bar {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 1rem;
    }
    .doc-count {
      font-size: 0.775rem; font-weight: var(--fw-semibold); color: var(--admin-text-muted);
    }

        .doc-list { display: flex; flex-direction: column; gap: 0.625rem; }

    .doc-row {
      background: var(--color-white);
      border: 1px solid var(--admin-border);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      display: flex; align-items: center; gap: 1rem;
      box-shadow: 0 1px 3px rgba(var(--color-navy-rgb), 0.04), 0 2px 8px rgba(var(--color-navy-rgb), 0.04);
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    }
    .doc-row:hover {
      border-color: rgba(var(--color-navy-rgb), 0.18);
      box-shadow: 0 4px 16px rgba(var(--color-navy-rgb), 0.09);
      transform: translateY(-1px);
    }
    .doc-row-icon {
      width: 42px; height: 42px; flex-shrink: 0;
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      color: var(--color-navy);
    }
    .doc-row-body { flex: 1; min-width: 0; }
    .doc-row-title {
      font-size: 0.9rem; font-weight: var(--fw-bold); color: var(--color-navy);
      margin-bottom: 0.2rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .doc-row-meta {
      display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap;
    }
    .cat-tag {
      display: inline-block;
      font-size: 0.63rem; font-weight: var(--fw-bold);      text-transform: uppercase;
      background: rgba(var(--color-navy-rgb), 0.07); color: var(--color-navy);
      padding: 0.18rem 0.6rem; border-radius: var(--radius-full);
    }
    .date-chip {
      font-size: 0.75rem; color: var(--admin-text-muted); font-weight: var(--fw-medium);
      display: inline-flex; align-items: center; gap: 0.3rem;
    }
    .file-chip {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.75rem; font-weight: var(--fw-semibold); color: var(--color-success);
    }
    .file-chip.no-file { color: var(--color-text-subtle); }

    .doc-row-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
    .btn-edit, .btn-del {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.4rem 0.875rem; border-radius: var(--radius-sm);
      font-size: 0.775rem; font-weight: var(--fw-bold);
      border: 1px solid; cursor: pointer; transition: background 0.15s, border-color 0.15s;
    }
    .btn-edit {
      background: var(--admin-surface); color: var(--color-navy); border-color: var(--admin-border);
    }
    .btn-edit:hover { background: var(--admin-border); border-color: var(--admin-border-hover); }
    .btn-del {
      background: var(--color-danger-bg); color: var(--color-danger); border-color: var(--color-danger-border);
    }
    .btn-del:hover { background: var(--color-danger-bg-strong); border-color: var(--color-danger-light); }

        .empty-state {
      background: var(--color-white);
      border: 1px solid var(--admin-border);
      border-radius: var(--radius-md);
      padding: 4rem 2rem;
      text-align: center;
      box-shadow: 0 1px 3px rgba(var(--color-navy-rgb), 0.04);
    }
    .empty-state svg { margin: 0 auto 1rem; display: block; color: var(--admin-border-hover); }
    .empty-state h3 { font-size: 1rem; font-weight: var(--fw-bold); color: var(--color-navy); margin-bottom: 0.375rem; }
    .empty-state p  { font-size: 0.8125rem; color: var(--admin-text-muted); }

    .overlay {
      position: fixed; inset: 0;
      background: rgba(var(--color-navy-rgb), 0.5);
      backdrop-filter: blur(4px);
      z-index: 200; opacity: 0; pointer-events: none;
      transition: opacity 0.25s;
    }
    .overlay.open { opacity: 1; pointer-events: auto; }

    .drawer {
      position: fixed; top: 0; right: 0;
      width: 100%; max-width: 460px; height: 100vh;
      background: var(--color-white); z-index: 201;
      display: flex; flex-direction: column;
      box-shadow: -12px 0 48px rgba(var(--color-navy-rgb), 0.18);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    .drawer.open { transform: translateX(0); }

    .drawer-header {
      padding: 1.5rem 1.75rem 1.25rem;
      border-bottom: 1px solid var(--admin-border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .drawer-title { font-size: 1.0625rem; font-weight: var(--fw-extrabold); color: var(--color-navy); }
    .drawer-close {
      width: 34px; height: 34px;
      background: var(--admin-surface); border: 1px solid var(--admin-border);
      border-radius: 50%; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      color: var(--admin-text-muted); font-size: 1rem; line-height: var(--lh-100);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .drawer-close:hover { color: var(--color-navy); border-color: var(--color-navy); background: var(--color-white); }

    .drawer-body {
      flex: 1; overflow-y: auto;
      padding: 1.5rem 1.75rem;
      display: flex; flex-direction: column; gap: 1.25rem;
    }

    .field { display: flex; flex-direction: column; gap: 0.425rem; }
    .field label { font-size: 0.8rem; font-weight: var(--fw-bold); color: var(--color-navy); }
    .field input, .field select, .field textarea {
      width: 100%; padding: 0.675rem 0.9rem;
      font-size: 0.9rem; color: var(--color-navy);
      background: var(--admin-surface);
      border: 1.5px solid var(--admin-border);
      border-radius: var(--radius-sm); outline: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
      font-family: inherit;
    }
    .field input:focus, .field select:focus, .field textarea:focus {
      border-color: var(--color-navy); background: var(--color-white);
      box-shadow: 0 0 0 3px rgba(var(--color-navy-rgb), 0.06);
    }
    .field textarea { min-height: 80px; resize: vertical; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .file-upload-wrap { position: relative; }
    .file-upload-label {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 0.5rem; padding: 1.5rem;
      border: 2px dashed var(--admin-border); border-radius: var(--radius-md);
      cursor: pointer; text-align: center; background: var(--admin-surface);
      transition: border-color 0.2s, background 0.2s;
    }
    .file-upload-label:hover { border-color: var(--color-navy); background: var(--color-white); }
    .file-upload-label.has-file {
      border-style: solid; border-color: var(--color-success); background: var(--color-success-bg-soft);
    }
    .file-name { font-size: 0.8rem; font-weight: var(--fw-semibold); color: var(--color-navy); }
    .file-hint { font-size: 0.725rem; color: var(--admin-text-muted); }
    .file-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

    .current-file {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-size: 0.75rem; color: var(--color-success); font-weight: var(--fw-semibold);
      text-decoration: none; margin-top: 0.375rem;
      transition: opacity 0.15s;
    }
    .current-file:hover { opacity: 0.75; }

    .progress-bar {
      height: 4px; background: var(--admin-border); border-radius: var(--radius-full);
      overflow: hidden; display: none; margin-top: 0.625rem;
    }
    .progress-bar.show { display: block; }
    .progress-fill {
      height: 100%; background: var(--color-navy); border-radius: var(--radius-full);
      width: 0%; transition: width 0.3s;
    }

    .drawer-footer {
      padding: 1.25rem 1.75rem; border-top: 1px solid var(--admin-border);
      display: flex; gap: 0.75rem; justify-content: flex-end;
      background: var(--color-admin-bg-soft);
    }
    .btn-cancel {
      padding: 0.625rem 1.25rem;
      background: var(--color-white); color: var(--color-navy);
      font-size: 0.875rem; font-weight: var(--fw-bold);
      border: 1.5px solid var(--admin-border); border-radius: var(--radius-sm); cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .btn-cancel:hover { background: var(--admin-surface); border-color: var(--admin-border-hover); }
    .btn-save {
      padding: 0.625rem 1.5rem;
      background: var(--color-navy); color: var(--color-white);
      font-size: 0.875rem; font-weight: var(--fw-bold);
      border: none; border-radius: var(--radius-sm); cursor: pointer;
      box-shadow: 0 2px 8px rgba(var(--color-navy-rgb), 0.2);
      transition: opacity 0.15s;
    }
    .btn-save:hover { opacity: 0.88; }
    .btn-save:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }

    #toast {
      position: fixed; bottom: 2rem; right: 2rem;
      background: var(--color-navy); color: var(--color-white);
      padding: 0.875rem 1.5rem; border-radius: var(--radius-md);
      font-size: 0.875rem; font-weight: var(--fw-semibold);
      box-shadow: 0 8px 32px rgba(var(--color-navy-rgb), 0.28);
      transform: translateY(80px); opacity: 0;
      transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
      z-index: 999; display: flex; align-items: center; gap: 0.625rem;
      pointer-events: none;
    }
    #toast.show { transform: translateY(0); opacity: 1; }
    #toast.error { background: var(--color-danger); }

    @media (max-width: 768px) {
      .admin-layout { grid-template-columns: 1fr; }
      .sidebar { display: none; }
      .drawer { max-width: 100%; }
      .field-row { grid-template-columns: 1fr; }
      .page-content { padding: 1.25rem; }
    }
  </style>
</head>
<body>

<div class="admin-layout">

  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>FINTEGRAR</strong>
        <span>Panel administrativo</span>
      </div>
    </div>

    <nav class="sidebar-nav">
      <p class="sidebar-nav-label">General</p>
      <a href="/admin/landing-page" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Inicio
      </a>

      <p class="sidebar-nav-label">Contenidos</p>
      <a href="/admin/landing-page/normatividad" class="sidebar-link is-active">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Normatividad
      </a>

      <p class="sidebar-nav-label">Documentos legales</p>
      {legalDocs.map(doc => (
        <a href={`/admin/landing-page/editar/${doc.id}`} class="sidebar-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          {doc.title}
        </a>
      ))}
    </nav>

    <div class="sidebar-footer">
      <button class="sidebar-logout" id="logoutBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Cerrar sesión
      </button>
    </div>
  </aside>

  <div class="main-content">

    <header class="topbar">
      <div class="topbar-breadcrumb">
        <a href="/admin/landing-page">Inicio</a>
        <span>›</span>
        <strong>Normatividad</strong>
      </div>
      <div class="topbar-right">
        <span class="topbar-badge">
          <span class="topbar-badge-dot"></span>
          Sesión activa
        </span>
        <a href="/normatividad" target="_blank" class="topbar-visit">
          Ver en sitio
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </header>

    <main class="page-content">

      <div class="page-header">
        <div class="page-header-text">
          <h1>Normatividad</h1>
          <p>Documentos, estatutos y reglamentos que se muestran en el sitio público.</p>
        </div>
        <button class="add-btn" id="btnNuevo">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nuevo documento
        </button>
      </div>

      <div class="stats-bar">
        <p class="doc-count" id="docCount">Cargando…</p>
      </div>

      <div class="doc-list" id="docList">
        <!-- cargado vía JS -->
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <h3>Cargando documentos…</h3>
          <p>Conectando con la base de datos.</p>
        </div>
      </div>

    </main>
  </div>
</div>

<div class="overlay" id="overlay"></div>

<aside class="drawer" id="drawer">
  <div class="drawer-header">
    <span class="drawer-title" id="drawerTitle">Nuevo documento</span>
    <button class="drawer-close" id="drawerClose">✕</button>
  </div>

  <div class="drawer-body">
    <input type="hidden" id="fId" />

    <div class="field">
      <label for="fTitulo">Título <span style="color:var(--color-danger)">*</span></label>
      <input type="text" id="fTitulo" placeholder="Ej. Estatutos FINTEGRAR 2024" />
    </div>

    <div class="field-row">
      <div class="field">
        <label for="fCategoria">Categoría <span style="color:var(--color-danger)">*</span></label>
        <select id="fCategoria">
          <option value="Estatutos">Estatutos</option>
          <option value="Reglamentos">Reglamentos</option>
          <option value="Políticas">Políticas</option>
          <option value="Cumplimiento">Cumplimiento</option>
          <option value="Informes">Informes</option>
          <option value="Documentos Legales">Documentos Legales</option>
        </select>
      </div>
      <div class="field">
        <label for="fFecha">Fecha del documento</label>
        <input type="date" id="fFecha" />
      </div>
    </div>

    <div class="field">
      <label for="fDesc">Descripción breve</label>
      <input type="text" id="fDesc" placeholder="Ej. Versión aprobada en Asamblea 2024" />
    </div>

    <div class="field">
      <label>Archivo PDF</label>
      <div class="file-upload-wrap">
        <label class="file-upload-label" id="fileLabel" for="fFile">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="12" x2="12" y2="18"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          <span class="file-name" id="fileName">Seleccionar PDF</span>
          <span class="file-hint">Máximo 10 MB · Solo archivos .pdf</span>
        </label>
        <input type="file" id="fFile" class="file-input" accept="application/pdf" />
      </div>
      <div id="currentFileWrap" style="display:none">
        <a id="currentFileLink" class="current-file" href="#" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Ver archivo cargado actualmente
        </a>
      </div>
      <div class="progress-bar" id="progressBar">
        <div class="progress-fill" id="progressFill"></div>
      </div>
    </div>
  </div>

  <div class="drawer-footer">
    <button class="btn-cancel" id="btnCancel">Cancelar</button>
    <button class="btn-save"   id="btnSave">Guardar documento</button>
  </div>
</aside>

<div id="toast"></div>

<script type="module" define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
  import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';
  const sb = createClient(SUPABASE_URL, SUPABASE_KEY);

  const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const fmt = s => { const d = new Date(s+'T00:00:00'); return `${d.getDate()} de ${MESES[d.getMonth()]}, ${d.getFullYear()}`; };
  const esc = (str) => String(str ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  const docList        = document.getElementById('docList');
  const docCount       = document.getElementById('docCount');
  const drawer         = document.getElementById('drawer');
  const overlay        = document.getElementById('overlay');
  const drawerTitle    = document.getElementById('drawerTitle');
  const fId            = document.getElementById('fId');
  const fTitulo        = document.getElementById('fTitulo');
  const fCategoria     = document.getElementById('fCategoria');
  const fFecha         = document.getElementById('fFecha');
  const fDesc          = document.getElementById('fDesc');
  const fFile          = document.getElementById('fFile');
  const fileLabel      = document.getElementById('fileLabel');
  const fileName       = document.getElementById('fileName');
  const currentFileWrap = document.getElementById('currentFileWrap');
  const currentFileLink = document.getElementById('currentFileLink');
  const progressBar    = document.getElementById('progressBar');
  const progressFill   = document.getElementById('progressFill');
  const btnNuevo       = document.getElementById('btnNuevo');
  const btnCancel      = document.getElementById('btnCancel');
  const btnSave        = document.getElementById('btnSave');
  const drawerClose    = document.getElementById('drawerClose');
  const toast          = document.getElementById('toast');

  let toastTimer;
  function showToast(msg, err = false) {
    toast.textContent = msg;
    toast.className = 'show' + (err ? ' error' : '');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.className = ''; }, 3400);
  }

  async function loadDocs() {
    const { data, error } = await sb
      .from('normatividad_docs')
      .select('*')
      .order('orden', { ascending: true })
      .order('created_at', { ascending: true });

    if (error) { showToast('Error al cargar documentos', true); return; }

    const n = data?.length ?? 0;
    docCount.textContent = `${n} documento${n !== 1 ? 's' : ''} registrado${n !== 1 ? 's' : ''}`;

    if (!n) {
      docList.innerHTML = `
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <h3>Sin documentos aún</h3>
          <p>Haga clic en "Nuevo documento" para agregar el primero.</p>
        </div>`;
      return;
    }

    docList.innerHTML = data.map(doc => `
      <div class="doc-row">
        <div class="doc-row-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>
        <div class="doc-row-body">
          <p class="doc-row-title">${esc(doc.titulo)}</p>
          <div class="doc-row-meta">
            <span class="cat-tag">${esc(doc.categoria)}</span>
            <span class="date-chip">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              ${fmt(doc.fecha)}
            </span>
            ${doc.url
              ? `<span class="file-chip">
                   <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                   PDF cargado
                 </span>`
              : `<span class="file-chip no-file">Sin archivo</span>`}
          </div>
        </div>
        <div class="doc-row-actions">
          <button class="btn-edit" data-id="${doc.id}">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
          </button>
          <button class="btn-del" data-id="${doc.id}" data-titulo="${esc(doc.titulo)}">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            Eliminar
          </button>
        </div>
      </div>
    `).join('');

    docList.querySelectorAll('.btn-edit').forEach(b =>
      b.addEventListener('click', () => openEdit(b.dataset.id, data)));
    docList.querySelectorAll('.btn-del').forEach(b =>
      b.addEventListener('click', () => confirmDelete(b.dataset.id, b.dataset.titulo)));
  }

  function openDrawer(title) {
    drawerTitle.textContent = title;
    drawer.classList.add('open');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    resetForm();
  }
  function resetForm() {
    fId.value = ''; fTitulo.value = ''; fCategoria.value = 'Estatutos';
    fFecha.value = new Date().toISOString().split('T')[0];
    fDesc.value = ''; fFile.value = '';
    fileName.textContent = 'Seleccionar PDF';
    fileLabel.classList.remove('has-file');
    currentFileWrap.style.display = 'none';
    progressBar.classList.remove('show');
    progressFill.style.width = '0%';
  }

  function openNew() { resetForm(); openDrawer('Nuevo documento'); }

  async function openEdit(id, data) {
    const doc = data.find(d => d.id === id);
    if (!doc) return;
    resetForm();
    fId.value = doc.id; fTitulo.value = doc.titulo;
    fCategoria.value = doc.categoria; fFecha.value = doc.fecha;
    fDesc.value = doc.descripcion ?? '';
    if (doc.url) { currentFileLink.href = doc.url; currentFileWrap.style.display = 'block'; }
    openDrawer('Editar documento');
  }

  fFile.addEventListener('change', () => {
    const f = fFile.files[0];
    if (f) { fileName.textContent = f.name; fileLabel.classList.add('has-file'); }
    else   { fileName.textContent = 'Seleccionar PDF'; fileLabel.classList.remove('has-file'); }
  });

  btnSave.addEventListener('click', async () => {
    const titulo = fTitulo.value.trim();
    if (!titulo) { fTitulo.focus(); showToast('El título es obligatorio', true); return; }
    btnSave.disabled = true; btnSave.textContent = 'Guardando…';
    try {
      const isEdit = !!fId.value;
      const file = fFile.files[0];
      if (file) progressBar.classList.add('show');

      const body = new FormData();
      body.set('action', 'save');
      body.set('isEdit', String(isEdit));
      if (isEdit) body.set('id', fId.value);
      body.set('titulo', titulo);
      body.set('categoria', fCategoria.value);
      body.set('fecha', fFecha.value);
      body.set('descripcion', fDesc.value.trim());
      if (file) body.set('file', file);

      const res = await fetch('/api/admin-normatividad', { method: 'POST', body, credentials: 'include' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error al guardar');
      if (file) progressFill.style.width = '100%';

      showToast(isEdit ? '✓ Documento actualizado' : '✓ Documento creado');
      closeDrawer(); loadDocs();
    } catch (err) {
      showToast(err.message, true);
    } finally {
      btnSave.disabled = false; btnSave.textContent = 'Guardar documento';
    }
  });

  async function confirmDelete(id, titulo) {
    if (!confirm(`¿Eliminar "${titulo}"?\n\nEsta acción no se puede deshacer.`)) return;
    const body = new FormData();
    body.set('action', 'delete');
    body.set('id', id);
    const res = await fetch('/api/admin-normatividad', { method: 'POST', body, credentials: 'include' });
    const data = await res.json();
    if (!res.ok) { showToast('Error al eliminar: ' + data.error, true); return; }
    showToast('Documento eliminado');
    loadDocs();
  }

  btnNuevo.addEventListener('click', openNew);
  btnCancel.addEventListener('click', closeDrawer);
  drawerClose.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
  document.getElementById('logoutBtn').addEventListener('click', () => {
    document.cookie = 'admin_lp=; path=/admin/landing-page; max-age=0';
    window.location.href = '/admin/landing-page';
  });

  fFecha.value = new Date().toISOString().split('T')[0];
  loadDocs();
</script>

</body>
</html>
