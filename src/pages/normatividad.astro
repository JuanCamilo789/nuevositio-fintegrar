---
import { createClient } from '@supabase/supabase-js';
import InnerLayout from '../layouts/InnerLayout.astro';
import NormatividadSection from '../components/Normatividad.astro';

export const prerender = false;

const SUPABASE_URL =
  (import.meta.env.PUBLIC_SUPABASE_URL ??
  import.meta.env.VITE_SUPABASE_URL ??
  process.env.PUBLIC_SUPABASE_URL ??
  process.env.VITE_SUPABASE_URL ??
  process.env['PUBLIC-SUPABASE_URL'] ?? '').trim().replace(/^["']|["']$/g, '').replace(/\/$/, '');

const SUPABASE_ANON_KEY =
  (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ??
  import.meta.env.VITE_SUPABASE_ANON_KEY ??
  process.env.PUBLIC_SUPABASE_ANON_KEY ??
  process.env.VITE_SUPABASE_ANON_KEY ??
  process.env['PUBLIC-SUPABASE_ANON_KEY'] ?? '').trim().replace(/^["']|["']$/g, '');

if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
  console.error("❌ ERROR: Faltan variables de Supabase en el servidor.");
}

const supabase = createClient(
  SUPABASE_URL || '',
  SUPABASE_ANON_KEY || ''
);

const { data: docs, error } = await supabase
  .from('normatividad_docs')
  .select('*')
  .eq('activo', true)
  .order('orden', { ascending: true })
  .order('created_at', { ascending: true });

if (error) {
  console.error("❌ ERROR Supabase (Normatividad):", error.message);
}
---

<InnerLayout
  pageTitle="Normatividad"
  pageSubtitle="Estatutos, reglamentos y documentos institucionales de la Cooperativa Multiactiva Luis Amigó"
  breadcrumbs={[{ label: 'Nosotros', href: '/nosotros' }, { label: 'Normatividad' }]}
>
  <NormatividadSection docs={docs ?? []} />
</InnerLayout>
