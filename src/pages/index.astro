---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HeroAlternative from '../components/HeroAlternative.astro';
import TasasVigentes from '../components/TasasVigentes.astro';
import DigitalBanking from '../components/DigitalBanking.astro';
import BlogBanner from '../components/BlogBanner.astro';
import QuienesSomos from '../components/QuienesSomos.astro';
import Creditos from '../components/Creditos.astro';
import Ahorros from '../components/Ahorros.astro';
import Campanas from '../components/Campanas.astro';
import BienestarSocial from '../components/BienestarSocial.astro';
import Novedades from '../components/Novedades.astro';
import Convenios from '../components/Convenios.astro';
import SimuladorCredito from '../components/SimuladorCredito.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import SummerParty from '../components/SummerParty.astro';
import Footer from '../components/Footer.astro';

// Cache de 60 segundos, permitiendo servir contenido "stale" hasta por 10 minutos mientras se actualiza
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <HeroAlternative />
    <TasasVigentes />
    <DigitalBanking />
    <BlogBanner />
    <QuienesSomos />
    <Creditos />
    <Ahorros />
    <Campanas />
    <BienestarSocial />
    <Novedades />
    <Convenios />
    <SimuladorCredito />
    <ComoFunciona />
    <SummerParty />
  </main>
  <Footer />
</Layout>
