---
import LegalLayout from '../layouts/LegalLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

let content = '';
try {
  const filePath = path.resolve('./src/data/legales/manual.html');
  content = fs.readFileSync(filePath, 'utf-8');
} catch (e) {
  content = '<p>Contenido no disponible.</p>';
}
---

<LegalLayout
  pageTitle="Manual de Procedimientos"
  pageSubtitle="Guía de los principales procesos administrativos y operativos de Cooperamigó"
  breadcrumbs={[{ label: 'Manual de Procedimientos' }]}
  updateDate="aprobada por el Consejo de Administración en enero de 2025"
  maxWidth="max-w-7xl"
>
  <div class="dynamic-content" set:html={content} />
</LegalLayout>
