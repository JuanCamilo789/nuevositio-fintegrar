---
import InnerLayout from '../layouts/InnerLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = true;
---

<InnerLayout
  pageTitle="Página no encontrada"
  pageSubtitle="Lo sentimos, la página solicitada no está disponible."
  description="La página que buscas no existe o ha sido movida."
>
  <div class="error-container">
    <div class="bg-404-watermark" aria-hidden="true">404</div>

    <div class="error-content">
      <h1 class="error-number">404</h1>
      <h2 class="error-message">¡Ups! No encontramos esta página</h2>
      <p class="error-description">
        Es posible que la dirección sea incorrecta o que la página haya sido movida.
        Vuelve a navegar desde nuestra página principal.
      </p>
      <a href="/" class="error-back-link">
        Volver al inicio
        <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</InnerLayout>

<style>
  .error-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: 5rem 1.5rem 6rem;
    text-align: center;
    overflow: hidden;
  }

  .bg-404-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 22rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-brand-dark-blue);
    opacity: 0.05;
    line-height: var(--lh-100);
    letter-spacing: -0.05em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    white-space: nowrap;
  }

  .error-content {
    position: relative;
    z-index: 1;
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-number {
    font-size: 6.875rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-brand-dark-blue);
    line-height: var(--lh-100);
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem 0;
  }

  .error-message {
    font-size: 1.75rem;
    color: var(--color-brand-dark-blue);
    font-weight: var(--fw-extrabold);
    margin: 0 0 0.75rem 0;
    line-height: var(--lh-120);
  }

  .error-description {
    font-size: 0.9375rem;
    color: rgba(var(--color-navy-rgb), 0.7);
    line-height: var(--lh-160);
    margin: 0 0 2rem 0;
  }

  .error-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    color: var(--color-brand-purple);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .error-back-link:hover {
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .bg-404-watermark {
      font-size: 12rem;
    }
    .error-number {
      font-size: 4.375rem;
    }
    .error-message {
      font-size: 1.375rem;
    }
  }
</style>
