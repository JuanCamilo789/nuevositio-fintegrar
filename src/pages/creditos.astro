---
import InnerLayout from '../layouts/InnerLayout.astro';
import Creditos from '../components/Creditos.astro';
import { Icon } from 'astro-icon/components';

const requisitos = [
  {
    icon: 'tabler:id-badge',
    titulo: 'Ser asociado activo',
    desc: 'Estar vinculado al Fondo y tener aportes al día.',
  },
  {
    icon: 'tabler:calendar-check',
    titulo: 'Antigüedad mínima',
    desc: 'Contar con al menos un mes de antigüedad como asociado.',
  },
  {
    icon: 'tabler:file-text',
    titulo: 'Documento de identidad',
    desc: 'Cédula de ciudadanía vigente (original y copia).',
  },
  {
    icon: 'tabler:receipt',
    titulo: 'Comprobante de ingresos',
    desc: 'Desprendible de nómina o certificado laboral de los últimos tres meses.',
  },
  {
    icon: 'tabler:building-bank',
    titulo: 'Extracto bancario',
    desc: 'Últimos tres extractos de cuenta de ahorros o corriente.',
  },
  {
    icon: 'tabler:shield-check',
    titulo: 'Sin reportes negativos',
    desc: 'Estar al día en centrales de riesgo (Datacrédito / TransUnión) al momento de la solicitud.',
  },
];
---

<InnerLayout pageTitle="Líneas de Crédito" pageSubtitle="Soluciones financieras diseñadas a la medida de sus necesidades y posibilidades">
  <Creditos full />

    <section id="requisitos" class="req-section" aria-labelledby="req-title">
    <div class="max-w-7xl mx-auto px-6">

      <div class="text-center max-w-4xl mx-auto mb-12 reveal">
        <h2
          id="req-title"
          class="font-display"
          style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);margin-bottom:1rem;"
        >
          Requisitos generales
        </h2>
        <p style="font-size:1rem;color:var(--color-ink);opacity:0.6;line-height: var(--lh-170);">
          Estos son los documentos y condiciones básicas para acceder a cualquiera de nuestras líneas de crédito.
        </p>
      </div>

      <div class="req-grid reveal">
        {requisitos.map((r) => (
          <div class="req-card">
            <div class="req-icon">
              <Icon name={r.icon} class="w-5 h-5" aria-hidden="true" />
            </div>
            <div class="req-body">
              <div class="req-titulo">{r.titulo}</div>
              <div class="req-desc">{r.desc}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="req-footer reveal">
        <p class="req-nota">
          Los requisitos pueden variar según la línea de crédito y el monto solicitado.
          Nuestro equipo le orientará en el proceso.
        </p>
        <a href="mailto:gerencia@fintegrar.com" class="btn btn-dark btn-sm">
          <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
          Consultar requisitos específicos
        </a>
      </div>

    </div>
  </section>

</InnerLayout>

<style>
  .req-section {
    background: var(--color-navbar-bg);
    padding: 8rem 0;
  }

  .req-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .req-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }

  .req-card:hover {
    background: var(--color-white);
    border-color: var(--color-surface);
  }

  .req-icon {
    width: 40px;
    height: 40px;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .req-body { flex: 1; }

  .req-titulo {
    font-weight: var(--fw-bold);
    font-size: 1rem;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .req-desc {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-160);
  }

  .req-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    box-shadow: 0 2px 14px rgba(var(--color-navy-rgb), 0.08);
  }

  .req-nota {
    font-size: 0.9375rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-160);
    max-width: 540px;
  }

  @media (max-width: 1023px) {
    .req-section { padding: 6rem 0; }
    .req-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 639px) {
    .req-section { padding: 4rem 0; }
    .req-grid { grid-template-columns: 1fr; }
    .req-footer { flex-direction: column; align-items: flex-start; }
  }
</style>
