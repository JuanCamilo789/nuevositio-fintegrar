---

const campanas = [
  {
    id: 1,
    image: '/assets/img/promos/publicidad10.webp',
    alt: 'Campaña ¿Necesitas un crédito? - Créditos a tu medida y en poco tiempo',
  },
  {
    id: 2,
    image: '/assets/img/promos/publicidad9.webp',
    alt: 'Campaña Créditos listos para otorgar - Ordinario, Educativo, Consumo',
  },
  {
    id: 3,
    image: '/assets/img/promos/publicidad8.webp',
    alt: 'Campaña Solicita tu Crédito hoy mismo - Tus sueños llegaron',
  }
];
---

<section class="campanas-section reveal">
  <div class="max-w-7xl mx-auto px-6">
    <div class="section-header mb-12">
      <h2 class="font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);">
        Oportunidades para su progreso
      </h2>
    </div>

    <div class="campanas-grid">
      {campanas.map((c) => (
        <div class="campana-card card-base">
          <img
            src={c.image}
            alt={c.alt}
            class="campana-img"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <div class="campanas-marquee">
      <div class="campanas-track">
        {[...campanas, ...campanas].map((c) => (
          <div class="campana-card card-base">
            <img
              src={c.image}
              alt={c.alt}
              class="campana-img"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .campanas-section {
    padding: 8rem 0;
    background: var(--color-navbar-bg);
    overflow: hidden;
  }
  .campanas-eyebrow {
    justify-content: center;
  }

  .campanas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .campana-card {
    position: relative;
    border-radius: var(--radius-md);
    background: var(--color-white);
    overflow: hidden;
  }

  .campana-img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .campanas-marquee {
    display: none;
  }

  @media (max-width: 1023px) {
    .campanas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .campanas-section { padding: 3.5rem 0; }
    .campanas-grid {
      display: none;
    }
    .section-header {
      text-align: left;
    }
    .campanas-eyebrow {
      justify-content: flex-start;
    }

    .campanas-marquee {
      display: block;
      width: 100%;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, var(--color-black) 6%, var(--color-black) 94%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, var(--color-black) 6%, var(--color-black) 94%, transparent);
    }
    .campanas-track {
      display: flex;
      width: max-content;
      gap: 1rem;
      animation: campanas-scroll 18s linear infinite;
    }
    .campanas-track .campana-card {
      flex: 0 0 auto;
      width: 68vw;
      max-width: 280px;
    }
    @keyframes campanas-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(calc(-50% - 0.5rem)); }
    }
    @media (prefers-reduced-motion: reduce) {
      .campanas-track { animation: none; }
    }
  }

</style>

