---
import { Icon } from "astro-icon/components";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;

const todasLineas = [
  {
    id: "ordinario",
    icon: "tabler:credit-card",
    nombre: "Crédito Ordinario",
    tasa: "1.53% M.V.",
    desc: "Créditos cancelados con deducciones quincenales antes del 30 de noviembre del año en que se apruebe.",
  },
  {
    id: "ahorro-navideno-anticipo",
    icon: "tabler:wallet",
    nombre: "Anticipo Ahorro Navideño",
    tasa: "1.53% M.V.",
    desc: "Adelante su Ahorro Navideño y solo pague el interés quincenal; el valor se liquida en diciembre.",
  },
  {
    id: "eventos-especiales",
    icon: "tabler:calendar-event",
    nombre: "Crédito Eventos Especiales",
    tasa: "0%",
    desc: "Para fechas especiales programadas por Fintegrar: Día de la Madre, Día del Padre, Navidad, paseos, Fiesta del Fondo y más.",
  },
  {
    id: "cuota-especial",
    icon: "tabler:receipt",
    nombre: "Cuota Especial (Prima)",
    tasa: "Según estudio",
    desc: "Anticipo de la prima de servicios de junio y diciembre; aplica después de los meses de abril y octubre.",
  },
  {
    id: "calamidad",
    icon: "tabler:home-heart",
    nombre: "Crédito Calamidad Doméstica",
    tasa: "0.5% M.V.",
    desc: "Para desastres naturales, salud no cubierta por el POS o pérdida de bienes de primera necesidad. Plazo máximo 12 meses.",
  },
  {
    id: "vacacional",
    icon: "tabler:plane",
    nombre: "Plan Vacacional",
    tasa: "1.53% M.V.",
    desc: "Financie sus vacaciones con descuentos en convenios aliados; pago con Ahorro Navideño, prima o nómina.",
  },
  {
    id: "largo-plazo",
    icon: "tabler:calendar-check",
    nombre: "Crédito Largo Plazo",
    tasa: "1.53% M.V.",
    desc: "Plazo máximo de 36 meses. Las garantías se exigen de acuerdo con el monto solicitado.",
  },
  {
    id: "educacion",
    icon: "tabler:school",
    nombre: "Crédito para Educación",
    tasa: "1% M.V.",
    desc: "Para estudios del asociado en instituciones certificadas por el Ministerio de Educación.",
  },
  {
    id: "mejoras-vivienda",
    icon: "tabler:home",
    nombre: "Mejoras de Vivienda",
    tasa: "1% M.V.",
    desc: "Para vivienda propia del asociado, presentando el certificado de tradición y libertad.",
  },
  {
    id: "compra-cartera",
    icon: "tabler:building-bank",
    nombre: "Compra de Cartera",
    tasa: "Tasa inferior, según estudio",
    desc: "Consolide sus obligaciones con otras entidades de crédito en una sola cuota con Fintegrar.",
  },
];

const destacadas = new Set(["ordinario", "educacion", "calamidad", "vacacional"]);
const lineas = full ? todasLineas : todasLineas.filter((l) => destacadas.has(l.id));
---

<section id="creditos" class="section-white" aria-labelledby="creditos-title">
  <div class="max-w-7xl mx-auto px-6">
    <div class="section-header reveal">
      <div>
        <h2
          id="creditos-title"
          class="font-display"
          style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);"
        >
          Soluciones financieras para cada necesidad
        </h2>
      </div>
      <p class="section-header-aside"></p>
    </div>

    <div class="creditos-grid">
      {
        lineas.map((l, i) => (
          <div
            id={l.id}
            class={`credito-card card-base reveal${i > 0 ? ` reveal-delay-${Math.min(i, 4)}` : ""}`}
          >
            <div class="credito-card-top">
              <div class="credito-icon">
                <Icon name={l.icon} class="w-5 h-5" aria-hidden="true" />
              </div>
              {l.badge && (
                <span class={`badge ${l.badge.clase}`}>{l.badge.texto}</span>
              )}
            </div>
            <div>
              <h3 class="credito-nombre">{l.nombre}</h3>
              <div class="credito-tasa">{l.tasa}</div>
              <p class="credito-desc">{l.desc}</p>
            </div>
            <a
              href="https://tramitesvirtuales.fintegrar.com"
              class="credito-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Solicitar crédito
              <Icon
                name="tabler:arrow-right"
                class="w-4 h-4"
                aria-hidden="true"
              />
            </a>
          </div>
        ))
      }

      <div
        class="credito-card card-base credito-card--dark reveal reveal-delay-2"
      >
        <div class="credito-icon credito-icon--light">
          <Icon name="tabler:headset" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <h3 class="credito-cta-titulo">¿Tiene dudas? Le asesoramos.</h3>
          <p class="credito-cta-desc">
            Nuestro personal experto le orientará para encontrar la opción ideal
            según su necesidad.
          </p>
        </div>
        <div class="credito-cta-acciones">
          <a
            href="https://maps.google.com/?q=Carrera+43A+%2325-69+Medellin"
            class="credito-contact-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:map-pin" class="w-4 h-4" aria-hidden="true" />
            Prosalco IPS Poblado, Cra 43A # 25-69
          </a>
          <a
            href="mailto:gerencia@fintegrar.com"
            class="credito-contact-link"
          >
            <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
            gerencia@fintegrar.com
          </a>
          <a href="tel:+573174879669" class="credito-contact-link">
            <Icon name="tabler:phone" class="w-4 h-4" aria-hidden="true" />
            (+57) 317 487 9669
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-white {
    background: var(--color-navbar-bg);
    padding: 8rem 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4rem;
    margin-bottom: 5rem;
  }
  .section-header-aside {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-180);
    max-width: 420px;
    flex-shrink: 0;
  }

  .creditos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .credito-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .credito-card--dark {
    background: var(--color-ink);
    border-color: transparent;
    grid-column: 1 / -1;
  }
  .credito-card--dark:hover {
    box-shadow: 0 12px 40px rgba(var(--color-navy-rgb), 0.25);
  }
  @media (min-width: 1024px) {
    .credito-card--dark {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      padding: 3rem 4rem;
    }
    .credito-card--dark > div:nth-child(2) {
      flex: 1;
    }
    .credito-card--dark .credito-cta-acciones {
      flex-direction: column;
      margin-top: 0;
      gap: 0.25rem;
    }
  }

  .credito-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .credito-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .credito-icon--light {
    background: rgba(var(--color-white-rgb), 0.1);
    color: var(--color-brand-yellow);
  }

  .credito-nombre {
    font-weight: var(--fw-bold);
    font-size: 1.125rem;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }
  .credito-card--dark .credito-nombre {
    color: var(--color-white);
  }
  .credito-tasa {
    font-size: 0.875rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .credito-card--dark .credito-tasa {
    color: var(--color-brand-yellow);
  }
  .credito-desc {
    font-size: 0.9375rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-160);
  }
  .credito-card--dark .credito-desc {
    color: rgba(var(--color-white-rgb), 0.7);
  }

  .credito-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    text-decoration: none;
    margin-top: auto;
    transition: gap 0.2s;
  }
  .credito-link:hover {
    gap: 10px;
  }

  .credito-cta-eyebrow {
    font-size: 0.7rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-yellow);
    margin-bottom: 0.5rem;
  }
  .credito-cta-titulo {
    font-size: 1.125rem;
    font-weight: var(--fw-bold);
    color: var(--color-white);
    margin-bottom: 0.5rem;
    line-height: var(--lh-135);
  }
  .credito-cta-desc {
    font-size: 0.875rem;
    color: rgba(var(--color-white-rgb), 0.6);
    line-height: var(--lh-160);
    margin-top: 0.25rem;
  }
  .credito-cta-acciones {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .credito-contact-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: rgba(var(--color-white-rgb), 0.85);
    text-decoration: none;
    transition: color 0.15s;
  }
  .credito-contact-link:hover {
    color: var(--color-brand-yellow);
  }
  .credito-contact-link svg {
    color: var(--color-brand-yellow);
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .section-white {
      padding: 6rem 0;
    }
    .creditos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }
  }
  @media (max-width: 639px) {
    .section-white {
      padding: 3.5rem 0;
    }
    .creditos-grid {
      grid-template-columns: 1fr;
    }
    .credito-card {
      padding: 1.5rem;
    }
  }
</style>
