---
import { Icon } from 'astro-icon/components';

const lineas = [
  {
    icon: 'tabler:credit-card',
    nombre: 'Crédito Ordinario/Consumo',
    tasa: 'Desde 1.5% M.V. según perfil de riesgo',
    desc: 'Financiamiento ágil para sus necesidades personales, del hogar, viajes y más, con cuotas ajustadas a su realidad.',
    badge: { texto: 'Más solicitado', clase: 'badge-primary' },
  },
  {
    icon: 'tabler:school',
    nombre: 'Crédito Educativo',
    tasa: '1.35% M.V.',
    desc: 'Crédito exclusivo con la Universidad Católica Luis Amigó. Apoye su formación académica con condiciones especiales para asociados.',
  },
];
---

<!-- ════════════════════════════════════
     CRÉDITOS
════════════════════════════════════ -->
<section id="creditos" class="section-white" aria-labelledby="creditos-title">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Cabecera -->
    <div class="section-header reveal">
      <div>
        <div class="section-eyebrow">Líneas de crédito</div>
        <h2
          id="creditos-title"
          class="font-display"
          style="font-size:clamp(1.75rem,3vw,2.5rem);color:#172B36;line-height:1.2;"
        >
          Soluciones financieras<br />para cada necesidad
        </h2>
      </div>
      <p class="section-header-aside">
      </p>
    </div>

    <!-- Grid de tarjetas -->
    <div class="creditos-grid">
      {lineas.map((l, i) => (
        <div class={`credito-card card-base reveal${i > 0 ? ` reveal-delay-${Math.min(i, 4)}` : ''}`}>
          <div class="credito-card-top">
            <div class="credito-icon">
              <Icon name={l.icon} class="w-5 h-5" aria-hidden="true" />
            </div>
            {l.badge && (
              <span class={`badge ${l.badge.clase}`}>{l.badge.texto}</span>
            )}
          </div>
          <div>
            <h3 class="credito-nombre">{l.nombre}</h3>
            <div class="credito-tasa">{l.tasa}</div>
            <p class="credito-desc">{l.desc}</p>
          </div>
          <a href="https://serviciosdigitales.cooperamigo.coop" class="credito-link" target="_blank" rel="noopener noreferrer">
            Solicitar crédito
            <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
          </a>
        </div>
      ))}

      <!-- CTA card -->
      <div class="credito-card card-base credito-card--dark reveal reveal-delay-2">
        <div class="credito-icon credito-icon--light">
          <Icon name="tabler:headset" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <div class="credito-cta-eyebrow">¿Tiene dudas?</div>
          <h3 class="credito-cta-titulo">Escríbanos o llámenos y le asesoramos</h3>
          <p class="credito-cta-desc">Nuestro equipo de créditos le orientará para encontrar la opción ideal según su necesidad.</p>
        </div>
        <div class="credito-cta-acciones">
          <a href="mailto:creditos@cooperamigo.coop" class="credito-contact-link">
            <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
            creditos@cooperamigo.coop
          </a>
          <a href="tel:+573054070612" class="credito-contact-link">
            <Icon name="tabler:phone" class="w-4 h-4" aria-hidden="true" />
            (+57) 305 407 0612
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .section-white {
    background: #fff;
    padding: 8rem 0;
  }

  /* Cabecera con descripción al lado */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4rem;
    margin-bottom: 5rem;
  }
  .section-header-aside {
    font-size: 1rem;
    color: #172B36;
    opacity: 0.6;
    line-height: 1.8;
    max-width: 420px;
    flex-shrink: 0;
  }

  /* Grid de créditos */
  .creditos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Tarjeta base */
  .credito-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .credito-card--dark {
    background: #172B36;
    border-color: transparent;
  }
  .credito-card--dark:hover {
    box-shadow: 0 12px 40px rgba(23, 43, 54, 0.25);
  }

  /* Top: icono + badge */
  .credito-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Icono */
  .credito-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #F1F6F4;
    color: #172B36;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .credito-icon--light {
    background: rgba(255, 255, 255, 0.1);
    color: #FFC801;
  }

  /* Texto de tarjeta */
  .credito-nombre {
    font-weight: 700;
    font-size: 1.125rem;
    color: #172B36;
    margin-bottom: 0.25rem;
  }
  .credito-card--dark .credito-nombre {
    color: #fff;
  }
  .credito-tasa {
    font-size: 0.875rem;
    font-weight: 700;
    color: #172B36;
    margin-bottom: 0.75rem;
  }
  .credito-card--dark .credito-tasa {
    color: #FFC801;
  }
  .credito-desc {
    font-size: 0.9375rem;
    color: #172B36;
    opacity: 0.6;
    line-height: 1.6;
  }
  .credito-card--dark .credito-desc {
    color: rgba(255, 255, 255, 0.7);
  }

  /* Link */
  .credito-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #172B36;
    text-decoration: none;
    margin-top: auto;
    transition: gap 0.2s;
  }
  .credito-link:hover {
    gap: 10px;
  }

  /* CTA dark specific */
  .credito-cta-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FFC801;
    margin-bottom: 0.5rem;
  }
  .credito-cta-titulo {
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  .credito-cta-desc {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin-top: 0.25rem;
  }
  .credito-cta-acciones {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .credito-contact-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.15s;
  }
  .credito-contact-link:hover {
    color: #FFC801;
  }
  .credito-contact-link svg {
    color: #FFC801;
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .section-white { padding: 6rem 0; }
    .creditos-grid { grid-template-columns: repeat(2, 1fr); }
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }
  }
  @media (max-width: 639px) {
    .section-white { padding: 3.5rem 0; }
    .creditos-grid { grid-template-columns: 1fr; }
    .credito-card { padding: 1.5rem; }
  }
</style>
