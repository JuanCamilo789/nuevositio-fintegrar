---
import { Icon } from 'astro-icon/components';

const fixedSlides = [
  {
    id: 'slide-horarios',
    bg: '#172B36',
    imageOnly: true,
    image: '/assets/img/nuevos-horarios.webp',
    imageMobile: '/assets/img/nuevo-horario-mobil.webp',
    imageAlt:
      'Nuevos horarios de atención: lunes a jueves de 8:00 a.m. a 4:30 p.m. y viernes de 8:00 a.m. a 3:30 p.m. Cll 50 #65-42 Local 120, Centro Comercial Contemporáneo',
  },
  {
    id: 'slide-0',
    bg: '#172B36',
    heading: 'Donde su esfuerzo\nse convierte en bienestar',
    headingEm: 'se convierte en bienestar',
    lead: 'Más de 30 años brindando soluciones financieras confiables, promoviendo el acceso al crédito, la cultura del aporte y el bienestar integral de nuestros asociados.',
    cta1: { label: 'Acceso al Portal', icon: 'tabler:layout-dashboard', href: '#' },
    cta2: { label: 'Conózcanos', icon: 'tabler:arrow-right', href: '/nosotros' },
    trust: [
      { icon: 'tabler:shield-check', label: 'Vigilada Supersolidaria' },
      { icon: 'tabler:rosette-discount-check', label: 'Desde 1993' },
      { icon: 'tabler:users-group', label: '+420 asociados' },
    ],
    image: '/assets/img/promos/publicidad2.webp',
    imageAlt: 'Asociados Cooperamigó',
    imagePos: 'center center',
  },
  {
    id: 'slide-1',
    bg: '#172B36',
    heading: 'Crédito ágil, condiciones\nque se adaptan a usted',
    headingEm: 'que se adaptan a usted',
    lead: 'Ofrecemos líneas de Crédito Ordinario/Consumo y crédito educativo, con tasas desde el 1.35% M.V., aprobación ágil y procesos completamente virtuales.',
    cta1: { label: 'Ver líneas de crédito', icon: 'tabler:credit-card', href: '/creditos' },
    cta2: { label: 'Simular crédito', icon: 'tabler:calculator', href: '/creditos#simulador' },
    trust: [
      { icon: 'tabler:percentage', label: 'Desde 1.2% M.V.' },
      { icon: 'tabler:clock', label: 'Aprobación en 48h' },
      { icon: 'tabler:cash', label: 'Desembolso ágil' },
    ],
    image: '/assets/img/promos/publicidad6.webp',
    imageAlt: 'Líneas de crédito Cooperamigó',
    imagePos: 'center 18%',
  },
  {
    id: 'slide-2',
    bg: '#172B36',
    heading: 'Cuidamos a su familia en\nlos momentos que importan',
    headingEm: 'los momentos que importan',
    lead: 'Gestionamos una amplia red de convenios que facilita a nuestros asociados el acceso a servicios en salud, educación, turismo y otros sectores.',
    cta1: { label: 'Explorar beneficios', icon: 'tabler:heart', href: '/nosotros#auxilios' },
    cta2: { label: 'Ver convenios', icon: 'tabler:building-store', href: '/nosotros#convenios' },
    trust: [
      { icon: 'tabler:users', label: '1.240 auxilios/año' },
      { icon: 'tabler:building-store', label: '+20 convenios' },
      { icon: 'tabler:mood-happy', label: '96% satisfacción' },
    ],
    image: '/assets/img/promos/publicidad7.webp',
    imageAlt: 'Bienestar social Cooperamigó',
    imagePos: 'center center',
  },
  {
    id: 'slide-alivio-financiero',
    bg: '#172B36',
    heading: 'Reorganicemos sus\nobligaciones, juntos',
    headingEm: 'obligaciones, juntos',
    lead: 'Si tiene cuotas atrasadas o quiere ponerse al día, le ayudamos a encontrar un plan de pago que se ajuste a su realidad. Sin trámites complicados y con total confidencialidad.',
    cta1: { label: 'Hablemos ahora', icon: 'tabler:phone', href: 'tel:+573054070612' },
    cta2: { label: 'Escribir por correo', icon: 'tabler:mail', href: 'mailto:creditos@cooperamigo.coop' },
    trust: [
      { icon: 'tabler:check', label: 'Sin trámites complicados' },
      { icon: 'tabler:clock', label: 'Respuesta ágil' },
      { icon: 'tabler:shield-check', label: 'Total confidencialidad' },
    ],
    image: '/assets/img/deudas.webp',
    imageAlt: 'Persona revisando tranquilamente sus finanzas en casa',
    imagePos: '70% 22%',
    imagePosMobile: '65% 25%',
  },
];

const slides = fixedSlides;
---

<!-- ════════════════════════════════════
     HERO SLIDER
════════════════════════════════════ -->
<section id="heroSlider" class="hero-slider" aria-label="Presentación Cooperamigó" data-dark-bg>

  <!-- ── Slides ── -->
  {slides.map((s, i) => (
    <div
      class={`slide${i === 0 ? ' is-active' : ''}${s.alignRight ? ' slide--align-right' : ''}${!s.image ? ' slide--no-image' : ''}${s.imageOnly ? ' slide--image-only' : ''}`}
      id={s.id}
      style={`background:${s.bg}; --img-pos:${s.imagePos ?? 'center center'}; --img-pos-m:${s.imagePosMobile ?? 'left center'};`}
      aria-hidden={i !== 0 ? 'true' : 'false'}
    >
      <!-- Imagen: absoluta, izquierda o derecha, altura completa, difuminada
           (algunos slides no llevan imagen — solo tipografía sobre el fondo) -->
      {s.image && (
        <div class="slide-img-bg">
          {s.imageOnly && (
            <img
              src={s.image}
              alt=""
              class="slide-img-blur"
              aria-hidden="true"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
          <picture>
            {s.imageMobile && <source media="(max-width: 639px)" srcset={s.imageMobile} />}
            <img
              src={s.image}
              alt={s.imageOnly ? s.imageAlt : ''}
              class="slide-img-fill"
              width={s.imageOnly ? 2560 : 720}
              height={s.imageOnly ? 1440 : 1080}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding={i === 0 ? 'sync' : 'async'}
            />
          </picture>
        </div>
      )}

      {!s.imageOnly && (
      <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 h-full" style="position:relative;z-index:1;">
        <div class="slide-grid">

          <!-- Contenido -->
          <div class="slide-content">
            <h1 class="slide-h1">
              {s.heading.split('\n').map((line, li) =>
                s.headingEm && line === s.headingEm
                  ? <span>{li > 0 && <br />}<em style="color:#FFC801;">{line}</em></span>
                  : <span>{li > 0 && <br />}{line}</span>
              )}
            </h1>

            <p class="slide-lead">{s.lead}</p>

            {s.cta1 && s.cta2 && (
              <div class="slide-ctas">
                <a href={s.cta1.href} class="btn btn-accent btn-lg">
                  <Icon name={s.cta1.icon} class="w-5 h-5" aria-hidden="true" />
                  {s.cta1.label}
                </a>
                <a href={s.cta2.href} class="btn btn-outline-light">
                  {s.cta2.label}
                  <Icon name={s.cta2.icon} class="w-4 h-4" aria-hidden="true" />
                </a>
              </div>
            )}

            {s.trust && s.trust.length > 0 && (
              <div class="slide-trust">
                {s.trust.map((t: any) => (
                  <span class="trust-pill">
                    <Icon name={t.icon} class="w-3.5 h-3.5" aria-hidden="true" />
                    {t.label}
                  </span>
                ))}
              </div>
            )}
          </div>

        </div>
      </div>
      )}
    </div>
  ))}

  <!-- ── Flechas laterales ── -->
  <button class="slider-arrow slider-arrow--prev" type="button" aria-label="Slide anterior">
    <Icon name="tabler:chevron-left" class="w-6 h-6" aria-hidden="true" />
  </button>
  <button class="slider-arrow slider-arrow--next" type="button" aria-label="Slide siguiente">
    <Icon name="tabler:chevron-right" class="w-6 h-6" aria-hidden="true" />
  </button>

  <!-- ── Dot Navigation ── -->
  <div class="slider-dots" role="tablist" aria-label="Slides">
    {slides.map((_, i) => (
      <button
        class={`slider-dot${i === 0 ? ' active' : ''}`}
        data-index={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Ir al slide ${i + 1}`}
      />
    ))}
  </div>

</section>

<!-- ── Stats Bar ── -->
<div class="hero-stats-bar">
  <div class="stats-container max-w-7xl mx-auto px-3 sm:px-6 md:px-10 lg:px-16">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
      <div class="stat-cell border-b border-white/5 md:border-b-0">
        <div class="stat-num">+420</div>
        <div class="stat-lbl">
          <span class="sm:hidden">Asociados<br />activos</span>
          <span class="hidden sm:inline">Asociados activos</span>
        </div>
      </div>
      <div class="stat-cell border-b border-white/5 md:border-b-0">
        <div class="stat-num">+12</div>
        <div class="stat-lbl">
          <span class="sm:hidden">Convenios<br />activos</span>
          <span class="hidden sm:inline">Convenios activos</span>
        </div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">98.2%</div>
        <div class="stat-lbl">
          <span class="sm:hidden">Tasa<br />satisfacción</span>
          <span class="hidden sm:inline">Tasa de satisfacción</span>
        </div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">+33</div>
        <div class="stat-lbl">
          <span class="sm:hidden">Años<br />trayectoria</span>
          <span class="hidden sm:inline">Años de trayectoria</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Keyframe Animations ── */
  @keyframes slideInUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(36px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  /* ── Slider Container ── */
  .hero-slider {
    position: relative;
    height: 736px;
    background: #172B36;
    overflow: hidden;
  }
  @media (max-width: 1023px) {
    .hero-slider { height: 740px; }
  }
  @media (max-width: 639px) {
    .hero-slider { height: 640px; }
  }

  /* ── Slides ── */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
    z-index: 0;
    overflow: hidden;
  }
  .slide.is-active {
    opacity: 1;
    pointer-events: all;
    z-index: 1;
  }

  /* ── Imagen de fondo: mismo marco para todas las slides (60% del ancho
     en desktop, degradado idéntico hacia la columna de texto). El ajuste
     fino de cada foto se hace con `imagePos` en los datos de la slide, no
     con CSS por id. ── */
  .slide-img-bg {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 60%;
    z-index: 0;
    overflow: hidden;
  }
  /* Difuminado hacia la izquierda */
  .slide-img-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to left,
      rgba(23, 43, 54, 0.0) 0%,
      rgba(23, 43, 54, 0.0) 30%,
      rgba(23, 43, 54, 0.5) 60%,
      rgba(23, 43, 54, 0.92) 80%,
      #172B36 100%
    );
    pointer-events: none;
  }

  /* ── Slide alineado a la derecha: imagen a la izquierda, contenido a la derecha ── */
  .slide--align-right .slide-img-bg {
    right: auto;
    left: 0;
  }
  /* Difuminado más oscuro para que el texto se lea bien, solo el lado derecho donde está el contenido */
  .slide--align-right .slide-img-bg::after {
    background: linear-gradient(
      to right,
      rgba(23, 43, 54, 0.0) 0%,
      rgba(23, 43, 54, 0.2) 30%,
      rgba(23, 43, 54, 0.95) 70%,
      #172B36 100%
    );
  }
  .slide--align-right .slide-grid {
    justify-content: flex-end;
  }
  .slide--align-right .slide-content {
    margin-left: auto;
  }
  /* ── Slide solo imagen: la pieza gráfica ocupa todo el ancho del slide,
     sin degradado ni textos. En desktop la imagen cubre el marco completo
     (cover); en tablet/móvil se muestra completa (contain) sobre una copia
     difuminada de sí misma que rellena el espacio restante. El selector
     compuesto gana en especificidad a los ajustes responsive de
     .slide-img-bg. ── */
  .slide--image-only .slide-img-bg {
    width: 100%;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: 100%;
  }
  .slide--image-only .slide-img-bg::after {
    display: none;
  }
  .slide--image-only .slide-img-fill {
    position: relative;
    z-index: 1;
    object-fit: cover;
    object-position: center center;
  }
  .slide-img-blur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(28px) brightness(0.75);
    transform: scale(1.12);
  }

  .slide-img-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Recorte por slide: viene de `imagePos` en los datos (--img-pos) */
    object-position: var(--img-pos, center center);
    display: block;
  }

  /* ── Slide Grid Layout ── */
  .slide-grid {
    display: flex;
    align-items: center;
    padding: 2rem 0 4rem;
    height: 100%;
  }
  /* Columna de texto: mismo ancho en todas las slides */
  .slide-content {
    width: 56%;
    max-width: 780px;
    flex-shrink: 0;
  }

  /* ── Slide sin imagen: contenido centrado y más ancho, ya que no hay
     foto a la derecha compitiendo por espacio ── */
  .slide--no-image .slide-grid {
    justify-content: center;
  }
  .slide--no-image .slide-content {
    width: 100%;
    max-width: 640px;
    text-align: center;
  }
  .slide--no-image .slide-lead {
    margin-left: auto;
    margin-right: auto;
  }
  .slide--no-image .slide-ctas {
    justify-content: center;
  }
  .slide--no-image .slide-trust {
    justify-content: center;
  }

  /* ── Slide Content Animations (only when active) ── */
  .slide.is-active .slide-img-bg  { animation: slideInUp 0.6s ease 0s both; }
  .slide.is-active .slide-h1      { animation: slideInUp 0.55s ease 0.25s both; }
  .slide.is-active .slide-lead    { animation: slideInUp 0.5s ease 0.35s both; }
  .slide.is-active .slide-ctas    { animation: slideInUp 0.5s ease 0.45s both; }
  .slide.is-active .slide-trust   { animation: slideInUp 0.5s ease 0.55s both; }

  /* ── Heading ── */
  .slide-h1 {
    font-size: clamp(2.5rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 1.5rem;
    /* Cada línea del título viene con su salto explícito (\n en los datos);
       evitamos que el navegador la parta en dos */
    white-space: nowrap;
  }
  .slide-h1 em {
    font-style: normal;
  }

  /* ── Lead ── */
  .slide-lead {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 460px;
    margin-bottom: 2.5rem;
  }

  /* ── CTAs ── */
  .slide-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 2.25rem;
  }

  /* ── Trust pills ── */
  .slide-trust {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    padding: 0.35rem 0.875rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.07);
    white-space: nowrap;
  }


  /* ── Flechas laterales ── */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .slider-arrow:hover {
    background: #FFC801;
    color: #172B36;
    border-color: transparent;
  }
  .slider-arrow--prev { left: 1.25rem; }
  .slider-arrow--next { right: 1.25rem; }

  /* ── Dot Navigation ── */
  .slider-dots {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: background 0.2s, width 0.3s, border-radius 0.3s;
    padding: 0;
  }
  .slider-dot.active {
    width: 28px;
    border-radius: 4px;
    background: #FFC801;
  }

  /* ── Stats Bar ── */
  .hero-stats-bar {
    background: #172B36;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    z-index: 5;
  }
  .stat-cell {
    padding: 1.5rem 2rem;
    text-align: center;
  }
  .stat-num {
    font-size: 1.875rem;
    font-weight: 800;
    color: #FFC801;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-lbl {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.3rem;
    font-weight: 500;
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .stat-cell { padding: 1.25rem 1rem; }
    .stat-num  { font-size: 1.5rem; }
    .stat-lbl  { font-size: 0.75rem; }

    /* En tablet: imagen ocupa la parte superior como franja */
    .slide-img-bg {
      width: 100%;
      left: 0;
      right: 0;
      height: 300px;
      bottom: auto;
    }
    .slide-img-bg::after {
      background: linear-gradient(
        to bottom,
        rgba(23, 43, 54, 0.1) 20%,
        rgba(23, 43, 54, 0.7) 70%,
        #172B36 100%
      );
    }
    /* Para nuestro banner específico, resetear los estilos de desktop en tablet */
    .slide--align-right .slide-img-bg {
      right: 0;
      left: 0;
    }
    .slide--align-right .slide-img-bg::after {
      background: linear-gradient(
        to bottom,
        rgba(23, 43, 54, 0.1) 20%,
        rgba(23, 43, 54, 0.7) 70%,
        #172B36 100%
      );
    }
    .slide--align-right .slide-grid {
      justify-content: flex-start;
    }
    .slide--align-right .slide-content {
      margin-left: 0;
    }
    .slide-grid { padding: 18rem 0 4rem; }
    .slide-content { width: 100%; max-width: 100%; }
    /* Sin imagen no hay franja superior que compensar */
    .slide--no-image .slide-grid { padding: 3rem 0; }

    /* Slide solo imagen: se muestra completa a todo el ancho; el fondo
       difuminado rellena el alto restante */
    .slide--image-only .slide-img-fill { object-fit: contain; }

    .slider-arrow { width: 38px; height: 38px; }
    .slider-arrow--prev { left: 0.75rem; }
    .slider-arrow--next { right: 0.75rem; }
  }
  @media (max-width: 639px) {
    .hero-slider { height: auto; min-height: 700px; }
    .slider-dots { display: none; } /* Ocultamos los puntos de navegación en móviles */

    /* En móvil no mostramos flechas: la navegación es por swipe */
    .slider-arrow { display: none; }
    .slide-img-bg { height: 380px; left: 0; right: 0; width: 100%; }
    .slide-img-fill {
      /* Recorte móvil por slide (imagePosMobile); por defecto alineada a la
         izquierda para que no quede espacio blanco */
      object-position: var(--img-pos-m, left center);
    }
    /* Para nuestro banner específico, resetear los estilos de desktop en móvil */
    .slide--align-right .slide-img-bg {
      right: 0;
      left: 0;
    }
    .slide--align-right .slide-img-bg::after {
      background: linear-gradient(
        to bottom,
        rgba(23, 43, 54, 0.1) 20%,
        rgba(23, 43, 54, 0.7) 70%,
        #172B36 100%
      );
    }
    .slide--align-right .slide-grid {
      justify-content: flex-start;
    }
    .slide--align-right .slide-content {
      margin-left: 0;
    }
    .slide-grid { padding: 24rem 0 12rem; } /* Aumentamos aún más el espacio inferior para separar de las stats */
    /* Sin imagen no hay franja superior que compensar */
    .slide--no-image .slide-grid { padding: 3rem 0 6rem; }

    .slide-content { width: 100%; max-width: 100%; }
    /* En móvil el título vuelve a partir línea libremente: con nowrap se
       saldría de la pantalla */
    .slide-h1 { font-size: 2.25rem; line-height: 1.05; margin-bottom: 1rem; white-space: normal; }
    .slide-lead { font-size: 1rem; line-height: 1.6; margin-bottom: 1.75rem; color: rgba(255, 255, 255, 0.85); }
    .slide-ctas {
      margin-bottom: 1.5rem;
      flex-direction: column;
      align-items: center;
    }
    .slide-ctas .btn {
      width: 100%;
      max-width: 320px;
      justify-content: center;
      padding: 0.875rem 1.5rem;
      font-size: 0.9375rem;
      border-radius: 9999px;
    }
    .slide-trust { display: none; }
    
    /* Ajustamos el grid de stats para que se vea en 1 fila y 4 columnas en móviles */
    .stats-container .grid {
      grid-template-columns: repeat(4, 1fr) !important;
    }
    .stat-cell { padding: 1rem 0.25rem; } /* Reducimos el padding para que quepan todas */
    .stat-cell { border-right: 1px solid rgba(255, 255, 255, 0.1); } /* Mantenemos los bordes entre ellas */
    .stat-cell:last-child { border-right: none; } /* Quitamos el último borde */
    .stat-num { font-size: 1.125rem; } /* Reducimos solo un poquito el tamaño de los números */
    .stat-lbl { font-size: 0.65rem; line-height: 1.2; } /* Reducimos un poco el tamaño de las etiquetas */
  }
</style>

<script>
  const slides  = document.querySelectorAll<HTMLElement>('.slide');
  const dots    = document.querySelectorAll<HTMLElement>('.slider-dot');
  const slider  = document.getElementById('heroSlider');

  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  let paused  = false;

  function activateSlide(n: number) {
    // Remove active from current
    slides[current].classList.remove('is-active');
    slides[current].setAttribute('aria-hidden', 'true');
    if (dots.length > 0) {
      dots[current].classList.remove('active');
      dots[current].setAttribute('aria-selected', 'false');
    }

    // Set new current
    current = (n + slides.length) % slides.length;

    slides[current].classList.add('is-active');
    slides[current].setAttribute('aria-hidden', 'false');
    if (dots.length > 0) {
      dots[current].classList.add('active');
      dots[current].setAttribute('aria-selected', 'true');
    }

    // Resetear timer
    resetTimer();
  }

  function next() { activateSlide(current + 1); }
  function prev() { activateSlide(current - 1); }

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(() => { if (!paused) next(); }, 6000);
  }

  // Init
  timer = setInterval(() => { if (!paused) next(); }, 6000);

  // Dots
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { activateSlide(i); });
  });

  // Flechas laterales
  document.querySelector('.slider-arrow--prev')?.addEventListener('click', () => { prev(); });
  document.querySelector('.slider-arrow--next')?.addEventListener('click', () => { next(); });

  // Pause on hover (solo en desktop)
  if (window.innerWidth > 1023) {
    slider?.addEventListener('mouseenter', () => { paused = true; });
    slider?.addEventListener('mouseleave', () => { paused = false; });
  }

  // Touch/swipe support
  let touchStartX = 0;
  slider?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  slider?.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) { next(); } else { prev(); }
      resetTimer();
    }
  }, { passive: true });
</script>
