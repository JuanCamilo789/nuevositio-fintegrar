---
import { Icon } from 'astro-icon/components';

const slides = [
  {
    id: 'slide-0',
    subtitle: 'FONDO DE EMPLEADOS FINTEGRAR',
    heading: 'Su aliado estratégico <br>para hacer crecer su <br><span class="text-accent">bienestar</span>',
    lead: 'Más de 36 años construyendo futuro junto a nuestros asociados. Soluciones financieras solidarias, ahorro y beneficios para usted y su familia.',
    cta1: { label: 'Acceso al Portal', icon: 'tabler:layout-dashboard', href: 'https://tramitesvirtuales.fintegrar.com/', primary: true },
    cta2: { label: 'Conózcanos', icon: 'tabler:arrow-right', href: '/nosotros', primary: false },
    image: '/assets/img/hero-slide-1.png',
  },
  {
    id: 'slide-1',
    subtitle: 'CRÉDITO FÁCIL Y SOLIDARIO',
    heading: 'Líneas de crédito diseñadas para <br><span class="text-accent">acompañar sus metas</span>',
    lead: 'Crédito ordinario, educativo, vacacional y de calamidad con condiciones favorables y fácil descuento por nómina.',
    cta1: { label: 'Ver líneas de crédito', icon: 'tabler:credit-card', href: '/creditos', primary: true },
    cta2: { label: 'Simular crédito', icon: 'tabler:calculator', href: '/#simulador', primary: false },
  },
  {
    id: 'slide-2',
    subtitle: 'CULTIVE SU FUTURO',
    heading: 'Ahorro constante <br>y CDAT con <span class="text-accent">rentabilidad asegurada</span>',
    lead: 'Construya su tranquilidad financiera con Aportes Sociales, Ahorro Navideño, Pequeños Ahorradores y opciones de CDAT.',
    cta1: { label: 'Planes de ahorro', icon: 'tabler:wallet', href: '/ahorros', primary: true },
    cta2: { label: 'Ver convenios', icon: 'tabler:building-store', href: '/convenios', primary: false },
    image: '/assets/img/hero-slide-2.png',
  },
  {
    id: 'slide-alivio',
    subtitle: 'ACOMPAÑAMIENTO FINANCIERO',
    heading: 'Le orientamos para <br><span class="text-accent">cuidar su tranquilidad financiera</span>',
    lead: '¿Necesita reorganizar sus compromisos o evaluar un plan de pagos? Le escuchamos con total confidencialidad y calidez humana.',
    cta1: { label: 'Hablemos ahora', icon: 'tabler:phone', href: 'tel:+573174879669', primary: true },
    cta2: { label: 'Escribir por correo', icon: 'tabler:mail', href: 'mailto:gerencia@fintegrar.com', primary: false },
  },
];

const featureCards = [
  {
    href: '/creditos',
    title: 'Líneas de Crédito',
    desc: 'Ordinarios, educativos, calamidad, vivienda y compra de cartera.',
    cta: 'Ver créditos',
    img: '/assets/img/hero-card-creditos.png',
    accent: 'purple',
    blob: 'blob-1',
  },
  {
    href: '/ahorros',
    title: 'Ahorro y CDAT',
    desc: 'Ahorro Navideño, Pequeños Ahorradores y CDAT a término.',
    cta: 'Conocer ahorros',
    img: '/assets/img/hero-card-ahorros.png',
    accent: 'sky',
    blob: 'blob-2',
  },
  {
    href: '/nosotros',
    title: 'Nosotros',
    desc: 'Nuestra historia y los valores que nos identifican.',
    cta: 'Conócenos',
    img: '/assets/img/hero-card-nosotros.png',
    accent: 'purple',
    blob: 'blob-3',
  },
];
---

<div class="hero-wrapper relative">

<section id="heroSlider" class="hero-slider relative w-full bg-slate-100 overflow-hidden" aria-label="Presentación FINTEGRAR" data-dark-bg>

  {slides.map((s, i) => (
    <div
      class={`slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-1000 ${i === 0 ? 'is-active' : ''} ${s.image ? 'has-photo' : ''}`}
      id={s.id}
      aria-hidden={i !== 0 ? 'true' : 'false'}
      style={s.image ? undefined : 'background: var(--color-brand-purple);'}
    >
      {s.image && (
        <>
          <img src={s.image} alt="" class="slide-photo absolute inset-0 w-full h-full object-cover" />
          <div class="slide-scrim absolute inset-0" aria-hidden="true"></div>
        </>
      )}
      <svg class="slide-wave absolute bottom-0 left-0 w-full" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,120 L0,70 C 280,-10 1160,-10 1440,70 L1440,120 Z" fill="var(--color-white)" />
      </svg>
      {!s.imageOnly && (
        <>
          <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pb-14 sm:pb-16 h-full flex flex-col items-center sm:items-start justify-center min-w-0">

            <div class="max-w-2xl w-full min-w-0 text-center sm:text-left flex flex-col items-center sm:items-start">

              <h1 class="slide-title max-w-xl text-4xl md:text-5xl lg:text-[4rem] font-extrabold leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 0.3s; animation-fill-mode: both;" set:html={s.heading} />

              <p class="slide-lead text-lg md:text-xl mb-8 max-w-xl animate-fade-in-up" style="animation-delay: 0.4s; animation-fill-mode: both;">
                {s.lead}
              </p>

              {(s.cta1 || s.cta2) && (
                <div class="slide-ctas flex flex-col sm:flex-row items-stretch sm:items-center justify-center sm:justify-start gap-4 animate-fade-in-up" style="animation-delay: 0.5s; animation-fill-mode: both;">
                  {s.cta1 && (
                    <a href={s.cta1.href} class={`inline-flex w-full sm:w-auto items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-all ${s.cta1.primary ? 'hero-btn-purple shadow-lg hover:shadow-xl' : 'bg-white text-[var(--color-ink)] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                      {s.cta1.icon && <Icon name={s.cta1.icon} class="w-5 h-5" />}
                      {s.cta1.label}
                    </a>
                  )}
                  {s.cta2 && (
                    <a href={s.cta2.href} class={`inline-flex w-full sm:w-auto items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-all ${s.cta2.primary ? 'hero-btn-purple shadow-lg hover:shadow-xl' : 'bg-white text-[var(--color-ink)] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                      {s.cta2.label}
                      {s.cta2.icon && <Icon name={s.cta2.icon} class="w-5 h-5" />}
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  ))}

  <div class="slider-dots absolute bottom-5 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2.5" role="tablist" aria-label="Seleccionar slide">
    {slides.map((s, i) => (
      <button
        type="button"
        class={`slider-dot relative h-2.5 rounded-full overflow-hidden transition-all duration-300 cursor-pointer bg-[#a78bfa] ${i === 0 ? 'w-8 is-filling' : 'w-2.5'}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={s.id}
        aria-label={`Ir a la slide ${i + 1}`}
      ><span class="slider-dot-fill"></span></button>
    ))}
  </div>

</section>

<div class="hero-brand-shape-layer absolute inset-x-0 top-0" aria-hidden="true">
  <svg class="slide-brand-shape absolute" viewBox="70 -5 135 163" aria-hidden="true">
    <defs>
      <linearGradient id="heroBrandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0" stop-color="#00132b" />
        <stop offset=".2" stop-color="#5c458f" />
        <stop offset=".4" stop-color="#81c1d6" />
        <stop offset=".6" stop-color="#7abf72" />
        <stop offset=".8" stop-color="#efc747" />
        <stop offset="1" stop-color="#d58b3b" />
      </linearGradient>
    </defs>
    <path
      d="M116.33,46.53c-15.94,10.24-28.73,29.56-29.34,48.05-.32,8.32,2.23,19.12,11.82,20.57,9.57,1.09,17.09-8.34,21-16.14,5.52-12.43,6.96-27.35,15.26-38.85,8.48-11.85,19.69-23.74,35.5-23.79,19.15-.37,28.32,17.42,26.12,34.62-1.59,15.05-7.81,28.61-15.51,41.33-8.17,13.26-18.06,24.33-30.43,34.33-5.02,4.61-12.96,4.14-17.25-1.19-5.71-6.67-1.55-17.67,7.03-19.04,9.13-1.66,17.71-7.05,24.54-13.48,11.65-11.11,19.66-27.12,20.81-42.84.41-6.21-.3-12.36-2.84-16.98-5.51-10.07-21.53-12.47-31.06-5.51-5.51,3.95-10.47,8.72-14.15,14.39-8.03,11.65-8.5,25.88-14.26,38.78-4.81,9.79-13.07,20.8-25.29,20.48-13.59-.74-19.74-14.23-20.37-26.26-1.56-15.14,3.85-30.25,10.98-43.26,3.49-6.6,7.21-12.99,10.28-20.07,2.62-6.03,9.64-8.79,15.67-6.16,8.74,3.59,9.57,16.3,1.51,21.04h0Z"
      fill="url(#heroBrandGrad)"
    />
  </svg>
</div>

<div class="relative z-30 mt-2 sm:mt-3 pb-8 sm:pb-12 lg:pb-14">
  <div class="absolute inset-x-0 top-0 bottom-0 bg-[var(--color-white)]" aria-hidden="true"></div>
  <div class="relative max-w-[70rem] mx-auto px-4 sm:px-6 md:px-10 pt-8 sm:pt-10 pb-4 sm:pb-6">
    <div class="services-list flex flex-col">
      {featureCards.map((c, i) => (
        <a href={c.href} class={`service-row service-row--${c.accent} reveal reveal-delay-${i + 1} group no-underline ${i % 2 === 1 ? 'service-row--reverse' : ''}`}>
          <div class="service-figure">
            <span class={`service-figure-blob service-figure--${c.accent} ${c.blob}`} aria-hidden="true"></span>
            <div class={`service-figure-mask ${c.blob}`}>
              <img src={c.img} alt="" class="service-figure-img" loading="lazy" />
            </div>
            <img src={c.img} alt="" class="service-figure-img service-figure-img--top" loading="lazy" aria-hidden="true" />
          </div>
          <div class="service-copy">
            <h3 class="service-title">{c.title}</h3>
            <p class="service-desc">{c.desc}</p>
            <span class={`service-cta service-cta--${c.accent}`}>
              {c.cta}
              <Icon name="tabler:arrow-up-right" class="w-4 h-4" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

</div>

<style>
  .hero-btn-purple {
    background: var(--color-brand-purple);
    color: var(--color-white);
  }

  .hero-slider {
    height: calc(680px + var(--header-h));
    min-height: calc(74vh + var(--header-h));
    padding-top: var(--header-h);
  }
  @media (max-width: 768px) {
    .hero-slider {
      height: calc(600px + var(--header-h));
      min-height: auto;
    }
  }

  .slide {
    padding-top: var(--header-h);
  }

  .slide-photo {
    z-index: 0;
    object-position: center 30%;
  }

  .hero-brand-shape-layer {
    height: calc(680px + var(--header-h));
    z-index: 40;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
    will-change: opacity;
  }
  @media (max-width: 768px) {
    .hero-brand-shape-layer {
      height: calc(600px + var(--header-h));
    }
  }

  .slide-brand-shape {
    top: -35%;
    bottom: -30%;
    right: -12%;
    height: 165%;
    width: auto;
    pointer-events: none;
    opacity: 0.25;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 639px) {
    .hero-brand-shape-layer {
      display: none;
    }
  }

  .services-list {
    position: relative;
    z-index: 1;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .services-list {
      gap: 3rem;
    }
  }

  .service-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 58rem;
    margin: 0 auto;
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .service-row {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 3.5rem;
    }
    .service-row--reverse {
      flex-direction: row-reverse;
    }
  }

  .service-figure {
    position: relative;
    flex-shrink: 0;
    width: 10rem;
    height: 10.5rem;
  }
  @media (min-width: 640px) {
    .service-figure {
      width: 11.5rem;
      height: 12rem;
    }
  }

  .service-figure-blob {
    position: absolute;
    inset: 15% 0 0 0;
    z-index: 0;
  }

  .service-figure--purple {
    background: var(--color-brand-purple);
  }
  .service-figure--sky {
    background: var(--color-brand-sky-blue);
  }
  .service-figure--gold {
    background: var(--color-brand-gold);
  }

  .blob-1 {
    border-radius: 63% 37% 54% 46% / 43% 39% 61% 57%;
  }
  .blob-2 {
    border-radius: 38% 62% 63% 37% / 55% 40% 60% 45%;
  }
  .blob-3 {
    border-radius: 55% 45% 40% 60% / 60% 35% 65% 40%;
  }

  /* Máscara inferior: recorta la parte de abajo de la imagen con la forma del blob */
  .service-figure-mask {
    position: absolute;
    inset: 15% 0 0 0;
    overflow: hidden;
    z-index: 1;
  }

  .service-figure-img {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 9.5rem;
    height: 12rem;
    object-fit: contain;
    object-position: bottom center;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .service-figure-img {
      width: 11rem;
      height: 13.8rem;
    }
  }

  /* Capa superior: la cabeza y parte superior de la imagen sobresalen del blob sin cortes */
  .service-figure-img--top {
    z-index: 2;
    clip-path: inset(0 0 45% 0);
  }

  .service-copy {
    flex: 1;
    min-width: 0;
    max-width: 40rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .service-copy {
      text-align: left;
    }
    .service-row--reverse .service-copy {
      text-align: right;
    }
  }

  .service-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .service-desc {
    margin-top: 0.625rem;
    font-size: 1rem;
    line-height: var(--lh-160);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  @media (max-width: 639px) {
    .service-desc {
      white-space: normal;
    }
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    transition: gap 0.25s ease;
  }
  @media (min-width: 768px) {
    .service-row--reverse .service-cta {
      margin-left: auto;
    }
  }

  .service-row:hover .service-cta {
    gap: 0.65rem;
  }

  .service-cta--purple {
    color: var(--color-brand-purple);
  }
  .service-cta--sky {
    color: var(--color-steel-blue);
  }
  .service-cta--gold {
    color: var(--color-gold-dark);
  }

  .slide-scrim {
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(var(--color-ink-rgb), 0.9) 0%,
      rgba(var(--color-ink-rgb), 0.65) 40%,
      rgba(var(--color-ink-rgb), 0.2) 70%,
      rgba(var(--color-ink-rgb), 0) 90%
    );
  }

  .slide-wave {
    z-index: 3;
    height: 70px;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .slide-wave {
      height: 100px;
    }
  }

  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 10;
  }

  .slide-title,
  .slide-lead {
    font-family: var(--ff-heading);
    position: relative;
    z-index: 10;
  }

  .slide-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: var(--color-white);
  }

  .slide-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: var(--lh-160);
    color: rgba(var(--color-white-rgb), 0.85);
  }

  .slide.has-photo .slide-title {
    color: var(--color-white);
    text-shadow: 0 2px 16px rgba(var(--color-ink-rgb), 0.35);
  }

  .slide.has-photo .slide-lead {
    color: rgba(var(--color-white-rgb), 0.7);
    text-shadow: 0 1px 10px rgba(var(--color-ink-rgb), 0.3);
  }

  .text-accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in-up {
    animation-name: fadeInUp;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-fade-in-left {
    animation-name: fadeInLeft;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Retrigger animations when slide becomes active */
  .slide:not(.is-active) .animate-fade-in-up,
  .slide:not(.is-active) .animate-fade-in-left {
    animation: none;
    opacity: 0;
  }

  .slider-dot-fill {
    position: absolute;
    inset: 0;
    width: 0%;
    background: var(--color-brand-purple);
    border-radius: inherit;
  }
  .slider-dot.is-filling .slider-dot-fill {
    animation: dotFill 3500ms linear forwards;
  }
  #heroSlider[data-paused='true'] .slider-dot-fill {
    animation-play-state: paused;
  }

  @keyframes dotFill {
    from { width: 0%; }
    to { width: 100%; }
  }
</style>

<script>
  function initSlider() {
    const slides = document.querySelectorAll<HTMLElement>('.slide');
    const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
    const slider = document.getElementById('heroSlider');

    if (!slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    let paused = false;

    function setDotFilling(dot: HTMLElement, filling: boolean) {
      const fill = dot.querySelector<HTMLElement>('.slider-dot-fill');
      dot.classList.remove('is-filling');
      if (fill) fill.style.animation = 'none';
      if (filling && fill) {
        void fill.offsetWidth;
        fill.style.animation = '';
        dot.classList.add('is-filling');
      }
    }

    function activateSlide(n: number) {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      if (dots.length) {
        dots[current].classList.remove('w-8');
        dots[current].classList.add('w-2.5');
        dots[current].setAttribute('aria-selected', 'false');
        setDotFilling(dots[current], false);
      }

      current = (n + slides.length) % slides.length;

      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');
      if (dots.length) {
        dots[current].classList.remove('w-2.5');
        dots[current].classList.add('w-8');
        dots[current].setAttribute('aria-selected', 'true');
        setDotFilling(dots[current], true);
      }

      resetTimer();
    }

    function next() { activateSlide(current + 1); }
    function prev() { activateSlide(current - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => { if (!paused) next(); }, 3500);
    }

    resetTimer();

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => activateSlide(i));
    });

    if (window.innerWidth > 1023 && slider) {
      slider.addEventListener('mouseenter', () => {
        paused = true;
        slider.setAttribute('data-paused', 'true');
      });
      slider.addEventListener('mouseleave', () => {
        paused = false;
        slider.setAttribute('data-paused', 'false');
      });
    }

    let touchStartX = 0;
    slider?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider?.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) next();
        else prev();
        resetTimer();
      }
    }, { passive: true });
  }

  initSlider();
  document.addEventListener('astro:after-swap', initSlider);

  function initBrandShapeFade() {
    const layer = document.querySelector<HTMLElement>('.hero-brand-shape-layer');
    if (!layer) return;

    const fadeDistance = 600;

    function updateOpacity() {
      const opacity = Math.max(0, 1 - window.scrollY / fadeDistance);
      layer!.style.opacity = String(opacity);
    }

    updateOpacity();
    window.addEventListener('scroll', updateOpacity, { passive: true });
  }

  initBrandShapeFade();
</script>
