---
import { Icon } from 'astro-icon/components';

const slides = [
  {
    id: 'slide-0',
    subtitle: 'FONDO DE EMPLEADOS FINTEGRAR',
    heading: 'Su aliado estratégico para <br><span class="text-accent">hacer crecer su bienestar</span>',
    lead: 'Más de 36 años construyendo futuro junto a nuestros asociados. Soluciones financieras solidarias, ahorro y beneficios para usted y su familia.',
    cta1: { label: 'Acceso al Portal', icon: 'tabler:layout-dashboard', href: 'https://tramitesvirtuales.fintegrar.com/', primary: true },
    cta2: { label: 'Conózcanos', icon: 'tabler:arrow-right', href: '/nosotros', primary: false },
  },
  {
    id: 'slide-1',
    subtitle: 'CRÉDITO FÁCIL Y SOLIDARIO',
    heading: 'Líneas de crédito diseñadas para <br><span class="text-accent">acompañar sus metas</span>',
    lead: 'Crédito ordinario, educativo, vacacional y de calamidad con condiciones favorables y fácil descuento por nómina.',
    cta1: { label: 'Ver líneas de crédito', icon: 'tabler:credit-card', href: '/creditos', primary: true },
    cta2: { label: 'Simular crédito', icon: 'tabler:calculator', href: '/creditos#simulador', primary: false },
  },
  {
    id: 'slide-2',
    subtitle: 'CULTIVE SU FUTURO',
    heading: 'Ahorro constante y CDAT con <br><span class="text-accent">rentabilidad asegurada</span>',
    lead: 'Construya su tranquilidad financiera con Aportes Sociales, Ahorro Navideño, Pequeños Ahorradores y opciones de CDAT.',
    cta1: { label: 'Planes de ahorro', icon: 'tabler:wallet', href: '/ahorros', primary: true },
    cta2: { label: 'Ver convenios', icon: 'tabler:building-store', href: '/convenios', primary: false },
  },
  {
    id: 'slide-alivio',
    subtitle: 'ACOMPAÑAMIENTO FINANCIERO',
    heading: 'Le orientamos para cuidar su <br><span class="text-accent">tranquilidad financiera</span>',
    lead: '¿Necesita reorganizar sus compromisos o evaluar un plan de pagos? Le escuchamos con total confidencialidad y calidez humana.',
    cta1: { label: 'Hablemos ahora', icon: 'tabler:phone', href: 'tel:+573174879669', primary: true },
    cta2: { label: 'Escribir por correo', icon: 'tabler:mail', href: 'mailto:gerencia@fintegrar.com', primary: false },
  },
];
---

<section id="heroSlider" class="hero-slider relative w-full bg-slate-100 overflow-hidden" aria-label="Presentación FINTEGRAR">

  {slides.map((s, i) => (
    <div
      class={`slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-1000 ${i === 0 ? 'is-active' : ''} ${s.image ? 'has-photo' : ''}`}
      id={s.id}
      aria-hidden={i !== 0 ? 'true' : 'false'}
      style={s.image ? undefined : 'background: var(--color-navbar-bg);'}
    >
      <svg class="slide-brand-shape absolute" viewBox="70 -5 135 163" aria-hidden="true">
        <defs>
          <linearGradient id={`slideGrad-${s.id}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0" stop-color="#00132b" />
            <stop offset=".2" stop-color="#5c458f" />
            <stop offset=".4" stop-color="#81c1d6" />
            <stop offset=".6" stop-color="#7abf72" />
            <stop offset=".8" stop-color="#efc747" />
            <stop offset="1" stop-color="#d58b3b" />
          </linearGradient>
        </defs>
        <path
          d="M116.33,46.53c-15.94,10.24-28.73,29.56-29.34,48.05-.32,8.32,2.23,19.12,11.82,20.57,9.57,1.09,17.09-8.34,21-16.14,5.52-12.43,6.96-27.35,15.26-38.85,8.48-11.85,19.69-23.74,35.5-23.79,19.15-.37,28.32,17.42,26.12,34.62-1.59,15.05-7.81,28.61-15.51,41.33-8.17,13.26-18.06,24.33-30.43,34.33-5.02,4.61-12.96,4.14-17.25-1.19-5.71-6.67-1.55-17.67,7.03-19.04,9.13-1.66,17.71-7.05,24.54-13.48,11.65-11.11,19.66-27.12,20.81-42.84.41-6.21-.3-12.36-2.84-16.98-5.51-10.07-21.53-12.47-31.06-5.51-5.51,3.95-10.47,8.72-14.15,14.39-8.03,11.65-8.5,25.88-14.26,38.78-4.81,9.79-13.07,20.8-25.29,20.48-13.59-.74-19.74-14.23-20.37-26.26-1.56-15.14,3.85-30.25,10.98-43.26,3.49-6.6,7.21-12.99,10.28-20.07,2.62-6.03,9.64-8.79,15.67-6.16,8.74,3.59,9.57,16.3,1.51,21.04h0Z"
          fill={`url(#slideGrad-${s.id})`}
        />
      </svg>

      {s.image && (
        <>
          <img src={s.image} alt="" class="slide-photo absolute inset-0 w-full h-full object-cover" />
          <div class="slide-scrim absolute inset-0" aria-hidden="true"></div>
          <svg class="slide-wave absolute bottom-0 left-0 w-full" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,120 L0,70 C 280,-10 1160,-10 1440,70 L1440,120 Z" fill="var(--color-white)" />
          </svg>
        </>
      )}
      {!s.imageOnly && (
        <>
          <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pb-14 sm:pb-16 h-full flex flex-col items-center sm:items-start justify-center min-w-0">

            <div class="max-w-2xl w-full min-w-0 text-center sm:text-left flex flex-col items-center sm:items-start">

              <h1 class="slide-title text-4xl md:text-5xl lg:text-[4rem] font-extrabold leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 0.3s; animation-fill-mode: both;" set:html={s.heading} />

              <p class="slide-lead text-lg md:text-xl mb-8 max-w-xl animate-fade-in-up" style="animation-delay: 0.4s; animation-fill-mode: both;">
                {s.lead}
              </p>

              {(s.cta1 || s.cta2) && (
                <div class="slide-ctas flex flex-wrap items-center justify-center sm:justify-start gap-4 animate-fade-in-up" style="animation-delay: 0.5s; animation-fill-mode: both;">
                  {s.cta1 && (
                    <a href={s.cta1.href} class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-all ${s.cta1.primary ? 'btn-gradient shadow-lg hover:shadow-xl' : 'bg-white text-[var(--color-ink)] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                      {s.cta1.icon && <Icon name={s.cta1.icon} class="w-5 h-5" />}
                      {s.cta1.label}
                    </a>
                  )}
                  {s.cta2 && (
                    <a href={s.cta2.href} class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-all ${s.cta2.primary ? 'btn-gradient shadow-lg hover:shadow-xl' : 'bg-white text-[var(--color-ink)] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                      {s.cta2.label}
                      {s.cta2.icon && <Icon name={s.cta2.icon} class="w-5 h-5" />}
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </>
      )}
    </div>
  ))}

</section>

<div class="relative z-30 -mt-14 sm:-mt-20 -mb-20 sm:-mb-28">
  <div class="absolute inset-x-0 top-14 sm:top-20 bottom-0 bg-[var(--color-navbar-bg)]" aria-hidden="true"></div>
  <div class="relative max-w-[85rem] mx-auto px-4 sm:px-6 md:px-10">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <a href="/creditos" class="relative block bg-white rounded-[2rem] shadow-[0_8px_30px_rgba(var(--color-black-rgb),0.08)] h-[240px] overflow-hidden group hover:-translate-y-1 transition-transform duration-300 no-underline cursor-pointer">
      <svg class="absolute bottom-0 left-0 w-full h-[65%] z-0" preserveAspectRatio="none" viewBox="0 0 100 100">
        <path d="M0,25 C25,5 75,45 100,20 L100,100 L0,100 Z" fill="#722CCE" />
      </svg>
      <div class="relative z-20 p-6 h-[100px] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-extrabold text-gray-800 tracking-tight leading-snug">Líneas de Crédito</h3>
          <p class="text-gray-600 text-xs mt-1 font-medium leading-snug">Ordinarios, educativos, calamidad, vivienda y compra de cartera.</p>
        </div>
        <div class="w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center flex-shrink-0 text-gray-800 group-hover:scale-110 transition-transform">
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
        </div>
      </div>
      <span class="absolute bottom-6 left-6 right-6 bg-white text-gray-900 text-center py-2.5 px-2 rounded-full font-bold text-xs sm:text-sm shadow-lg group-hover:shadow-xl group-hover:scale-[1.02] transition-all z-20 block">
        Ver créditos
      </span>
    </a>

    <a href="/ahorros" class="relative block bg-white rounded-[2rem] shadow-[0_8px_30px_rgba(var(--color-black-rgb),0.08)] h-[240px] overflow-hidden group hover:-translate-y-1 transition-transform duration-300 no-underline cursor-pointer">
      <svg class="absolute bottom-0 left-0 w-full h-[65%] z-0" preserveAspectRatio="none" viewBox="0 0 100 100">
        <path d="M0,25 C25,5 75,45 100,20 L100,100 L0,100 Z" fill="#722CCE" />
      </svg>
      <div class="relative z-20 p-6 h-[100px] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-extrabold text-gray-800 tracking-tight leading-snug">Ahorro y CDAT</h3>
          <p class="text-gray-600 text-xs mt-1 font-medium leading-snug">Ahorro Navideño, Pequeños Ahorradores y CDAT a término.</p>
        </div>
        <div class="w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center flex-shrink-0 text-gray-800 group-hover:scale-110 transition-transform">
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
        </div>
      </div>
      <span class="absolute bottom-6 left-6 right-6 bg-white text-gray-900 text-center py-2.5 px-2 rounded-full font-bold text-xs sm:text-sm shadow-lg group-hover:shadow-xl group-hover:scale-[1.02] transition-all z-20 block">
        Conocer ahorros
      </span>
    </a>

    <a href="/convenios" class="relative block bg-white rounded-[2rem] shadow-[0_8px_30px_rgba(var(--color-black-rgb),0.08)] h-[240px] overflow-hidden group hover:-translate-y-1 transition-transform duration-300 no-underline cursor-pointer">
      <svg class="absolute bottom-0 left-0 w-full h-[65%] z-0" preserveAspectRatio="none" viewBox="0 0 100 100">
        <path d="M0,25 C25,5 75,45 100,20 L100,100 L0,100 Z" fill="#722CCE" />
      </svg>
      <div class="relative z-20 p-6 h-[100px] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-extrabold text-gray-800 tracking-tight leading-snug">Convenios y Alianzas</h3>
          <p class="text-gray-600 text-xs mt-1 font-medium leading-snug">Descuentos en salud, educación, seguros y turismo.</p>
        </div>
        <div class="w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center flex-shrink-0 text-gray-800 group-hover:scale-110 transition-transform">
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
        </div>
      </div>
      <span class="absolute bottom-6 left-6 right-6 bg-white text-gray-900 text-center py-2.5 px-2 rounded-full font-bold text-xs sm:text-sm shadow-lg group-hover:shadow-xl group-hover:scale-[1.02] transition-all z-20 block">
        Ver convenios
      </span>
    </a>

    <a href="/nosotros#auxilios" class="relative block bg-white rounded-[2rem] shadow-[0_8px_30px_rgba(var(--color-black-rgb),0.08)] h-[240px] overflow-hidden group hover:-translate-y-1 transition-transform duration-300 no-underline cursor-pointer">
      <svg class="absolute bottom-0 left-0 w-full h-[65%] z-0" preserveAspectRatio="none" viewBox="0 0 100 100">
        <path d="M0,25 C25,5 75,45 100,20 L100,100 L0,100 Z" fill="#722CCE" />
      </svg>
      <div class="relative z-20 p-6 h-[100px] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-base font-extrabold text-gray-800 tracking-tight leading-snug">Bienestar y Auxilios</h3>
          <p class="text-gray-600 text-xs mt-1 font-medium leading-snug">Acompañamiento y auxilios para el asociado y su familia.</p>
        </div>
        <div class="w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center flex-shrink-0 text-gray-800 group-hover:scale-110 transition-transform">
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
        </div>
      </div>
      <span class="absolute bottom-6 left-6 right-6 bg-white text-gray-900 text-center py-2.5 px-2 rounded-full font-bold text-xs sm:text-sm shadow-lg group-hover:shadow-xl group-hover:scale-[1.02] transition-all z-20 block">
        Ver beneficios
      </span>
    </a>

  </div>
  </div>
</div>

<style>
  .hero-slider {
    height: calc(650px + var(--header-h));
    min-height: calc(72vh + var(--header-h));
    padding-top: var(--header-h);
  }
  @media (max-width: 768px) {
    .hero-slider {
      height: calc(580px + var(--header-h));
      min-height: auto;
    }
  }

  .slide {
    padding-top: var(--header-h);
  }

  .slide-photo {
    z-index: 0;
    object-position: center 30%;
  }

  .slide-brand-shape {
    top: -15%;
    bottom: -15%;
    right: -4%;
    height: 130%;
    width: auto;
    z-index: 1;
    pointer-events: none;
    opacity: 1;
  }

  @media (max-width: 639px) {
    .slide-brand-shape {
      display: none;
    }
  }

  .slide-scrim {
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(var(--color-ink-rgb), 0.82) 0%,
      rgba(var(--color-ink-rgb), 0.55) 40%,
      rgba(var(--color-ink-rgb), 0.15) 70%,
      rgba(var(--color-ink-rgb), 0) 90%
    );
  }

  .slide-wave {
    z-index: 3;
    height: 70px;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .slide-wave {
      height: 100px;
    }
  }

  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 10;
  }

  .slide-title,
  .slide-lead {
    font-family: var(--ff-heading);
    position: relative;
    z-index: 10;
  }

  .slide-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: var(--color-ink);
  }

  .slide-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: var(--lh-160);
    color: var(--color-text-muted);
  }

  .slide.has-photo .slide-title {
    color: var(--color-white);
    text-shadow: 0 2px 16px rgba(var(--color-ink-rgb), 0.35);
  }

  .slide.has-photo .slide-lead {
    color: rgba(var(--color-white-rgb), 0.7);
    text-shadow: 0 1px 10px rgba(var(--color-ink-rgb), 0.3);
  }

  .text-accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in-up {
    animation-name: fadeInUp;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-fade-in-left {
    animation-name: fadeInLeft;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Retrigger animations when slide becomes active */
  .slide:not(.is-active) .animate-fade-in-up,
  .slide:not(.is-active) .animate-fade-in-left {
    animation: none;
    opacity: 0;
  }
</style>

<script>
  function initSlider() {
    const slides = document.querySelectorAll<HTMLElement>('.slide');
    const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
    const slider = document.getElementById('heroSlider');

    if (!slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    let paused = false;

    function activateSlide(n: number) {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      if (dots.length) {
        dots[current].classList.remove('bg-[var(--color-brand-yellow)]', 'w-8');
        dots[current].classList.add('bg-white/50');
      }

      current = (n + slides.length) % slides.length;

      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');
      if (dots.length) {
        dots[current].classList.remove('bg-white/50');
        dots[current].classList.add('bg-[var(--color-brand-yellow)]', 'w-8');
      }

      resetTimer();
    }

    function next() { activateSlide(current + 1); }
    function prev() { activateSlide(current - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => { if (!paused) next(); }, 6000);
    }

    resetTimer();

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => activateSlide(i));
    });

    if (window.innerWidth > 1023 && slider) {
      slider.addEventListener('mouseenter', () => paused = true);
      slider.addEventListener('mouseleave', () => paused = false);
    }

    let touchStartX = 0;
    slider?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider?.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) next();
        else prev();
        resetTimer();
      }
    }, { passive: true });
  }

  initSlider();
  document.addEventListener('astro:after-swap', initSlider);
</script>
