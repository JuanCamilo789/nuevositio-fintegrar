---
import { Icon } from 'astro-icon/components';

const slides = [
  {
    id: 'slide-horarios',
    heading: 'Nuevos horarios de atención',
    lead: 'Lo atendemos de lunes a jueves de 8:00 a.m. a 4:30 p.m. y viernes de 8:00 a.m. a 3:30 p.m.',
    cta1: { label: 'Cómo llegar', icon: 'tabler:map-pin', href: 'https://maps.google.com/?q=Calle+50+%2365-42+Local+120,+Medell%C3%ADn' },
    cta2: { label: 'Ver directorio', icon: 'tabler:arrow-right', href: '/directorio' },
    image: '/assets/img/nuevo-horario-mobil.webp',
    imageAlt:
      'Nuevos horarios de atención: lunes a jueves de 8:00 a.m. a 4:30 p.m. y viernes de 8:00 a.m. a 3:30 p.m. Cll 50 #65-42 Local 120, Centro Comercial Contemporáneo',
  },
  {
    id: 'slide-0',
    heading: 'Donde su esfuerzo\nse convierte en\nbienestar',
    headingForce: true,
    lead: 'Más de 30 años brindando soluciones financieras confiables a nuestros asociados.',
    cta1: { label: 'Acceso al Portal', icon: 'tabler:layout-dashboard', href: 'https://serviciosdigitales.cooperamigo.coop/' },
    cta2: { label: 'Conózcanos', icon: 'tabler:arrow-right', href: '/nosotros' },
    image: '/assets/img/promos/publicidad2.webp',
    imageAlt: 'A veces no necesitas más tiempo, necesitas un empujón — Cooperamigó',
  },
  {
    id: 'slide-1',
    heading: 'Crédito ágil, condiciones que se adaptan a usted',
    lead: 'Tasas desde el 1.35% M.V., aprobación ágil y trámites completamente virtuales.',
    cta1: { label: 'Ver líneas de crédito', icon: 'tabler:credit-card', href: '/creditos' },
    cta2: { label: 'Simular crédito', icon: 'tabler:calculator', href: '/creditos#simulador' },
    image: '/assets/img/promos/publicidad6.webp',
    imageAlt: 'Créditos a la medida de todos: Ordinario, Educativo y Consumo — Cooperamigó',
  },
  {
    id: 'slide-2',
    heading: 'Cuidamos a su\nfamilia en los momentos\nque importan',
    headingForce: true,
    lead: 'Convenios en salud, educación y turismo para usted y su familia.',
    cta1: { label: 'Explorar beneficios', icon: 'tabler:heart', href: '/nosotros#auxilios' },
    cta2: { label: 'Ver convenios', icon: 'tabler:building-store', href: '/nosotros#convenios' },
    image: '/assets/img/promos/publicidad7.webp',
    imageAlt: 'Lo que hoy te mueve, nos importa — Cooperamigó',
  },
  {
    id: 'slide-alivio-financiero',
    heading: '¿Se atrasó con sus cuotas? Pongámonos al día',
    lead: 'Cuéntenos su situación y armamos juntos un plan de pago que sí pueda cumplir — sin regaños y en total confidencialidad.',
    cta1: { label: 'Hablemos ahora', icon: 'tabler:phone', href: 'tel:+573054070612' },
    cta2: { label: 'Escribir por correo', icon: 'tabler:mail', href: 'mailto:creditos@cooperamigo.coop' },
    image: '/assets/img/deudas.webp',
    imageAlt: 'Persona revisando tranquilamente sus finanzas en casa',
  },
];
---

<!-- ════════════════════════════════════
     HERO SLIDER
════════════════════════════════════ -->
<!-- data-hide-badge: las piezas gráficas de las slides ya traen impreso
     "VIGILADA SUPERSOLIDARIA"; el badge fijo se oculta sobre esta sección -->
<section id="heroSlider" class="hero-slider" aria-label="Presentación Cooperamigó" data-dark-bg data-hide-badge>

  <!-- ── Marca de agua: isotipo en blanco al fondo ── -->
  <div class="hero-watermark" aria-hidden="true">
    <img src="/favicon.svg" alt="" decoding="async" />
  </div>

  <!-- ── Slides ── -->
  {slides.map((s, i) => (
    <div
      class={`slide${i === 0 ? ' is-active' : ''}`}
      id={s.id}
      aria-hidden={i !== 0 ? 'true' : 'false'}
    >
      <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 h-full" style="position:relative;z-index:1;">
        <div class="slide-grid">

          <!-- Contenido -->
          <div class="slide-content">
            <!-- Por defecto sin saltos forzados (text-wrap balance reparte);
                 con headingForce los \n del texto se respetan tal cual -->
            <h1 class="slide-h1">
              {s.heading.split('\n').map((line, li) =>
                li > 0 ? <span>{s.headingForce ? <br /> : ' '}{line}</span> : <span>{line}</span>
              )}
            </h1>

            <p class="slide-lead">{s.lead}</p>

            {s.cta1 && s.cta2 && (
              <div class="slide-ctas">
                <a href={s.cta1.href} class="btn btn-accent btn-lg">
                  <Icon name={s.cta1.icon} class="w-5 h-5" aria-hidden="true" />
                  {s.cta1.label}
                </a>
                <a href={s.cta2.href} class="btn btn-ghost-light">
                  {s.cta2.label}
                  <Icon name={s.cta2.icon} class="w-4 h-4" aria-hidden="true" />
                </a>
              </div>
            )}
          </div>

          <!-- Pieza gráfica: tarjeta inclinada a la derecha -->
          {s.image && (
            <div class="slide-visual">
              <div class="slide-card">
                <img
                  src={s.image}
                  alt={s.imageAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  ))}

  <!-- ── Flechas laterales ── -->
  <button class="slider-arrow slider-arrow--prev" type="button" aria-label="Slide anterior">
    <Icon name="tabler:chevron-left" class="w-6 h-6" aria-hidden="true" />
  </button>
  <button class="slider-arrow slider-arrow--next" type="button" aria-label="Slide siguiente">
    <Icon name="tabler:chevron-right" class="w-6 h-6" aria-hidden="true" />
  </button>

  <!-- ── Dot Navigation ── -->
  <div class="slider-dots" role="tablist" aria-label="Slides">
    {slides.map((_, i) => (
      <button
        class={`slider-dot${i === 0 ? ' active' : ''}`}
        data-index={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Ir al slide ${i + 1}`}
      />
    ))}
  </div>

</section>

<!-- ── Stats Bar ── -->
<div class="hero-stats-bar">
  <div class="stats-container max-w-7xl mx-auto px-3 sm:px-6 md:px-10 lg:px-16">
    <div class="grid grid-cols-2 md:grid-cols-4">
      <div class="stat-cell">
        <div class="stat-num">+420</div>
        <div class="stat-lbl">Asociados activos</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">+12</div>
        <div class="stat-lbl">Convenios activos</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">98.2%</div>
        <div class="stat-lbl">Tasa de satisfacción</div>
      </div>
      <div class="stat-cell">
        <div class="stat-num">+33</div>
        <div class="stat-lbl">Años de trayectoria</div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Keyframe Animations ── */
  @keyframes slideInUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(36px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  /* ── Slider Container ── */
  .hero-slider {
    position: relative;
    height: 736px;
    background: #172B36;
    overflow: hidden;
    /* El selector global `section { padding: ... }` (global.css) aplicaría
       aquí también; el hero necesita ir a todo el ancho/alto sin ese
       padding, tanto en desktop como en el layout apilado de mobile/tablet. */
    padding: 0;
  }
  @media (max-width: 1023px) {
    .hero-slider { height: auto; }
  }

  /* ── Slides ── */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
    z-index: 0;
    overflow: hidden;
  }
  .slide.is-active {
    opacity: 1;
    pointer-events: all;
    z-index: 1;
  }

  /* ── Marca de agua: isotipo del favicon en blanco, gigante y sutil ── */
  .hero-watermark {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hero-watermark img {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%) rotate(-10deg);
    height: 150%;
    width: auto;
    /* El SVG trae sus propios colores; esto lo aplana a blanco puro */
    filter: brightness(0) invert(1);
    opacity: 0.045;
  }

  /* ── Slide Grid Layout: texto a la izquierda, tarjeta a la derecha ── */
  .slide-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 2rem 0 4rem;
    height: 100%;
  }
  /* Columna de texto: mismo ancho en todas las slides */
  .slide-content {
    width: 60%;
    max-width: 800px;
    flex-shrink: 0;
  }

  /* ── Pieza gráfica como tarjeta inclinada ── */
  .slide-visual {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .slide-card {
    position: relative;
    transform: rotate(3.5deg);
  }
  /* Marco fantasma detrás, inclinado al lado contrario */
  .slide-card::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: rotate(-6deg);
    border-radius: 1.25rem;
    background: rgba(255, 200, 1, 0.14);
  }
  .slide-card img {
    position: relative;
    display: block;
    max-height: 520px;
    max-width: 100%;
    width: auto;
    height: auto;
    border-radius: 1.25rem;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  /* ── Slide Content Animations (only when active) ── */
  .slide.is-active .slide-visual  { animation: slideInRight 0.65s ease 0.15s both; }
  .slide.is-active .slide-h1      { animation: slideInUp 0.55s ease 0.25s both; }
  .slide.is-active .slide-lead    { animation: slideInUp 0.5s ease 0.35s both; }
  .slide.is-active .slide-ctas    { animation: slideInUp 0.5s ease 0.45s both; }

  /* ── Heading ── */
  .slide-h1 {
    font-size: clamp(2.7rem, 4.2vw, 3.9rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 1.5rem;
    /* Si una línea no cabe, se parte en líneas equilibradas —
       nunca una palabra suelta ocupando una línea entera */
    text-wrap: balance;
  }

  /* ── Lead ── */
  .slide-lead {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.75;
    max-width: 460px;
    margin-bottom: 2.5rem;
  }

  /* ── CTAs ── */
  .slide-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  /* ── Flechas laterales ── */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .slider-arrow:hover {
    background: #FFC801;
    color: #172B36;
    border-color: transparent;
  }
  .slider-arrow--prev { left: 1.25rem; }
  .slider-arrow--next { right: 1.25rem; }

  /* ── Dot Navigation ── */
  .slider-dots {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: background 0.2s, width 0.3s, border-radius 0.3s;
    padding: 0;
  }
  .slider-dot.active {
    width: 28px;
    border-radius: 4px;
    background: #FFC801;
  }

  /* ── Stats Bar ── */
  /* Continuación visual del hero: mismo fondo, sin líneas */
  .hero-stats-bar {
    background: #172B36;
    position: relative;
    z-index: 5;
  }
  .stat-cell {
    padding: 1.5rem 2rem;
    text-align: center;
  }
  .stat-num {
    font-family: 'DM Sans', var(--ff-sans);
    font-size: 1.875rem;
    font-weight: 800;
    color: #FFC801;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-lbl {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.3rem;
    font-weight: 500;
  }

  /* ── Responsive: tablet + mobile ──
     El carrusel deja de usar posicionamiento absoluto/superpuesto: cada
     slide fluye en el documento (imagen arriba, texto abajo) y solo el
     slide activo ocupa espacio. Así el alto se ajusta al contenido real
     en vez de depender de paddings calculados a mano. */
  @media (max-width: 1023px) {
    .stat-cell { padding: 1.25rem 1rem; }
    .stat-num  { font-size: 1.5rem; }
    .stat-lbl  { font-size: 0.75rem; }

    .slide {
      position: static;
      display: none;
      flex-direction: column;
      opacity: 1;
      pointer-events: auto;
    }
    .slide.is-active { display: flex; }

    /* Contenido: en flujo normal, texto arriba y tarjeta debajo */
    .slide-grid { display: block; height: auto; padding: 2.5rem 0 3rem; }
    .slide-content { width: 100%; max-width: 100%; }

    /* Tarjeta inclinada: centrada bajo el texto, más pequeña */
    .slide-visual { margin-top: 2.5rem; }
    .slide-card { transform: rotate(2.5deg); }
    .slide-card img { max-height: 380px; }

    .slider-arrow { width: 38px; height: 38px; }
    .slider-arrow--prev { left: 0.75rem; }
    .slider-arrow--next { right: 0.75rem; }
  }

  @media (max-width: 639px) {
    .slider-dots { display: none; } /* Navegación por swipe en móvil */
    .slider-arrow { display: none; }

    .slide-grid { padding: 1.75rem 0 2.5rem; }

    .slide-h1 { font-size: 1.9rem; line-height: 1.1; margin-bottom: 0.875rem; text-align: center; }
    .slide-lead { font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem; color: rgba(255, 255, 255, 0.85); text-align: center; margin-left: auto; margin-right: auto; }
    .slide-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .slide-ctas .btn {
      width: 100%;
      justify-content: center;
      padding: 0.875rem 1.5rem;
      font-size: 0.9375rem;
      border-radius: 9999px;
    }
    .slide-visual { margin-top: 2rem; }
    .slide-card img { max-height: 320px; }

    .stat-cell { padding: 1.25rem 0.5rem; }
    .stat-num { font-size: 1.375rem; }
    .stat-lbl { font-size: 0.7rem; line-height: 1.2; }
  }
</style>

<script>
  const slides  = document.querySelectorAll<HTMLElement>('.slide');
  const dots    = document.querySelectorAll<HTMLElement>('.slider-dot');
  const slider  = document.getElementById('heroSlider');

  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  let paused  = false;

  function activateSlide(n: number) {
    // Remove active from current
    slides[current].classList.remove('is-active');
    slides[current].setAttribute('aria-hidden', 'true');
    if (dots.length > 0) {
      dots[current].classList.remove('active');
      dots[current].setAttribute('aria-selected', 'false');
    }

    // Set new current
    current = (n + slides.length) % slides.length;

    slides[current].classList.add('is-active');
    slides[current].setAttribute('aria-hidden', 'false');
    if (dots.length > 0) {
      dots[current].classList.add('active');
      dots[current].setAttribute('aria-selected', 'true');
    }

    // Resetear timer
    resetTimer();
  }

  function next() { activateSlide(current + 1); }
  function prev() { activateSlide(current - 1); }

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(() => { if (!paused) next(); }, 6000);
  }

  // Init
  timer = setInterval(() => { if (!paused) next(); }, 6000);

  // Dots
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { activateSlide(i); });
  });

  // Flechas laterales
  document.querySelector('.slider-arrow--prev')?.addEventListener('click', () => { prev(); });
  document.querySelector('.slider-arrow--next')?.addEventListener('click', () => { next(); });

  // Pause on hover (solo en desktop)
  if (window.innerWidth > 1023) {
    slider?.addEventListener('mouseenter', () => { paused = true; });
    slider?.addEventListener('mouseleave', () => { paused = false; });
  }

  // Touch/swipe support
  let touchStartX = 0;
  slider?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  slider?.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) { next(); } else { prev(); }
      resetTimer();
    }
  }, { passive: true });
</script>
