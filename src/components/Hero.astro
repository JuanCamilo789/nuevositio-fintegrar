---
import { Icon } from 'astro-icon/components';

const slides = [
  {
    id: 'slide-0',
    subtitle: 'BIENESTAR PARA USTED Y SU FAMILIA',
    heading: 'Cuidamos a su familia<br>en los momentos <span class="text-accent">que importan</span>',
    lead: 'Convenios exclusivos en salud, educación, turismo y más. Beneficios diseñados para mejorar su calidad de vida.',
    cta1: { label: 'Explorar beneficios', icon: 'tabler:heart', href: '/nosotros#auxilios', primary: true },
    cta2: { label: 'Ver convenios', icon: 'tabler:building-store', href: '/nosotros#convenios', primary: false },
    bgImage: '/assets/img/banner1.png',
  },
  {
    id: 'slide-alivio',
    subtitle: 'ALIVIO FINANCIERO',
    heading: '¿Se atrasó con sus cuotas?<br><span class="text-accent">Pongámonos al día</span>',
    lead: 'Comuníquese con nosotros para evaluar su caso y diseñar un plan de pagos personalizado que se ajuste a su capacidad financiera actual, con total confidencialidad.',
    cta1: { label: 'Hablemos ahora', icon: 'tabler:phone', href: 'tel:+573054070612', primary: true },
    cta2: { label: 'Escribir por correo', icon: 'tabler:mail', href: 'mailto:creditos@cooperamigo.coop', primary: false },
    bgImage: '/assets/img/banner3.png',
  },
  {
    id: 'slide-1',
    subtitle: 'SOLUCIONES FINANCIERAS',
    heading: 'Donde su esfuerzo<br>se convierte en <span class="text-accent">bienestar</span>',
    lead: 'Más de 30 años brindando soluciones financieras confiables a nuestros asociados.',
    cta1: { label: 'Acceso al Portal', icon: 'tabler:layout-dashboard', href: 'https://serviciosdigitales.cooperamigo.coop/', primary: true },
    cta2: { label: 'Conózcanos', icon: 'tabler:arrow-right', href: '/nosotros', primary: false },
    bgImage: '/assets/img/banner2.png',
  },
  {
    id: 'slide-2',
    subtitle: 'CRÉDITO FÁCIL',
    heading: 'Crédito ágil, condiciones<br>que se adaptan a usted',
    lead: 'Soluciones de crédito para cada etapa de su vida. Crédito ordinario, educativo y nuevas opciones diseñadas para acompañar sus proyectos.',
    cta1: { label: 'Líneas de crédito', icon: 'tabler:credit-card', href: '/creditos', primary: true },
    cta2: { label: 'Simular crédito', icon: 'tabler:calculator', href: '/creditos#simulador', primary: false },
    bgImage: '/assets/img/banner4.png',
  },
];
---

<section id="heroSlider" class="hero-slider relative w-full bg-slate-100 overflow-hidden" aria-label="Presentación Cooperamigó" data-hide-badge>

  <!-- Slides -->
  {slides.map((s, i) => (
    <div
      class={`slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-1000 ${i === 0 ? 'is-active' : ''}`}
      id={s.id}
      aria-hidden={i !== 0 ? 'true' : 'false'}
    >
      <!-- Background Image -->
      <img
        src={s.bgImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
      />
      
      <!-- Tinted + Gradient Overlay for Text Readability and Brand Consistency -->
      <div class="absolute inset-0 bg-[#172B36]/10 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#FFC801] via-[#FFC801]/85 to-transparent"></div>

      <!-- Slide Content Container -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pb-14 sm:pb-16 h-full flex flex-col items-center sm:items-start justify-center min-w-0">

        <div class="max-w-2xl w-full min-w-0 text-center sm:text-left flex flex-col items-center sm:items-start">

          <h1 class="slide-title text-4xl md:text-5xl lg:text-[4rem] font-extrabold text-[#172B36] leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 0.3s; animation-fill-mode: both;" set:html={s.heading} />

          <p class="slide-lead text-lg md:text-xl text-slate-600 mb-8 max-w-xl animate-fade-in-up" style="animation-delay: 0.4s; animation-fill-mode: both;">
            {s.lead}
          </p>

          {(s.cta1 || s.cta2) && (
            <div class="slide-ctas flex flex-wrap items-center justify-center sm:justify-start gap-4 animate-fade-in-up" style="animation-delay: 0.5s; animation-fill-mode: both;">
              {s.cta1 && (
                <a href={s.cta1.href} class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-colors ${s.cta1.primary ? 'bg-[#172B36] text-white hover:bg-[#1a3341] shadow-lg hover:shadow-xl' : 'bg-white text-[#172B36] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                  {s.cta1.icon && <Icon name={s.cta1.icon} class="w-5 h-5" />}
                  {s.cta1.label}
                </a>
              )}
              {s.cta2 && (
                <a href={s.cta2.href} class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm sm:px-7 sm:py-3.5 sm:text-base rounded-full font-semibold transition-colors ${s.cta2.primary ? 'bg-[#172B36] text-white hover:bg-[#1a3341] shadow-lg hover:shadow-xl' : 'bg-white text-[#172B36] hover:bg-slate-50 shadow-md border border-slate-100'}`}>
                  {s.cta2.label}
                  {s.cta2.icon && <Icon name={s.cta2.icon} class="w-5 h-5" />}
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  ))}

  <!-- Arrows -->
  <button class="slider-arrow slider-arrow--prev absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/80 hover:bg-white hidden lg:flex items-center justify-center text-[#172B36] shadow-lg transition-all z-20 backdrop-blur-sm" aria-label="Slide anterior">
    <Icon name="tabler:chevron-left" class="w-6 h-6" />
  </button>
  <button class="slider-arrow slider-arrow--next absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/80 hover:bg-white hidden lg:flex items-center justify-center text-[#172B36] shadow-lg transition-all z-20 backdrop-blur-sm" aria-label="Slide siguiente">
    <Icon name="tabler:chevron-right" class="w-6 h-6" />
  </button>

  <!-- Dots -->
  <div class="slider-dots hidden sm:flex absolute bottom-24 left-1/2 -translate-x-1/2 gap-2.5 z-20">
    {slides.map((_, i) => (
      <button class={`slider-dot w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-[#FFC801] w-8' : 'bg-black/10 hover:bg-black/30 shadow-sm'}`} data-index={i} aria-label={`Slide ${i + 1}`} />
    ))}
  </div>
</section>

<!-- Stats Bar -->
<div class="relative z-30 max-w-[85rem] mx-auto px-4 sm:px-6 md:px-10 -mt-14 sm:-mt-16 mb-12">
  <div class="bg-white rounded-lg shadow-2xl shadow-slate-200/50 overflow-hidden border border-slate-100">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-slate-100">
      <div class="p-3 sm:p-6 md:p-8 flex items-center justify-center gap-2 sm:gap-4 hover:bg-slate-50 transition-colors">
        <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
          <Icon name="tabler:users" class="w-4 h-4 sm:w-6 sm:h-6" />
        </div>
        <div class="text-left">
          <div class="stat-num text-lg sm:text-2xl md:text-3xl font-extrabold text-[#172B36]">+420</div>
          <div class="text-[0.65rem] sm:text-xs font-normal text-slate-500">Asociados activos</div>
        </div>
      </div>
      <div class="p-3 sm:p-6 md:p-8 flex items-center justify-center gap-2 sm:gap-4 hover:bg-slate-50 transition-colors">
        <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
          <Icon name="tabler:heart-handshake" class="w-4 h-4 sm:w-6 sm:h-6" />
        </div>
        <div class="text-left">
          <div class="stat-num text-lg sm:text-2xl md:text-3xl font-extrabold text-[#172B36]">+12</div>
          <div class="text-[0.65rem] sm:text-xs font-normal text-slate-500">Convenios activos</div>
        </div>
      </div>
      <div class="p-3 sm:p-6 md:p-8 flex items-center justify-center gap-2 sm:gap-4 hover:bg-slate-50 transition-colors">
        <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
          <Icon name="tabler:mood-happy" class="w-4 h-4 sm:w-6 sm:h-6" />
        </div>
        <div class="text-left">
          <div class="stat-num text-lg sm:text-2xl md:text-3xl font-extrabold text-[#172B36]">98.2%</div>
          <div class="text-[0.65rem] sm:text-xs font-normal text-slate-500">Tasa de satisfacción</div>
        </div>
      </div>
      <div class="p-3 sm:p-6 md:p-8 flex items-center justify-center gap-2 sm:gap-4 hover:bg-slate-50 transition-colors">
        <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
          <Icon name="tabler:trending-up" class="w-4 h-4 sm:w-6 sm:h-6" />
        </div>
        <div class="text-left">
          <div class="stat-num text-lg sm:text-2xl md:text-3xl font-extrabold text-[#172B36]">+33</div>
          <div class="text-[0.65rem] sm:text-xs font-normal text-slate-500">Años de trayectoria</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-slider {
    height: 560px;
    min-height: 65vh;
  }
  @media (max-width: 768px) {
    .hero-slider {
      height: 520px;
      min-height: auto;
    }
  }

  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 10;
  }

  .stat-num {
    font-family: var(--ff-sans);
  }

  .slide-title,
  .slide-lead {
    font-family: var(--ff-heading);
  }

  .slide-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }

  .slide-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
  }

  /* Custom utility classes */
  .text-accent {
    color: #FFC801;
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }
  
  .animate-fade-in-up {
    animation-name: fadeInUp;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .animate-fade-in-left {
    animation-name: fadeInLeft;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* Retrigger animations when slide becomes active */
  .slide:not(.is-active) .animate-fade-in-up,
  .slide:not(.is-active) .animate-fade-in-left {
    animation: none;
    opacity: 0;
  }
</style>

<script>
  function initSlider() {
    const slides = document.querySelectorAll<HTMLElement>('.slide');
    const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
    const slider = document.getElementById('heroSlider');
    
    if (!slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    let paused = false;

    function activateSlide(n: number) {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      if (dots.length) {
        dots[current].classList.remove('bg-[#FFC801]', 'w-8');
        dots[current].classList.add('bg-white/50');
      }

      current = (n + slides.length) % slides.length;

      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');
      if (dots.length) {
        dots[current].classList.remove('bg-white/50');
        dots[current].classList.add('bg-[#FFC801]', 'w-8');
      }

      resetTimer();
    }

    function next() { activateSlide(current + 1); }
    function prev() { activateSlide(current - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => { if (!paused) next(); }, 6000);
    }

    resetTimer();

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => activateSlide(i));
    });

    document.querySelector('.slider-arrow--prev')?.addEventListener('click', prev);
    document.querySelector('.slider-arrow--next')?.addEventListener('click', next);

    if (window.innerWidth > 1023 && slider) {
      slider.addEventListener('mouseenter', () => paused = true);
      slider.addEventListener('mouseleave', () => paused = false);
    }

    let touchStartX = 0;
    slider?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    slider?.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) next();
        else prev();
        resetTimer();
      }
    }, { passive: true });
  }

  initSlider();
  document.addEventListener('astro:after-swap', initSlider);
</script>
