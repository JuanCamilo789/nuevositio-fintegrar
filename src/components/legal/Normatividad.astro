---
import { Icon } from 'astro-icon/components';

interface Doc {
  id:          string;
  titulo:      string;
  descripcion: string;
  categoria:   string;
  tipo:        string;
  url:         string | null;
  fecha:       string;
}

interface Props { docs: Doc[]; }

const { docs } = Astro.props;

const categorias = [...new Set(docs.map(d => d.categoria))];

function formatFecha(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${dd}/${mm}/${d.getFullYear()}`;
}
---

<section class="norm-section" aria-labelledby="norm-title">
  <div class="max-w-7xl mx-auto px-6">

    {docs.length === 0 ? (
      <div class="norm-empty reveal">
        <Icon name="tabler:file-upload" class="w-12 h-12" aria-hidden="true" />
        <h3 class="norm-empty-title">Aún no hemos cargado documentos aquí</h3>
        <p class="norm-empty-text">
          Estamos organizando esta sección para que encuentres pronto lo que necesitas. Vuelve a visitarnos en unos días.
        </p>
      </div>
    ) : (
      <div class="norm-layout">
        <aside class="norm-sidebar reveal">
          <nav class="norm-sidebar-nav" role="group" aria-label="Filtrar documentos">
            <button class="norm-sidebar-link is-active" data-cat="Todos">
              <Icon name="tabler:apps" class="w-4 h-4" aria-hidden="true" />
              Todos
            </button>
            {categorias.map((cat) => (
              <button class="norm-sidebar-link" data-cat={cat}>
                <Icon name="tabler:folder" class="w-4 h-4" aria-hidden="true" />
                {cat}
              </button>
            ))}
          </nav>
        </aside>

        <div class="norm-panel reveal" id="normGrid">
          {docs.map((doc) => (
            <button
              class="norm-doc-row"
              data-cat={doc.categoria}
              data-doc-id={doc.id}
              data-doc-titulo={doc.titulo}
              data-doc-desc={doc.descripcion}
              data-doc-fecha={formatFecha(doc.fecha)}
              data-doc-url={doc.url ?? ''}
              aria-label={`Ver documento: ${doc.titulo}`}
            >
              <div class="norm-doc-info">
                <span class="norm-doc-cat">{doc.categoria}</span>
                <h3 class="norm-doc-titulo">{doc.titulo}</h3>
                <p class="norm-doc-desc">{doc.descripcion}</p>
              </div>
              <span class="norm-doc-fecha">{formatFecha(doc.fecha)}</span>
              <span class="norm-doc-action" aria-hidden="true">
                <Icon name="tabler:file-text" class="w-4 h-4" />
              </span>
            </button>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<div class="norm-modal" id="normModal" role="dialog" aria-modal="true" aria-label="Documento" hidden>
  <div class="norm-modal-backdrop" id="normModalBackdrop"></div>
  <div class="norm-modal-box">

    <h2 class="sr-only" id="modalTitle"></h2>
    <button class="norm-modal-close" id="normModalClose" aria-label="Cerrar">
      <Icon name="tabler:x" class="w-5 h-5" aria-hidden="true" />
    </button>

    <div class="norm-modal-body" id="normModalBody">
      <div class="norm-modal-loading" id="normModalLoading" hidden>
        <div class="norm-modal-spinner" aria-hidden="true"></div>
        <span>Cargando documento...</span>
      </div>
      <iframe id="normModalFrame" class="norm-modal-frame" title="Documento" hidden></iframe>
      <div class="norm-modal-placeholder" id="normModalPlaceholder">
        <Icon name="tabler:file-upload" class="w-12 h-12" aria-hidden="true" />
        <p id="normModalPlaceholderMsg">Documento pendiente de carga</p>
        <span id="normModalPlaceholderSub">El archivo estará disponible próximamente.</span>
      </div>
    </div>

  </div>
</div>

<style>
  .norm-section { background:var(--color-navbar-bg); padding:4rem 0 5rem; }

  .norm-layout { display:flex; align-items:flex-start; gap:2.5rem; }

  .norm-empty {
    display:flex; flex-direction:column; align-items:center; text-align:center;
    gap:0.875rem;
    padding:4rem 2rem;
    color:var(--color-ink);
  }
  .norm-empty svg { opacity:0.35; }
  .norm-empty-title { font-size:1.125rem; font-weight: var(--fw-bold); }
  .norm-empty-text { font-size:0.9375rem; opacity:0.65; line-height: var(--lh-160); max-width:28rem; }

  .norm-sidebar { flex-shrink:0; width:15rem; position:sticky; top:6rem; }
  .norm-sidebar-nav { display:flex; flex-direction:column; gap:0.25rem; }
  .norm-sidebar-link {
    display:flex; align-items:center; gap:0.625rem;
    text-align:left;
    background:none; border:none; cursor:pointer;
    padding:0.625rem 0.875rem;
    border-radius:var(--radius-sm);
    font-size:0.875rem;
    font-weight: var(--fw-semibold);
    color:var(--color-ink);
    opacity:0.65;
    transition:background 0.15s, color 0.15s, opacity 0.15s;
  }
  .norm-sidebar-link svg { flex-shrink:0; opacity:0.7; }
  .norm-sidebar-link.is-active svg { opacity:1; }
  .norm-sidebar-link:hover { background:var(--color-white); opacity:1; }
  .norm-sidebar-link.is-active { background:var(--color-white); color:var(--color-brand-purple); opacity:1; box-shadow:var(--shadow-sm); }

  .norm-panel {
    flex:1;
    min-width:0;
    background:var(--color-white);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow-sm);
    padding:0 2rem;
    overflow:hidden;
  }

  .norm-doc-row {
    display:flex;
    align-items:center;
    gap:1.25rem;
    width:calc(100% + 4rem);
    margin:0 -2rem;
    text-align:left;
    background:none;
    border:none;
    border-radius:var(--radius-sm);
    cursor:pointer;
    padding:1.25rem 2rem;
    transition: background 0.15s;
  }

  .norm-panel .norm-doc-row + .norm-doc-row { border-top:1px solid var(--color-surface); }

  .norm-doc-row:hover { background: var(--color-surface); }


  .norm-doc-row.is-hidden { display:none; }

  .norm-doc-info { flex:1; min-width:0; }
  .norm-doc-cat { display:block; font-size:0.7rem; font-weight: var(--fw-bold); color:var(--color-brand-purple); line-height: var(--lh-120); margin-bottom:0.25rem; }
  .norm-doc-titulo { font-size:0.9375rem; font-weight: var(--fw-bold); color:var(--color-ink); line-height: var(--lh-130); }
  .norm-doc-desc { font-size:0.8125rem; color:var(--color-ink); opacity:0.6; line-height: var(--lh-140); margin-top:0.25rem; }

  .norm-doc-fecha { display:inline-flex; align-items:center; gap:0.375rem; font-size:0.75rem; color:var(--color-ink); opacity:0.6; font-weight: var(--fw-medium); white-space:nowrap; flex-shrink:0; }
  .norm-doc-action { display:inline-flex; align-items:center; justify-content:center; color:var(--color-ink); opacity:0.5; flex-shrink:0; transition: opacity .2s; }
  .norm-doc-row:hover .norm-doc-action { opacity:1; }

  .norm-modal { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:1rem; }
  .norm-modal[hidden] { display:none; }
  .norm-modal-backdrop { position:absolute; inset:0; background:rgba(var(--color-navy-rgb), .7); backdrop-filter:blur(4px); }
  .norm-modal-box {
    position:relative; z-index:1; background:var(--color-white); border-radius:var(--radius-lg);
    width:min(92vw, 960px);
    height:88vh;
    display:flex; flex-direction:column; overflow:hidden;
    box-shadow:0 32px 80px rgba(var(--color-navy-rgb), .35);
    animation:modalIn .25s ease both;
  }
  @keyframes modalIn { from{opacity:0;transform:translateY(20px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
  .norm-modal-close {
    position:absolute; top:0.875rem; right:0.875rem; z-index:2;
    width:36px; height:36px; border-radius:50%;
    background:var(--color-white); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0; color:var(--color-ink); opacity:.75;
    box-shadow:var(--shadow-sm);
    transition:opacity .15s;
  }
  .norm-modal-close:hover { opacity:1; }
  .norm-modal-body { flex:1; min-height:0; overflow:hidden; display:block; }
  .norm-modal-frame { width:100%; border:none; display:block; }
  .norm-modal-loading { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.875rem; color:var(--color-ink); opacity:0.45; font-size:0.8125rem; font-weight: var(--fw-medium); }
  .norm-modal-loading[hidden] { display:none; }
  .norm-modal-spinner { width:32px; height:32px; border:3px solid rgba(var(--color-navy-rgb), .15); border-top-color:var(--color-ink); border-radius:50%; animation:normSpin .7s linear infinite; }
  @keyframes normSpin { to { transform:rotate(360deg) } }
  .norm-modal-placeholder { width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.75rem; color:var(--color-ink); opacity:.4; text-align:center; padding:2rem; }
  .norm-modal-placeholder[hidden] { display:none; }
  .norm-modal-placeholder p { font-size:1rem; font-weight: var(--fw-semibold); }
  .norm-modal-placeholder span { font-size:0.8125rem; }

  @media(max-width:1023px){
    .norm-section{ padding:3rem 0 4rem }
    .norm-modal-box{ width:min(96vw, 760px); height:88vh; }
    .norm-layout { flex-direction:column; gap:1.5rem; }
    .norm-sidebar { position:static; width:100%; }
    .norm-sidebar-nav { flex-direction:row; flex-wrap:wrap; gap:0.5rem; }
    .norm-sidebar-link { border-radius:var(--radius-full); }
  }
  @media(max-width:639px){
    .norm-section{ padding:2rem 0 3rem }
    .norm-panel { padding:0 1.25rem; }
    .norm-doc-row { flex-wrap:wrap; width:calc(100% + 2.5rem); margin:0 -1.25rem; padding:1.25rem; }
    .norm-modal { padding:0; align-items:flex-end; }
    .norm-modal-box {
      width:100%; height:92vh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      animation:modalInMobile .3s cubic-bezier(0.32,0.72,0,1) both;
    }
    @keyframes modalInMobile { from{opacity:0;transform:translateY(100%)} to{opacity:1;transform:translateY(0)} }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>('.norm-doc-row');

  const sidebarLinks = document.querySelectorAll<HTMLButtonElement>('.norm-sidebar-link');
  sidebarLinks.forEach(btn => {
    btn.addEventListener('click', () => {
      sidebarLinks.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const cat = btn.dataset.cat ?? 'Todos';
      cards.forEach(card => card.classList.toggle('is-hidden', cat !== 'Todos' && card.dataset.cat !== cat));
    });
  });

  const modal          = document.getElementById('normModal')!;
  const backdrop       = document.getElementById('normModalBackdrop')!;
  const closeBtn       = document.getElementById('normModalClose')!;
  const body           = document.getElementById('normModalBody')!;
  const placeholder    = document.getElementById('normModalPlaceholder')!;
  const placeholderMsg = document.getElementById('normModalPlaceholderMsg')!;
  const placeholderSub = document.getElementById('normModalPlaceholderSub')!;
  const loadingEl      = document.getElementById('normModalLoading')!;
  const modalTitle     = document.getElementById('modalTitle')!;

  function showLoading() {
    loadingEl.hidden = false;
    placeholder.hidden = true;
  }

  function showPlaceholder(msg: string, sub: string) {
    loadingEl.hidden = true;
    placeholderMsg.textContent = msg;
    placeholderSub.textContent = sub;
    placeholder.hidden = false;
  }

  function mountFreshFrame(): HTMLIFrameElement {
    const existing = document.getElementById('normModalFrame');
    if (existing) existing.remove();

    const fresh = document.createElement('iframe');
    fresh.id = 'normModalFrame';
    fresh.className = 'norm-modal-frame';
    fresh.title = 'Documento';
    fresh.style.display = 'none';
    body.insertBefore(fresh, placeholder);
    return fresh;
  }

  function openModal(card: HTMLButtonElement) {
    const { docTitulo, docUrl, docFecha, cat } = card.dataset as Record<string,string>;
    modalTitle.textContent = docTitulo ?? '';

    let resolvedUrl = '';
    if (docUrl) {
      try {
        resolvedUrl = /^https?:\/\//i.test(docUrl)
          ? docUrl
          : new URL(docUrl, window.location.origin).toString();
      } catch {
        resolvedUrl = '';
      }
    }

    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();

    if (resolvedUrl) {
      const frame = mountFreshFrame();
      showLoading();

      // Asignar altura real del body al iframe una vez el modal está visible
      requestAnimationFrame(() => {
        const h = body.clientHeight;
        frame.style.width = '100%';
        frame.style.height = h + 'px';
      });

      let loadTimer: ReturnType<typeof setTimeout> | null = setTimeout(() => {
        loadTimer = null;
        if (!frame.isConnected) return;
        frame.style.display = 'none';
        showPlaceholder(
          'No se pudo mostrar el documento',
          'El archivo puede tener restricciones de visualización en línea.'
        );
      }, 8000);

      frame.addEventListener('load', () => {
        if (loadTimer) {
          clearTimeout(loadTimer);
          loadTimer = null;
        }
        if (!frame.isConnected || !frame.src) return;
        loadingEl.hidden = true;
        frame.style.display = 'block';
      }, { once: true });

      frame.src = resolvedUrl;
    } else {
      mountFreshFrame();
      showPlaceholder(
        'Documento pendiente de carga',
        'El archivo estará disponible próximamente.'
      );
    }
  }

  function closeModal() {
    modal.setAttribute('hidden', '');
    document.body.style.overflow = '';
    const frame = document.getElementById('normModalFrame') as HTMLIFrameElement | null;
    if (frame) frame.remove();
  }

  cards.forEach(card => card.addEventListener('click', () => openModal(card)));
  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal(); });
</script>
