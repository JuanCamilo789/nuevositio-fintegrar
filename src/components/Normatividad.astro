---
import { Icon } from 'astro-icon/components';

interface Doc {
  id:          string;
  titulo:      string;
  descripcion: string;
  categoria:   string;
  tipo:        string;
  url:         string | null;
  fecha:       string;
}

interface Props { docs: Doc[]; }

const { docs } = Astro.props;

const categorias = ['Todos', ...new Set(docs.map(d => d.categoria))];

function formatFecha(dateStr: string): string {
  const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getDate()} de ${meses[d.getMonth()]}, ${d.getFullYear()}`;
}
---

<!-- ════════════════════════════════════
     NORMATIVIDAD — DOCUMENTOS
════════════════════════════════════ -->
<section class="norm-section" aria-labelledby="norm-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="norm-header reveal">
      <div>
        <div class="section-eyebrow">Transparencia institucional</div>
        <h2 id="norm-title" class="font-display norm-heading">
          Normatividad y documentos
        </h2>
        <p class="norm-intro">
          Consulte los documentos normativos, estatutos y reglamentos vigentes
          de la Cooperativa Multiactiva Luis Amigó.
        </p>
      </div>
    </div>

    <!-- Filtros -->
    <div class="norm-filters reveal" role="group" aria-label="Filtrar documentos">
      {categorias.map((cat) => (
        <button
          class={`norm-filter-btn${cat === 'Todos' ? ' is-active' : ''}`}
          data-cat={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="norm-grid" id="normGrid">
      {docs.map((doc, i) => (
        <button
          class={`norm-card reveal${i > 0 ? ` reveal-delay-${Math.min(i % 3, 2)}` : ''}`}
          data-cat={doc.categoria}
          data-doc-id={doc.id}
          data-doc-titulo={doc.titulo}
          data-doc-desc={doc.descripcion}
          data-doc-fecha={formatFecha(doc.fecha)}
          data-doc-url={doc.url ?? ''}
          aria-label={`Ver documento: ${doc.titulo}`}
        >
          <div class="norm-card-icon">
            <Icon name="tabler:file-type-pdf" class="w-6 h-6" aria-hidden="true" />
          </div>
          <div class="norm-card-body">
            <span class="norm-card-cat">{doc.categoria}</span>
            <h3 class="norm-card-titulo">{doc.titulo}</h3>
            <p class="norm-card-desc">{doc.descripcion}</p>
          </div>
          <div class="norm-card-footer">
            <span class="norm-card-fecha">
              <Icon name="tabler:calendar-event" class="w-3.5 h-3.5" aria-hidden="true" />
              {formatFecha(doc.fecha)}
            </span>
            <span class="norm-card-action">
              Ver documento
              <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" aria-hidden="true" />
            </span>
          </div>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- ════════════════════════════════════
     MODAL
════════════════════════════════════ -->
<div class="norm-modal" id="normModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" hidden>
  <div class="norm-modal-backdrop" id="normModalBackdrop"></div>
  <div class="norm-modal-box">

    <div class="norm-modal-header">
      <div class="norm-modal-header-info">
        <h2 class="norm-modal-title" id="modalTitle"></h2>
      </div>
      <button class="norm-modal-close" id="normModalClose" aria-label="Cerrar">
        <Icon name="tabler:x" class="w-5 h-5" aria-hidden="true" />
      </button>
    </div>

    <div class="norm-modal-body" id="normModalBody">
      <div class="norm-modal-loading" id="normModalLoading" hidden>
        <div class="norm-modal-spinner" aria-hidden="true"></div>
        <span>Cargando documento...</span>
      </div>
      <iframe id="normModalFrame" class="norm-modal-frame" title="Documento" hidden></iframe>
      <div class="norm-modal-placeholder" id="normModalPlaceholder">
        <Icon name="tabler:file-upload" class="w-12 h-12" aria-hidden="true" />
        <p id="normModalPlaceholderMsg">Documento pendiente de carga</p>
        <span id="normModalPlaceholderSub">El archivo estará disponible próximamente.</span>
      </div>
    </div>

  </div>
</div>

<style>
  .norm-section { background:#fff; padding:4rem 0 5rem; }
  .norm-header { display:flex; align-items:flex-start; justify-content:space-between; gap:2rem; margin-bottom:2rem; flex-wrap:wrap; }
  .norm-heading { font-size:clamp(1.75rem,3vw,2.5rem); color:#172B36; line-height:1.2; margin-bottom:0.75rem; }
  .norm-intro { font-size:0.9375rem; color:#172B36; opacity:0.6; line-height:1.7; }
  .norm-filters { display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:2rem; }
  .norm-filter-btn { padding:0.45rem 1.1rem; border-radius:100px; font-size:0.8rem; font-weight:600; cursor:pointer; background:#F1F6F4; color:#172B36; opacity:0.6; border:none; transition:background 0.15s,color 0.15s,opacity 0.15s; }
  .norm-filter-btn:hover, .norm-filter-btn.is-active { background:#172B36; color:#fff; opacity:1; }
  .norm-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
  .norm-card { background:#F1F6F4; border-radius:16px; padding:1.5rem; display:flex; flex-direction:column; gap:1rem; text-align:left; cursor:pointer; box-shadow:0 1px 4px rgba(23,43,54,.06); transition:box-shadow .2s,transform .2s,background .15s; border:none; }
  .norm-card:hover { background:#fff; box-shadow:0 6px 20px rgba(23,43,54,.1); transform:translateY(-3px); }
  .norm-card.is-hidden { display:none; }
  .norm-card-icon { width:52px; height:52px; background:rgba(23,43,54,.08); border-radius:12px; display:flex; align-items:center; justify-content:center; color:#172B36; flex-shrink:0; }
  .norm-card-body { flex:1; }
  .norm-card-cat { font-size:0.68rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#172B36; opacity:0.8; display:block; margin-bottom:0.4rem; }
  .norm-card-titulo { font-size:0.9375rem; font-weight:700; color:#172B36; line-height:1.35; margin-bottom:0.5rem; }
  .norm-card-desc { font-size:0.8125rem; color:#172B36; opacity:0.6; line-height:1.6; }
  .norm-card-footer { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap; padding-top:0.75rem; border-top:1px solid rgba(23,43,54,.1); }
  .norm-card-fecha { display:inline-flex; align-items:center; gap:0.375rem; font-size:0.75rem; color:#172B36; opacity:0.6; font-weight:500; }
  .norm-card-action { display:inline-flex; align-items:center; gap:0.375rem; font-size:0.8rem; font-weight:600; color:#172B36; transition:gap .2s; }
  .norm-card:hover .norm-card-action { gap:0.625rem; }
  .norm-modal { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:1rem; }
  .norm-modal[hidden] { display:none; }
  .norm-modal-backdrop { position:absolute; inset:0; background:rgba(23,43,54,.7); backdrop-filter:blur(4px); }
  .norm-modal-box {
    position:relative; z-index:1; background:#fff; border-radius:20px;
    width:min(92vw, 960px);
    height:88vh;
    display:flex; flex-direction:column; overflow:hidden;
    box-shadow:0 32px 80px rgba(23,43,54,.35);
    animation:modalIn .25s ease both;
  }
  @keyframes modalIn { from{opacity:0;transform:translateY(20px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
  .norm-modal-header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.5rem; border-bottom:1px solid #F1F6F4; flex-shrink:0; }
  .norm-modal-header-info { display:flex; flex-direction:column; align-items:flex-start; gap:0.25rem; min-width:0; }
  .norm-modal-title { font-size:1rem; font-weight:700; color:#172B36; font-family:var(--ff-heading); line-height:1.3; }
  .norm-modal-close { width:36px; height:36px; border-radius:50%; background:#F1F6F4; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#172B36; opacity:.6; transition:opacity .15s; }
  .norm-modal-close:hover { opacity:1; }
  .norm-modal-body { flex:1; min-height:0; overflow:hidden; display:block; }
  .norm-modal-frame { width:100%; border:none; display:block; }
  .norm-modal-loading { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.875rem; color:#172B36; opacity:0.45; font-size:0.8125rem; font-weight:500; }
  .norm-modal-loading[hidden] { display:none; }
  .norm-modal-spinner { width:32px; height:32px; border:3px solid rgba(23,43,54,.15); border-top-color:#172B36; border-radius:50%; animation:normSpin .7s linear infinite; }
  @keyframes normSpin { to { transform:rotate(360deg) } }
  .norm-modal-placeholder { width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.75rem; color:#172B36; opacity:.4; text-align:center; padding:2rem; }
  .norm-modal-placeholder[hidden] { display:none; }
  .norm-modal-placeholder p { font-size:1rem; font-weight:600; }
  .norm-modal-placeholder span { font-size:0.8125rem; }

  @media(max-width:1023px){
    .norm-section{ padding:3rem 0 4rem }
    .norm-grid{ grid-template-columns:repeat(2,1fr) }
    .norm-modal-box{ width:min(96vw, 760px); height:88vh; }
  }
  @media(max-width:639px){
    .norm-section{ padding:2rem 0 3rem }
    .norm-grid{ grid-template-columns:1fr }
    .norm-header{ flex-direction:column }
    .norm-modal { padding:0; align-items:flex-end; }
    .norm-modal-box {
      width:100%; height:92vh;
      border-radius:20px 20px 0 0;
      animation:modalInMobile .3s cubic-bezier(0.32,0.72,0,1) both;
    }
    @keyframes modalInMobile { from{opacity:0;transform:translateY(100%)} to{opacity:1;transform:translateY(0)} }
    .norm-modal-header { padding:0.875rem 1.25rem; }
    .norm-modal-title { font-size:0.9375rem; }
    .norm-modal-footer { padding:0.625rem 1.25rem; flex-wrap:wrap; }
  }
</style>

<script>
  // ── Filtros ──
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.norm-filter-btn');
  const cards      = document.querySelectorAll<HTMLButtonElement>('.norm-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const cat = btn.dataset.cat ?? 'Todos';
      cards.forEach(card => card.classList.toggle('is-hidden', cat !== 'Todos' && card.dataset.cat !== cat));
    });
  });

  // ── Hash tab ──
  function activateHashFilter() {
    const hash = window.location.hash.slice(1).toLowerCase();
    if (!hash) return;
    const match = Array.from(filterBtns).find(b => (b.dataset.cat ?? '').toLowerCase() === hash);
    if (match) match.click();
  }
  activateHashFilter();
  window.addEventListener('hashchange', activateHashFilter);

  // ── Modal ──
  const modal          = document.getElementById('normModal')!;
  const backdrop       = document.getElementById('normModalBackdrop')!;
  const closeBtn       = document.getElementById('normModalClose')!;
  const body           = document.getElementById('normModalBody')!;
  const placeholder    = document.getElementById('normModalPlaceholder')!;
  const placeholderMsg = document.getElementById('normModalPlaceholderMsg')!;
  const placeholderSub = document.getElementById('normModalPlaceholderSub')!;
  const loadingEl      = document.getElementById('normModalLoading')!;
  const modalTitle     = document.getElementById('modalTitle')!;

  function showLoading() {
    loadingEl.hidden = false;
    placeholder.hidden = true;
  }

  function showPlaceholder(msg: string, sub: string) {
    loadingEl.hidden = true;
    placeholderMsg.textContent = msg;
    placeholderSub.textContent = sub;
    placeholder.hidden = false;
  }

  function mountFreshFrame(): HTMLIFrameElement {
    const existing = document.getElementById('normModalFrame');
    if (existing) existing.remove();

    const fresh = document.createElement('iframe');
    fresh.id = 'normModalFrame';
    fresh.className = 'norm-modal-frame';
    fresh.title = 'Documento';
    fresh.style.display = 'none';
    body.insertBefore(fresh, placeholder);
    return fresh;
  }

  function openModal(card: HTMLButtonElement) {
    const { docTitulo, docUrl, docFecha, cat } = card.dataset as Record<string,string>;
    modalTitle.textContent = docTitulo ?? '';

    let resolvedUrl = '';
    if (docUrl) {
      try {
        resolvedUrl = /^https?:\/\//i.test(docUrl)
          ? docUrl
          : new URL(docUrl, window.location.origin).toString();
      } catch {
        resolvedUrl = '';
      }
    }

    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();

    if (resolvedUrl) {
      const frame = mountFreshFrame();
      showLoading();

      // Asignar altura real del body al iframe una vez el modal está visible
      requestAnimationFrame(() => {
        const h = body.clientHeight;
        frame.style.width = '100%';
        frame.style.height = h + 'px';
      });

      let loadTimer: ReturnType<typeof setTimeout> | null = setTimeout(() => {
        loadTimer = null;
        if (!frame.isConnected) return;
        frame.style.display = 'none';
        showPlaceholder(
          'No se pudo mostrar el documento',
          'El archivo puede tener restricciones de visualización en línea.'
        );
      }, 8000);

      frame.addEventListener('load', () => {
        if (loadTimer) {
          clearTimeout(loadTimer);
          loadTimer = null;
        }
        if (!frame.isConnected || !frame.src) return;
        loadingEl.hidden = true;
        frame.style.display = 'block';
      }, { once: true });

      frame.src = resolvedUrl;
    } else {
      mountFreshFrame();
      showPlaceholder(
        'Documento pendiente de carga',
        'El archivo estará disponible próximamente.'
      );
    }
  }

  function closeModal() {
    modal.setAttribute('hidden', '');
    document.body.style.overflow = '';
    const frame = document.getElementById('normModalFrame') as HTMLIFrameElement | null;
    if (frame) frame.remove();
  }

  cards.forEach(card => card.addEventListener('click', () => openModal(card)));
  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal(); });
</script>
