---
import { Icon } from 'astro-icon/components';
import ConfianzaSeguridad from './ConfianzaSeguridad.astro';
---

<section class="db-slider-wrap w-full mt-0">

  <div class="db-slider relative w-full overflow-hidden bg-[var(--color-brand-purple)]" data-dark-bg aria-roledescription="carrusel" aria-label="Oportunidades y confianza FINTEGRAR">

  <div class="db-slider-track flex">

    <div class="db-slide w-full flex-shrink-0 py-14">
      <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 relative z-10">

        <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-16 items-center">

          <div class="flex flex-col space-y-8 lg:order-2">
            <h2 class="font-extrabold text-white leading-[1.1] tracking-normal">
              <span class="block text-4xl sm:text-5xl lg:text-[4rem] xl:text-[5rem] 2xl:text-[6.5rem]">Creamos</span>
              <span class="block text-4xl sm:text-5xl lg:text-[4rem] xl:text-[5rem] 2xl:text-[6.5rem]">Oportunidades</span>
            </h2>

            <p class="text-lg text-white/80 max-w-none leading-relaxed">
              En FINTEGRAR le abrimos camino con múltiples opciones de ahorro y crédito, pensadas para que cada oportunidad se convierta en bienestar para usted y su familia.
            </p>

          </div>

          <div class="relative w-full h-[300px] flex justify-center items-center lg:order-1">

            <div class="db-card db-card--1 absolute w-72 h-44 rounded-2xl shadow-xl p-5 text-white flex flex-col justify-between bg-gradient-to-br from-[var(--color-brand-purple)] to-[var(--color-purple-deep)] border border-white/20">
              <div class="flex justify-between items-start w-full">
                 <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
                   <Icon name="tabler:credit-card" class="w-5 h-5" />
                 </div>
              </div>
              <div>
                <div class="text-base font-bold tracking-wide mb-1 drop-shadow-sm">Créditos</div>
                <div class="text-[10px] uppercase tracking-wider text-white/80">Para cada meta</div>
              </div>
            </div>

            <div class="db-card db-card--2 absolute w-72 h-44 rounded-2xl shadow-2xl p-5 text-gray-800 flex flex-col justify-between bg-gradient-to-br from-[var(--color-teal-tint)] via-[var(--color-purple-tint)] to-[var(--color-indigo-tint)] border border-white/50">
              <div class="flex justify-between items-start w-full">
                 <div class="w-10 h-10 rounded-xl bg-white/60 flex items-center justify-center text-blue-900">
                   <Icon name="tabler:wallet" class="w-5 h-5" />
                 </div>
              </div>
              <div>
                <div class="text-base font-bold tracking-wide mb-1 text-gray-700">Ahorro</div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Crezca a su ritmo</div>
              </div>
            </div>

            <div class="db-card db-card--3 absolute w-72 h-44 rounded-2xl shadow-2xl p-5 text-white flex flex-col justify-between bg-gradient-to-br from-[var(--color-brand-gold)] to-[var(--color-gold-dark)]">
              <div class="flex justify-between items-start w-full">
                 <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                   <Icon name="tabler:building-store" class="w-5 h-5" />
                 </div>
              </div>
              <div>
                <div class="text-base font-bold tracking-wide mb-1 drop-shadow-sm">Convenios</div>
                <div class="text-[10px] uppercase tracking-wider text-white/80">Aliados que suman</div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

    <div class="db-slide w-full flex-shrink-0 py-14 flex items-center justify-center">
      <ConfianzaSeguridad transparent confianzaWhite />
    </div>

  </div>

  <div class="db-slider-dots flex items-center justify-center gap-2 pb-6" role="tablist" aria-label="Seleccionar slide">
    <button type="button" class="db-dot w-8 h-2 rounded-full bg-white transition-all" role="tab" aria-selected="true" aria-label="Slide 1"></button>
    <button type="button" class="db-dot w-2 h-2 rounded-full bg-white/50 transition-all" role="tab" aria-selected="false" aria-label="Slide 2"></button>
  </div>

  </div>
</section>

<style>
  .db-slider-wrap {
    background: var(--color-brand-purple);
  }

  .db-slider-track {
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .db-card {
    transform: var(--base);
    animation: dbFloat 6s ease-in-out infinite;
    will-change: transform;
  }
  .db-card--1 {
    z-index: 10;
    --base: translate(-39px, 45px) rotateX(30deg) rotateZ(-30deg);
    animation-delay: 0s;
  }
  .db-card--2 {
    z-index: 20;
    --base: translate(0px, 0px) rotateX(30deg) rotateZ(-30deg);
    animation-delay: 0.7s;
  }
  .db-card--3 {
    z-index: 30;
    --base: translate(39px, -45px) rotateX(30deg) rotateZ(-30deg);
    animation-delay: 1.4s;
  }

  @keyframes dbFloat {
    0%, 100% { transform: var(--base) translateY(0) translateZ(0); }
    50% { transform: var(--base) translateY(-18px) translateZ(30px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .db-card {
      animation: none;
    }
    .db-slider-track {
      transition: none;
    }
  }
</style>

<script>
  function initDbSlider() {
    const section = document.querySelector<HTMLElement>('.db-slider');
    const track = section?.querySelector<HTMLElement>('.db-slider-track');
    const slides = section?.querySelectorAll<HTMLElement>('.db-slide');
    const dots = section?.querySelectorAll<HTMLElement>('.db-dot');

    if (!section || !track || !slides || !slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    let paused = false;

    function activateSlide(n: number) {
      current = (n + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;

      dots?.forEach((dot, i) => {
        const active = i === current;
        dot.setAttribute('aria-selected', String(active));
        dot.classList.toggle('w-8', active);
        dot.classList.toggle('w-2', !active);
        dot.classList.toggle('bg-white', active);
        dot.classList.toggle('bg-white/50', !active);
      });

      resetTimer();
    }

    function next() { activateSlide(current + 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => { if (!paused) next(); }, 6000);
    }

    resetTimer();

    dots?.forEach((dot, i) => {
      dot.addEventListener('click', () => activateSlide(i));
    });

    if (window.innerWidth > 1023) {
      section.addEventListener('mouseenter', () => paused = true);
      section.addEventListener('mouseleave', () => paused = false);
    }

    let touchStartX = 0;
    section.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    section.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        activateSlide(current + (diff > 0 ? 1 : -1));
      }
    }, { passive: true });
  }

  initDbSlider();
  document.addEventListener('astro:after-swap', initDbSlider);
</script>
