---
import { Icon } from 'astro-icon/components';
import ConfianzaSeguridad from './ConfianzaSeguridad.astro';

const ANIO_ORIGEN = 1988;
const anioActual = new Date().getFullYear();
const aniosTrayectoria = anioActual - ANIO_ORIGEN;

const hitos = [
  {
    year: '1988',
    label: 'Origen',
    title: 'Nace la natillera',
    desc: 'Un grupo de empleados de la Cooperativa Consumo decidió conformar una natillera para ahorrar y tener acceso a créditos.',
  },
  {
    year: '2000',
    label: 'Impulso legal',
    title: 'Camino a la formalización',
    desc: 'La Gerencia de la Cooperativa Consumo motivó la organización legal del Fondo.',
  },
  {
    year: '2001',
    label: 'Personería Jurídica',
    title: 'Nace Feconsumo',
    desc: 'El Fondo recibió la Personería Jurídica de Feconsumo.',
  },
  {
    year: '2018',
    label: 'Reforma de Estatutos',
    title: 'Fondo de Empleados Supermercados — FEDESMER',
    desc: 'Por Reforma de Estatutos, se amplían los servicios a los trabajadores del sector retail cambiando de razón social a Fondo de Empleados Supermercados y toma la sigla FEDESMER.',
  },
  {
    year: '2023',
    label: 'Ampliación del vínculo',
    title: 'Nuevos sectores',
    desc: 'Acorde a la Reforma de Estatutos, se amplía el vínculo a empresas del sector comercial, de servicios y de la salud.',
  },
  {
    year: '2024',
    label: 'Reforma de Estatutos',
    title: 'Nace Fintegrar',
    desc: 'Con la Reforma de Estatutos, el Fondo cambia su nombre por Fintegrar.',
  },
  {
    year: String(anioActual),
    label: 'Actualidad',
    title: `${aniosTrayectoria} años construyendo bienestar solidario`,
    desc: `${aniosTrayectoria} años de historia al servicio del bienestar de nuestros asociados.`,
    activo: true,
  },
];
---

<section id="historia" class="historia-section" aria-labelledby="historia-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center max-w-5xl mx-auto mb-16 reveal">
      <h2 id="historia-title" class="font-display historia-heading text-2xl sm:text-3xl md:text-4xl whitespace-normal md:whitespace-nowrap">
        {aniosTrayectoria} años construyendo bienestar solidario
      </h2>
    </div>

    <div class="htl-track-wrap reveal" id="htl-track-wrap">
      <div class="htl-track" id="htl-track">
        <div class="htl-line" aria-hidden="true"></div>
        {[...hitos, ...hitos].map((h, i) => (
          <div class={`htl-col${h.activo ? ' htl-col--active' : ''}`} aria-hidden={i >= hitos.length ? 'true' : undefined} tabindex={i >= hitos.length ? -1 : 0}>
            <div class="htl-node">
              <span class="htl-dot" aria-hidden="true"></span>
            </div>
            <div class="htl-card">
              <span class="htl-year">{h.year}</span>
              <div class="htl-label">{h.label}</div>
              <h4 class="htl-title">{h.title}</h4>
              <p class="htl-desc">{h.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<section id="mision" class="mv-section" aria-label="Misión y Visión">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Título Misión y Visión -->
    <div class="mb-8">
      <h3 class="font-display historia-heading text-2xl sm:text-3xl md:text-4xl text-center reveal">
        Misión y Visión
      </h3>
    </div>

    <!-- 2 Columnas limpias de Misión y Visión -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal">

      <!-- Columna 1: Misión -->
      <div class="bg-white rounded-[2rem] border border-slate-200/80 shadow-[0_10px_30px_rgba(0,19,43,0.06)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-8 sm:p-10 flex flex-col justify-between">
        <div>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed font-normal">
            Somos un Fondo de Empleados con <strong class="text-gray-900 font-bold">{aniosTrayectoria} años de trayectoria</strong>, legalmente constituido y vigilado por la Superintendencia de la Economía Solidaria. Somos una empresa asociativa de derecho privado, sin ánimo de lucro, conformada principalmente por trabajadores que unen esfuerzos para promover el bienestar económico, social y cultural de sus asociados, fomentando el ahorro y facilitando el acceso a crédito con tasas competitivas.
          </p>
        </div>
      </div>

      <!-- Columna 2: Visión -->
      <div class="bg-white rounded-[2rem] border border-slate-200/80 shadow-[0_10px_30px_rgba(0,19,43,0.06)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-8 sm:p-10 flex flex-col justify-between">
        <div>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed font-normal">
            Ser la alternativa de bienestar preferida por nuestros asociados, consolidando una cultura del ahorro y el acceso a soluciones de crédito confiables, con una <strong class="text-gray-900 font-bold">administración transparente</strong> que sus propios asociados llevan a cabo a través de sus órganos directivos, procurando siempre el desarrollo humano, social y económico de quienes conforman a Fintegrar.
          </p>
        </div>
      </div>

    </div>

    <!-- Palabras Grandes: Confianza (Morado) y Seguridad (Celeste) -->
    <ConfianzaSeguridad class="mt-24 pb-8 sm:pb-12" />

  </div>
</section>

<style>
  .historia-section {
    background: var(--color-navbar-bg);
    padding: 6rem 0;
  }

  .htl-track-wrap {
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.5rem;
  }
  .htl-track-wrap::-webkit-scrollbar {
    display: none;
  }

  .htl-track {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    width: max-content;
    padding: 0.5rem 1rem 1rem;
  }

  .htl-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 1.4375rem;
    height: 2px;
    background: rgba(var(--color-ink-rgb), 0.12);
    z-index: 0;
  }

  .htl-col {
    position: relative;
    z-index: 1;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
    width: clamp(230px, 24vw, 280px);
  }

  .htl-node {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.875rem;
    margin-bottom: 2rem;
  }

  .htl-dot {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: var(--radius-full);
    background: var(--color-white);
    border: 2px solid rgba(var(--color-ink-rgb), 0.25);
    transition: border-color 0.4s ease, background 0.4s ease;
  }

  .htl-card {
    width: 100%;
    text-align: center;
    padding: 0 0.5rem;
  }

  .htl-year {
    display: block;
    font-size: 1.75rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-brand-purple);
    white-space: nowrap;
    margin-bottom: 0.75rem;
    transition: opacity 0.4s ease;
    animation: htlYearPulse 2.6s ease-in-out infinite;
  }

  @keyframes htlYearPulse {
    0%, 100% {
      transform: scale(1) translateY(0);
    }
    50% {
      transform: scale(1.08) translateY(-0.15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .htl-year {
      animation: none;
    }
  }

  .htl-col--active .htl-year {
    opacity: 1;
  }
  .htl-col--active .htl-dot {
    background: var(--color-brand-purple);
    border-color: transparent;
  }

  .htl-label {
    font-size: 0.7rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    opacity: 0.4;
    margin-bottom: 0.5rem;
  }

  .htl-title {
    font-size: 1.0625rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    opacity: 0.85;
    margin-bottom: 0.5rem;
    line-height: var(--lh-130);
  }

  .htl-desc {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.65;
    line-height: var(--lh-160);
  }

  .htl-col--active .htl-title,
  .htl-col--active .htl-label {
    opacity: 1;
  }
  .htl-col--active .htl-title {
    position: relative;
    z-index: 0;
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 0;
    animation: htlHighlightText 4s ease-in-out infinite;
  }
  .htl-col--active .htl-title::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-brand-purple);
    transform-origin: left center;
    animation: htlHighlightBg 4s ease-in-out infinite;
  }

  @keyframes htlHighlightBg {
    0%, 15% {
      transform: scaleX(0);
    }
    30%, 65% {
      transform: scaleX(1);
    }
    80%, 100% {
      transform: scaleX(0);
    }
  }

  @keyframes htlHighlightText {
    0%, 18% {
      color: var(--color-ink);
    }
    28%, 67% {
      color: var(--color-white);
    }
    77%, 100% {
      color: var(--color-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .htl-col--active .htl-title {
      animation: none;
      color: var(--color-white);
    }
    .htl-col--active .htl-title::before {
      animation: none;
      transform: scaleX(1);
    }
  }

  .htl-col--active .htl-desc {
    opacity: 0.7;
  }

  @media (hover: hover) and (pointer: fine) {
    .htl-track-wrap {
      overflow: hidden;
    }
    .htl-track {
      animation: htlAutoScroll 38s linear infinite;
    }
    .htl-track-wrap:hover .htl-track,
    .htl-track-wrap:focus-within .htl-track {
      animation-play-state: paused;
    }
  }

  @keyframes htlAutoScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .htl-track {
      animation: none !important;
    }
  }

  .historia-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 1.25rem;
  }

  .historia-texto {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.8;
    line-height: var(--lh-185);
  }
  .historia-texto strong {
    color: var(--color-ink);
    font-weight: var(--fw-bold);
  }

  .mv-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0;
  }

  .mv-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 0;
  }

  .mv-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .mv-texto {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.8;
    line-height: var(--lh-175);
    margin-bottom: 1.25rem;
  }
  .mv-texto:last-child {
    margin-bottom: 0;
  }

  .valores-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0;
  }

  .valores-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 1rem;
  }

  .beneficios-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .beneficio-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.5rem;
    box-shadow: var(--shadow-sm);
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.85;
    line-height: var(--lh-150);
  }

  .beneficio-icon {
    color: var(--color-brand-yellow);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  @media (max-width: 1023px) {
    .historia-section { padding: 4rem 0; }
    .mv-section { padding: 3.5rem 0; }
    .valores-section { padding: 3.5rem 0; }
  }

  @media (max-width: 639px) {
    .historia-section { padding: 2.5rem 0; }
    .mv-section       { padding: 2.5rem 0; }
    .valores-section  { padding: 2.5rem 0; }

    .htl-col {
      width: clamp(210px, 78vw, 260px);
    }
  }
</style>

