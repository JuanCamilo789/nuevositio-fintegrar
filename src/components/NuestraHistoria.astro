---
import { Icon } from 'astro-icon/components';

const ANIO_ORIGEN = 1988;
const anioActual = new Date().getFullYear();
const aniosTrayectoria = anioActual - ANIO_ORIGEN;

const hitos = [
  {
    year: '1988',
    label: 'Origen',
    title: 'Nace la natillera',
    desc: 'Un grupo de empleados de la Cooperativa Consumo decidió conformar una natillera para ahorrar y tener acceso a créditos.',
  },
  {
    year: '2000',
    label: 'Impulso legal',
    title: 'Camino a la formalización',
    desc: 'La Gerencia de la Cooperativa Consumo motivó la organización legal del Fondo.',
  },
  {
    year: '2001',
    label: 'Personería Jurídica',
    title: 'Nace Feconsumo',
    desc: 'El Fondo recibió la Personería Jurídica de Feconsumo.',
  },
  {
    year: '2018',
    label: 'Reforma de Estatutos',
    title: 'Fondo de Empleados Supermercados — FEDESMER',
    desc: 'Por Reforma de Estatutos, se amplían los servicios a los trabajadores del sector retail cambiando de razón social a Fondo de Empleados Supermercados y toma la sigla FEDESMER.',
  },
  {
    year: '2023',
    label: 'Ampliación del vínculo',
    title: 'Nuevos sectores',
    desc: 'Acorde a la Reforma de Estatutos, se amplía el vínculo a empresas del sector comercial, de servicios y de la salud.',
  },
  {
    year: '2024',
    label: 'Reforma de Estatutos',
    title: 'Nace Fintegrar',
    desc: 'Con la Reforma de Estatutos, el Fondo cambia su nombre por Fintegrar.',
  },
  {
    year: String(anioActual),
    label: 'Actualidad',
    title: `${aniosTrayectoria} años construyendo bienestar solidario`,
    desc: `${aniosTrayectoria} años de historia al servicio del bienestar de nuestros asociados.`,
    activo: true,
  },
];
---

<section id="historia" class="historia-section" aria-labelledby="historia-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <h2 id="historia-title" class="font-display historia-heading">
        {aniosTrayectoria} años construyendo bienestar solidario
      </h2>
    </div>

    <div class="htl-timeline">
      <div class="htl-fill"></div>
      {hitos.map((h, i) => (
        <div class={`htl-item ${i % 2 === 0 ? 'htl-item--right' : 'htl-item--left'}${h.activo ? ' htl-item--active' : ''} reveal`}>
          <div class="htl-pill">{h.year}</div>
          <div class="htl-content">
            <div class="htl-label">{h.label}</div>
            <h4 class="htl-title">{h.title}</h4>
            <p class="htl-desc">{h.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<section id="mision" class="mv-section" aria-label="Misión y Visión">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center max-w-2xl mx-auto mb-12 reveal">
      <h2 class="font-display mv-heading">Misión y Visión</h2>
    </div>

    <div class="mv-content">
      <p class="mv-texto reveal">
        Somos un Fondo de Empleados con {aniosTrayectoria} años de trayectoria, legalmente constituido y
        vigilado por la Superintendencia de la Economía Solidaria. Somos una empresa
        asociativa de derecho privado, sin ánimo de lucro, conformada principalmente por
        trabajadores que se unen con el objetivo de promover el bienestar económico, social y
        cultural de sus asociados, fomentando el ahorro y facilitando el acceso a crédito con
        tasas competitivas.
      </p>

      <p class="mv-texto reveal reveal-delay-1">
        Ser la alternativa de bienestar preferida por nuestros asociados, consolidando una
        cultura del ahorro y el acceso a soluciones de crédito confiables, con una
        administración transparente que sus propios asociados llevan a cabo a través de sus
        órganos directivos, procurando siempre el desarrollo humano, social y económico de
        quienes conforman a Fintegrar.
      </p>
    </div>

  </div>
</section>

<section id="valores" class="valores-section" aria-labelledby="valores-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center max-w-xl mx-auto mb-12 reveal">
      <h2 id="valores-title" class="font-display valores-heading">
        Beneficios para nuestros asociados
      </h2>
    </div>

    <div class="beneficios-list reveal">
      <div class="beneficio-item">
        <Icon name="tabler:check" class="w-5 h-5 beneficio-icon" aria-hidden="true" />
        <span>Fomentar el ahorro.</span>
      </div>
      <div class="beneficio-item">
        <Icon name="tabler:check" class="w-5 h-5 beneficio-icon" aria-hidden="true" />
        <span>Fácil acceso a créditos con tasas competitivas.</span>
      </div>
      <div class="beneficio-item">
        <Icon name="tabler:check" class="w-5 h-5 beneficio-icon" aria-hidden="true" />
        <span>Descuentos especiales con empresas a través de convenios.</span>
      </div>
      <div class="beneficio-item">
        <Icon name="tabler:check" class="w-5 h-5 beneficio-icon" aria-hidden="true" />
        <span>Las deducciones de nómina se hacen quincenalmente.</span>
      </div>
      <div class="beneficio-item">
        <Icon name="tabler:check" class="w-5 h-5 beneficio-icon" aria-hidden="true" />
        <span>La administración del Fondo la llevan sus propios asociados a través de los órganos directivos.</span>
      </div>
    </div>

  </div>
</section>

<style>
  .historia-section {
    background: var(--color-navbar-bg);
    padding: 6rem 0;
  }

  .htl-timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  .htl-timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: rgba(var(--color-ink-rgb), 0.12);
    transform: translateX(-50%);
  }

  .htl-fill {
    position: absolute;
    left: 50%;
    top: 0.75rem;
    width: 2px;
    height: 0%;
    background: var(--gradient-brand);
    transform: translateX(-50%);
    z-index: 0;
    transition: height 0.15s linear;
  }

  .htl-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3rem;
    padding: 1rem 0;
  }

  .htl-pill {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-white);
    background: var(--color-ink);
    border: none;
    padding: 0.375rem 1rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
    transition: background 0.4s ease;
  }

  .htl-item--active .htl-pill {
    box-shadow: var(--shadow-md);
  }
  .htl-item--active.is-seen .htl-pill {
    background: var(--gradient-brand);
  }

  .htl-content {
    padding-top: 2.5rem;
  }

  .htl-item--right .htl-content {
    grid-column: 2;
    text-align: left;
  }
  .htl-item--left .htl-content {
    grid-column: 1;
    text-align: right;
  }

  .htl-label {
    font-size: 0.7rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    opacity: 0.4;
    margin-bottom: 0.375rem;
  }

  .htl-title {
    font-size: 1.0625rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    opacity: 0.45;
    margin-bottom: 0.375rem;
    line-height: var(--lh-130);
    transition: opacity 0.4s ease;
  }

  .htl-desc {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.4;
    line-height: var(--lh-160);
    transition: opacity 0.4s ease;
  }

  .htl-item.is-seen .htl-title {
    opacity: 0.85;
  }
  .htl-item.is-seen .htl-desc {
    opacity: 0.65;
  }

  .htl-item--active.is-seen .htl-title {
    opacity: 1;
  }
  .htl-item--active.is-seen .htl-desc {
    opacity: 0.7;
  }
  .htl-item--active.is-seen .htl-label {
    opacity: 1;
  }

  .historia-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 1.25rem;
  }

  .historia-texto {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.8;
    line-height: var(--lh-185);
  }
  .historia-texto strong {
    color: var(--color-ink);
    font-weight: var(--fw-bold);
  }

  .mv-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0;
  }

  .mv-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 0;
  }

  .mv-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .mv-texto {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.8;
    line-height: var(--lh-175);
    margin-bottom: 1.25rem;
  }
  .mv-texto:last-child {
    margin-bottom: 0;
  }

  .valores-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0;
  }

  .valores-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 1rem;
  }

  .beneficios-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .beneficio-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1.125rem 1.5rem;
    box-shadow: var(--shadow-sm);
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.85;
    line-height: var(--lh-150);
  }

  .beneficio-icon {
    color: var(--color-brand-yellow);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  @media (max-width: 1023px) {
    .historia-section { padding: 4rem 0; }
    .mv-section { padding: 3.5rem 0; }
    .valores-section { padding: 3.5rem 0; }
  }

  @media (max-width: 639px) {
    .historia-section { padding: 2.5rem 0; }
    .mv-section       { padding: 2.5rem 0; }
    .valores-section  { padding: 2.5rem 0; }

    .htl-timeline::before,
    .htl-fill {
      left: 20px;
    }
    .htl-item {
      grid-template-columns: 1fr;
      padding: 0.75rem 0 0.75rem 3rem;
    }
    .htl-pill {
      left: 20px;
      top: 0.75rem;
    }
    .htl-content {
      padding-top: 0;
    }
    .htl-item--right .htl-content,
    .htl-item--left .htl-content {
      grid-column: 1;
      text-align: left;
    }
  }
</style>

<script>
  function initHistoriaTimeline() {
    const timeline = document.querySelector<HTMLElement>('.htl-timeline');
    const fill = document.querySelector<HTMLElement>('.htl-fill');
    if (!timeline || !fill) return;

    const items = Array.from(timeline.querySelectorAll<HTMLElement>('.htl-item'));
    let ticking = false;

    function update() {
      ticking = false;
      const rect = timeline!.getBoundingClientRect();
      const trigger = window.innerHeight * 0.6;
      const total = rect.height || 1;
      const progress = Math.max(0, Math.min(1, (trigger - rect.top) / total));
      fill!.style.height = `${progress * 100}%`;

      items.forEach((item) => {
        const itemTop = item.getBoundingClientRect().top;
        item.classList.toggle('is-seen', itemTop < trigger);
      });
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }

  initHistoriaTimeline();
  document.addEventListener('astro:after-swap', initHistoriaTimeline);
</script>
