---
import { Icon } from 'astro-icon/components';
import { tasasDestacadas, tasaPorId } from '@data/tasas';
---

<!--
     SITE HEADER (navbar flotante + topbar debajo — mega panels son hermanos, más abajo)
 -->
<div id="siteHeader" class="site-header">

  <header class="navbar" id="navbar">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center justify-between xl:grid xl:grid-cols-[auto_1fr_auto] xl:gap-4 h-16">

        <div class="flex justify-start">
          <a href="/" class="flex items-center flex-shrink-0" aria-label="FINTEGRAR inicio">
            <img
              src="/assets/logos/logo1.png"
              alt="FINTEGRAR Logo"
              class="site-logo h-8 lg:h-9 w-auto"
              fetchpriority="high"
            >
          </a>
        </div>

        <nav class="hidden xl:flex items-center justify-center gap-1 min-w-0" aria-label="Navegación principal">
          <a href="/" class="nav-link active">Inicio</a>

          <button
            class="mega-trigger nav-link"
            data-target="nosotros"
            aria-expanded="false"
            aria-controls="mega-nosotros"
            aria-haspopup="true"
          >
            Nosotros
            <Icon name="tabler:arrow-up-right" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="ahorros"
            aria-expanded="false"
            aria-controls="mega-ahorros"
            aria-haspopup="true"
          >
            Ahorros
            <Icon name="tabler:arrow-up-right" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="creditos"
            aria-expanded="false"
            aria-controls="mega-creditos"
            aria-haspopup="true"
          >
            Créditos
            <Icon name="tabler:arrow-up-right" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <a href="/convenios" class="nav-link">Convenios</a>
          <a href="/directorio" class="nav-link">Directorio</a>
        </nav>

        <div class="hidden xl:flex items-center justify-end gap-2">
          <div class="services-dropdown">
            <button
              class="btn btn-dark btn-sm flex items-center gap-1.5"
              id="servicesToggle"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="servicesMenu"
            >
              <Icon name="tabler:apps" class="w-4 h-4" aria-hidden="true" />
              Servicios
              <Icon name="tabler:chevron-down" class="services-chevron w-3.5 h-3.5" aria-hidden="true" />
            </button>
            <div class="services-menu" id="servicesMenu" role="menu">
              <a href="https://tramitesvirtuales.fintegrar.com/" class="services-menu-item" target="_blank" rel="noopener noreferrer" role="menuitem">
                <Icon name="tabler:layout-dashboard" class="w-4 h-4" aria-hidden="true" />
                Trámites Virtuales
              </a>
              <a href="https://www.zonapagos.net/formulariosNV/?cod=BTK3a53qAPJK5dFzuUb9xoOMEi6GjxTVEz6jgj8WOG4kf7Z7mmbU2N6iG2sClbz5isF7xpuvz4ec%2FstAKWghYq2ihH6ea5Ab%2BfJXSgfBIPShwQxb9hHbzgY1XqGlsllif2sqgYeyszPfE%2Fq5SNonDhF9ZhqXm7OyDm%2Ba4lfdMItrvmOCQ5Py2gAq%2BvwFtoRMoNDPxeZKzglBDlEyqykoMK2kz6zyhc7dmjJO23oOZfDrWY5p5hfLu%2BH0xUIIx2%2F2zJLthSgc28WEY9rneC44s4DORf3zdoMntL1Bmxpscus%3D" class="services-menu-item" target="_blank" rel="noopener noreferrer" role="menuitem">
                <Icon name="tabler:device-mobile-dollar" class="w-4 h-4" aria-hidden="true" />
                Pagos PSE
              </a>
            </div>
          </div>
          <a href="/docs/brochure-fintegrar.pdf" class="btn btn-purple btn-sm flex items-center gap-1.5" download="portafolio-fintegrar-2026.pdf">
            <Icon name="tabler:download" class="w-4 h-4" aria-hidden="true" />
            Descargar brochure
          </a>
        </div>

        <div class="xl:hidden flex justify-end">
          <button
            id="mobileMenuToggle"
            class="p-2 -mr-2 text-[var(--color-ink)] flex flex-col items-center"
            aria-label="Abrir menú"
            aria-expanded="false"
          >
            <Icon name="tabler:menu-2" class="w-7 h-7" id="iconMenu" />
            <Icon name="tabler:x" class="w-7 h-7 hidden" id="iconClose" />
            <span class="text-xs font-semibold mt-0">Menú</span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <div class="topbar">
    <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
      <div class="flex items-center gap-5">
        <a href="mailto:auxiliar@fintegrar.com" class="topbar-item" style="--topbar-item-delay: 0.05s;">
          <Icon name="tabler:mail" class="w-3.5 h-3.5" aria-hidden="true" />
          auxiliar@fintegrar.com
        </a>
        <span class="topbar-sep hidden lg:block" style="--topbar-item-delay: 0.09s;"></span>
        <span class="topbar-item hidden lg:flex" style="--topbar-item-delay: 0.12s;">
          <Icon name="tabler:map-pin" class="w-3.5 h-3.5" aria-hidden="true" />
          Oficinas de Prosalco IPS Poblado, Cra 43 A # 25-69
        </span>
        <span class="topbar-sep hidden xl:block" style="--topbar-item-delay: 0.16s;"></span>
        <span class="topbar-item hidden xl:flex" style="--topbar-item-delay: 0.19s;">
          <Icon name="tabler:clock" class="w-3.5 h-3.5" aria-hidden="true" />
          Lun-Mar 7:30am-5:00pm &amp; Mié-Vie 7:30am-4:00pm
        </span>
      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a
          href="/creditos#tasas"
          class="topbar-ticker hidden 2xl:flex"
          id="topbarTicker"
          aria-live="polite"
          style="--topbar-item-delay: 0.28s;"
          data-tasas={JSON.stringify(tasasDestacadas.map((t) => `${t.nombre} · ${t.tasa}`))}
        >
          <span class="topbar-ticker-text" id="topbarTickerText">{tasasDestacadas[0].nombre} · {tasasDestacadas[0].tasa}</span>
        </a>

        <div class="topbar-sep hidden 2xl:block" style="--topbar-item-delay: 0.31s;"></div>

        <div class="flex items-center gap-3">
          <a href="https://www.facebook.com/p/Fintegrar-Fondo-de-Empleados-61579258882412/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="Facebook" style="--topbar-item-delay: 0.34s;">
            <Icon name="tabler:brand-facebook" class="w-4 h-4" />
          </a>
          <a href="https://www.instagram.com/fintegrar_/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="Instagram" style="--topbar-item-delay: 0.37s;">
            <Icon name="tabler:brand-instagram" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<div class="mega-panel" id="mega-nosotros" role="region" aria-label="Menú Nosotros">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mega-inner">

      <div class="mega-col">
        <div class="mega-col-title">El Fondo</div>
        <a href="/nosotros#historia" class="mega-item">
          <div>
            <div class="mega-item-title">Nuestra historia</div>
            <div class="mega-item-sub">36 años de trayectoria</div>
          </div>
        </a>
        <a href="/nosotros" class="mega-item">
          <div>
            <div class="mega-item-title">Quiénes somos</div>
            <div class="mega-item-sub">Historia y valores institucionales</div>
          </div>
        </a>
        <a href="/nosotros#mision" class="mega-item">
          <div>
            <div class="mega-item-title">Misión y Visión</div>
            <div class="mega-item-sub">Nuestro propósito y metas</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Informes</div>
        <a href="/cuerpos-colegiados" class="mega-item">
          <div>
            <div class="mega-item-title">Cuerpos Colegiados</div>
            <div class="mega-item-sub">Junta Directiva y otros</div>
          </div>
        </a>
        <a href="/documentacion" class="mega-item">
          <div>
            <div class="mega-item-title">Documentación</div>
            <div class="mega-item-sub">Estatutos y documentos vigentes</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Transparencia</div>
        <a href="/documentacion#informes" class="mega-item">
          <div>
            <div class="mega-item-title">Informes anuales</div>
            <div class="mega-item-sub">Balances financieros y sociales</div>
          </div>
        </a>
        <a href="/documentacion" class="mega-item">
          <div>
            <div class="mega-item-title">SARLAFT</div>
            <div class="mega-item-sub">Prevención lavado de activos</div>
          </div>
        </a>
      </div>

    </div>
  </div>
</div>

<div class="mega-panel" id="mega-creditos" role="region" aria-label="Menú Créditos">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mega-inner">

      <div class="mega-col">
        <div class="mega-col-title">Líneas de Crédito</div>
        <a href="/creditos#ordinario" class="mega-item">
          <div>
            <div class="mega-item-title">Crédito Ordinario</div>
            <div class="mega-item-sub">{tasaPorId['ordinario']} · para cualquier necesidad</div>
          </div>
        </a>
        <a href="/creditos#educacion" class="mega-item">
          <div>
            <div class="mega-item-title">Crédito para Educación</div>
            <div class="mega-item-sub">{tasaPorId['educacion']} · instituciones certificadas</div>
          </div>
        </a>
        <a href="/creditos#calamidad" class="mega-item">
          <div>
            <div class="mega-item-title">Calamidad Doméstica</div>
            <div class="mega-item-sub">{tasaPorId['calamidad']} · plazo hasta 12 meses</div>
          </div>
        </a>
        <a href="/creditos" class="mega-item">
          <div>
            <div class="mega-item-title">Ver todas las líneas</div>
            <div class="mega-item-sub">10 modalidades disponibles</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Herramientas</div>
        <a href="/#simulador" class="mega-item">
          <div>
            <div class="mega-item-title">Simulador de crédito</div>
            <div class="mega-item-sub">Calcule su cuota mensual</div>
          </div>
        </a>
        <a href="/creditos#tasas" class="mega-item">
          <div>
            <div class="mega-item-title">Tasas de interés</div>
            <div class="mega-item-sub">Vigentes por línea</div>
          </div>
        </a>
        <a href="/creditos#documentos" class="mega-item">
          <div>
            <div class="mega-item-title">Documentos requeridos</div>
            <div class="mega-item-sub">Lista completa por línea</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Cómo Solicitar</div>
        <a href="/creditos#requisitos" class="mega-item">
          <div>
            <div class="mega-item-title">Requisitos</div>
            <div class="mega-item-sub">Condiciones de elegibilidad</div>
          </div>
        </a>
        <a href="/creditos#proceso" class="mega-item">
          <div>
            <div class="mega-item-title">Proceso de solicitud</div>
            <div class="mega-item-sub">Paso a paso hasta el desembolso</div>
          </div>
        </a>
      </div>

      <div class="mega-col-image" aria-hidden="true">
        <img
          src="/assets/img/shared/mega-creditos-persona.webp"
          alt=""
          class="mega-col-image-img"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</div>

<div class="mega-panel" id="mega-ahorros" role="region" aria-label="Menú Ahorros">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mega-inner">

      <div class="mega-col">
        <div class="mega-col-title">Modalidades de Ahorro</div>
        <a href="/ahorros#aportes-sociales" class="mega-item">
          <div>
            <div class="mega-item-title">Aportes Sociales y Ahorro Permanente</div>
            <div class="mega-item-sub">Deducción quincenal por nómina</div>
          </div>
        </a>
        <a href="/ahorros#ahorro-navideno" class="mega-item">
          <div>
            <div class="mega-item-title">Ahorro Navideño</div>
            <div class="mega-item-sub">Se entrega en diciembre</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title" aria-hidden="true" style="visibility:hidden;">Modalidades de Ahorro</div>
        <a href="/ahorros#pequenos-ahorradores" class="mega-item">
          <div>
            <div class="mega-item-title">Pequeños Ahorradores</div>
            <div class="mega-item-sub">Para los hijos de asociados</div>
          </div>
        </a>
        <a href="/ahorros#cdat" class="mega-item">
          <div>
            <div class="mega-item-title">CDAT</div>
            <div class="mega-item-sub">Depósito a término, 90 a 720 días</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Beneficios</div>
        <a href="/ahorros#rifa-semanal" class="mega-item">
          <div>
            <div class="mega-item-title">Rifa Semanal</div>
            <div class="mega-item-sub">3 oportunidades de ganar cada semana</div>
          </div>
        </a>
      </div>

      <div class="mega-col-image" aria-hidden="true">
        <img
          src="/assets/img/hero/hero-card-ahorros.webp"
          alt=""
          class="mega-col-image-img mega-col-image-img--sm"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</div>

<div class="mega-panel" id="mega-bienestar" role="region" aria-label="Menú Bienestar Social">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mega-inner">

      <div class="mega-col">
        <div class="mega-col-title">Auxilios y Beneficios</div>
        <a href="/nosotros#auxilios" class="mega-item">
          <div>
            <div class="mega-item-title">Subsidio de salud</div>
            <div class="mega-item-sub">Auxilios médicos y hospitalarios</div>
          </div>
        </a>
        <a href="/nosotros#auxilios" class="mega-item">
          <div>
            <div class="mega-item-title">Auxilio educativo</div>
            <div class="mega-item-sub">Para hijos y asociados</div>
          </div>
        </a>
        <a href="/nosotros#auxilios" class="mega-item">
          <div>
            <div class="mega-item-title">Calamidad doméstica</div>
            <div class="mega-item-sub">Apoyo en emergencias</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Convenios</div>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Salud y medicina</div>
            <div class="mega-item-sub">Clínicas, laboratorios, ópticas</div>
          </div>
        </a>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Turismo y recreación</div>
            <div class="mega-item-sub">Agencias y hoteles aliados</div>
          </div>
        </a>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Tecnología</div>
            <div class="mega-item-sub">Equipos y telecomunicaciones</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Información</div>
        <a href="/nosotros#novedades" class="mega-item">
          <div>
            <div class="mega-item-title">Novedades</div>
            <div class="mega-item-sub">Noticias y comunicados</div>
          </div>
        </a>
        <a href="/nosotros#calendario" class="mega-item">
          <div>
            <div class="mega-item-title">Calendario de actividades</div>
            <div class="mega-item-sub">Jornadas y eventos del semestre</div>
          </div>
        </a>
      </div>

      <div class="mega-featured" style="background:var(--color-white);color:var(--color-ink);margin-left:1.5rem;border:1px solid var(--color-surface);">
        <div class="mega-featured-icon" style="background:var(--color-surface);border:1px solid var(--color-surface);">
          <Icon name="tabler:heart" class="w-5 h-5" style="color:var(--color-ink);" aria-hidden="true" />
        </div>
        <div class="mega-featured-title" style="color:var(--color-ink);">Bienestar para todos</div>
        <div class="mega-featured-sub" style="color:var(--color-ink); opacity: 0.6;">
          Programas y beneficios diseñados para mejorar la calidad de vida de nuestra comunidad.
        </div>
        <a href="/nosotros#auxilios" class="mega-featured-cta" style="background:var(--color-ink);color:var(--color-white);">
          Ver beneficios
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
        </a>
      </div>

    </div>
  </div>
</div>

<div class="mega-backdrop" id="megaBackdrop" aria-hidden="true"></div>

