    <div style="display:flex;justify-content:center;gap:1.5rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--color-surface);">
      <a href="https://www.facebook.com/p/Fintegrar-Fondo-de-Empleados-61579258882412/" target="_blank" rel="noopener noreferrer" style="color:var(--color-ink);transition:color 0.2s;" onmouseover="this.style.color='var(--color-brand-purple)'" onmouseout="this.style.color='var(--color-ink)'">
        <Icon name="tabler:brand-facebook" class="w-6 h-6" />
      </a>
      <a href="https://www.instagram.com/fintegrar_/" target="_blank" rel="noopener noreferrer" style="color:var(--color-ink);transition:color 0.2s;" onmouseover="this.style.color='var(--color-brand-purple)'" onmouseout="this.style.color='var(--color-ink)'">
        <Icon name="tabler:brand-instagram" class="w-6 h-6" />
      </a>
    </div>
