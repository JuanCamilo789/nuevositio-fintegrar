---
import { Icon } from 'astro-icon/components';

const lineas = [
  {
    id: 'ordinario',
    icon: 'tabler:credit-card',
    nombre: 'Crédito Libre Inversión',
    subtitulo: 'Libre Inversión',
    tasa: 1.9,
    displayTasa: '1.5% – 1.9% M.V.',
    maxMeses: 60,
    badge: null,
    nota: 'La tasa final depende de su perfil de riesgo. Este cálculo usa la tasa máxima (1.9%).',
  },
  {
    id: 'educativo',
    icon: 'tabler:school',
    nombre: 'Crédito Educativo',
    subtitulo: 'Universidad Católica Luis Amigó',
    tasa: 1.35,
    displayTasa: '1.35% M.V.',
    maxMeses: 6,
    badge: null,
    nota: '',
  },
];
---

<section id="simulador" class="sim-section">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-16 reveal">
      <div class="section-eyebrow" style="justify-content:center;">Herramienta financiera</div>
      <h2 class="font-display sim-heading">Simulador de Crédito</h2>
    </div>

    <div class="sim-card reveal" id="simCard">

      <div class="sim-topbar" aria-hidden="true">
        <div class="sim-bar-track">
          <div class="sim-bar-fill" id="simBarFill"></div>
        </div>
        <div class="sim-bar-steps">
          <span class="sim-bar-lbl" data-bar="0">Inicio</span>
          <span class="sim-bar-lbl" data-bar="1">Línea</span>
          <span class="sim-bar-lbl" data-bar="2">Detalles</span>
        </div>
      </div>

      <div class="sim-body">

                <div class="sim-step active" id="step-0">
          <div class="step-header">
            <div class="step-icon-wrap">
              <Icon name="tabler:calculator" class="w-7 h-7" aria-hidden="true" />
            </div>
            <div class="step-text">
              <h3 class="step-title">¿Sabe cuánto dinero necesita?</h3>
              <p class="step-desc">Esto nos ayuda a mostrarle el simulador más adecuado para usted.</p>
            </div>
          </div>
          <div class="choice-grid">
            <button class="choice-btn" id="btn-path-a">
              <div class="choice-icon-wrap choice--yes">
                <Icon name="tabler:check" class="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="choice-text">
                <div class="choice-title">Sí, tengo un valor en mente</div>
                <div class="choice-sub">Ingrese el monto y le calculamos la cuota mensual</div>
              </div>
              <Icon name="tabler:chevron-right" class="choice-arrow w-4 h-4" aria-hidden="true" />
            </button>
            <button class="choice-btn" id="btn-path-b">
              <div class="choice-icon-wrap choice--help">
                <Icon name="tabler:help" class="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="choice-text">
                <div class="choice-title">No, no estoy seguro</div>
                <div class="choice-sub">Díganos cuánto puede pagar al mes y le calculamos el monto</div>
              </div>
              <Icon name="tabler:chevron-right" class="choice-arrow w-4 h-4" aria-hidden="true" />
            </button>
          </div>
        </div>

                <div class="sim-step" id="step-1">
          <button class="btn-back" id="back-1">
            <Icon name="tabler:arrow-left" class="w-4 h-4" aria-hidden="true" /> Volver
          </button>
          <h3 class="step-title">¿Qué tipo de crédito necesita?</h3>
          <p class="step-desc">Seleccione la línea de crédito que mejor corresponde a su necesidad.</p>
          <div class="lineas-grid">
            {lineas.map(l => (
              <button
                class="linea-card"
                data-id={l.id}
                data-tasa={l.tasa}
                data-display={l.displayTasa}
                data-max={l.maxMeses}
                data-nota={l.nota}
                data-nombre={l.nombre}
              >
                {l.badge && <span class="linea-badge">{l.badge}</span>}
                <div class="linea-icon-box">
                  <Icon name={l.icon} class="w-6 h-6" aria-hidden="true" />
                </div>
                <div class="linea-nombre">{l.nombre}</div>
                <div class="linea-sub">{l.subtitulo}</div>
                <div class="linea-tasa-pill">{l.displayTasa}</div>
              </button>
            ))}
          </div>
        </div>

                <div class="sim-step" id="step-2a">
          <button class="btn-back" id="back-2a">
            <Icon name="tabler:arrow-left" class="w-4 h-4" aria-hidden="true" /> Volver
          </button>
          <h3 class="step-title">Simulador de crédito</h3>
          <p class="step-desc">Recuerde que la información arrojada por el simulador es aproximada y puede tener imprecisiones que podrán ser revisadas en el proceso de crédito.</p>

          <div class="sim-layout">
            <div class="sim-inputs">
              <div class="inputs-2col">

                <div class="input-blk">
                  <label class="input-lbl" for="a-monto-text">Monto del crédito</label>
                  <input
                    type="text"
                    class="monto-input"
                    id="a-monto-text"
                    value="$5.000.000"
                    inputmode="numeric"
                    autocomplete="off"
                  />
                  <input type="hidden" id="a-monto" value="5000000" />
                  <input type="range" class="sim-range" id="a-monto-range"
                    min="500000" max="50000000" step="500000" value="5000000" />
                  <div class="range-ends"><span>$500K</span><span>$50M</span></div>
                </div>

                <div class="input-blk">
                  <label class="input-lbl" for="a-plazo-input">Plazo (meses)</label>
                  <div class="plazo-input-wrap">
                    <input
                      type="number"
                      class="plazo-input"
                      id="a-plazo-input"
                      value="12"
                      min="1"
                      max="60"
                    />
                    <span class="plazo-unit">meses</span>
                  </div>
                  <input type="hidden" id="a-plazo" value="12" />
                  <input type="range" class="sim-range" id="a-plazo-range"
                    min="1" max="60" step="1" value="12" />
                  <div class="range-ends"><span>1 mes</span><span id="a-max-lbl">60 meses</span></div>
                </div>

              </div>
            </div>

            <div class="sim-result-panel">
              <div class="result-panel">
                <div class="rp-eyebrow">Cuota mensual aproximada</div>
                <div class="rp-big" id="a-cuota">$0</div>
                <div class="rp-rows">
                  <div class="rp-row">
                    <span>Tasa</span>
                    <strong id="a-tasa-disp">—</strong>
                  </div>
                </div>
                <div class="rp-nota" id="a-nota"></div>
                <a href="https://serviciosdigitales.cooperamigo.coop" class="btn btn-accent btn-rp"
                  target="_blank" rel="noopener noreferrer">
                  Solicitar crédito
                  <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
                </a>
              </div>
              <p class="sim-disclaimer">* Simulación informativa. No constituye oferta comercial.</p>
            </div>
          </div>
        </div>

                <div class="sim-step" id="step-2b">
          <button class="btn-back" id="back-2b">
            <Icon name="tabler:arrow-left" class="w-4 h-4" aria-hidden="true" /> Volver
          </button>
          <h3 class="step-title">Simulador de crédito</h3>
          <p class="step-desc">Recuerde que la información arrojada por el simulador es aproximada y puede tener imprecisiones que podrán ser revisadas en el proceso de crédito.</p>

          <div class="sim-layout">
            <div class="sim-inputs">
              <div class="inputs-2col">

                <div class="input-blk">
                  <label class="input-lbl" for="b-cuota-text">Valor mensual a pagar</label>
                  <input
                    type="text"
                    class="monto-input"
                    id="b-cuota-text"
                    value="$500.000"
                    inputmode="numeric"
                    autocomplete="off"
                  />
                  <input type="hidden" id="b-cuota-hidden" value="500000" />
                  <input type="range" class="sim-range" id="b-cuota-range"
                    min="50000" max="5000000" step="50000" value="500000" />
                  <div class="range-ends"><span>$50K</span><span>$5M</span></div>
                </div>

                <div class="input-blk">
                  <label class="input-lbl" for="b-plazo-input">Plazo (meses)</label>
                  <div class="plazo-input-wrap">
                    <input
                      type="number"
                      class="plazo-input"
                      id="b-plazo-input"
                      value="12"
                      min="1"
                      max="60"
                    />
                    <span class="plazo-unit">meses</span>
                  </div>
                  <input type="hidden" id="b-plazo" value="12" />
                  <input type="range" class="sim-range" id="b-plazo-range"
                    min="1" max="60" step="1" value="12" />
                  <div class="range-ends"><span>1 mes</span><span id="b-max-lbl">60 meses</span></div>
                </div>

              </div>
            </div>

            <div class="sim-result-panel">
              <div class="result-panel">
                <div class="rp-eyebrow">Podría solicitar hasta</div>
                <div class="rp-big" id="b-monto-max">$0</div>
                <div class="rp-rows">
                  <div class="rp-row">
                    <span>Tasa</span>
                    <strong id="b-tasa-disp">—</strong>
                  </div>
                </div>
                <div class="rp-nota" id="b-nota"></div>
                <a href="https://serviciosdigitales.cooperamigo.coop" class="btn btn-accent btn-rp"
                  target="_blank" rel="noopener noreferrer">
                  Solicitar crédito
                  <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
                </a>
              </div>
              <p class="sim-disclaimer">* Simulación informativa. No constituye oferta comercial.</p>
            </div>
          </div>
        </div>

      </div>    </div>
  </div>
</section>

<style>
    .sim-section {
    background: #fff;
    padding: 8rem 0;
  }
  .sim-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: #172B36;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

    .sim-card {
    max-width: 940px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 48px rgba(23, 43, 54, 0.10);
    overflow: hidden;
  }

    .sim-topbar {
    background: var(--color-surface);
    padding: 1.125rem 2.5rem;
  }
  .sim-bar-track {
    height: 3px;
    background: rgba(23, 43, 54, 0.12);
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .sim-bar-fill {
    height: 100%;
    background: #172B36;
    border-radius: 9999px;
    width: 33%;
    transition: width 0.4s ease;
  }
  .sim-bar-steps {
    display: flex;
    gap: 2rem;
  }
  .sim-bar-lbl {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(23, 43, 54, 0.35);
    transition: color 0.3s;
  }
  .sim-bar-lbl.active { color: #172B36; }

    .sim-step {
    display: none;
    padding: 2.5rem;
    animation: simFadeIn 0.22s ease both;
  }
  .sim-step.active { display: block; }

  @keyframes simFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

    .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #172B36;
    opacity: 0.45;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: 1.5rem;
    transition: opacity 0.15s;
  }
  .btn-back:hover { opacity: 1; }

    .step-icon-wrap {
    width: 56px;
    height: 56px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #172B36;
    flex-shrink: 0;
  }
  .step-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  #step-0:not(.active) { display: none; }
  #step-0 .step-icon-wrap { margin-bottom: 0; }
  /* Paso 0 siempre centrado en el contenedor */
  #step-0 .step-header { justify-content: center; }
  #step-0 .choice-grid { margin-left: auto; margin-right: auto; }

  .step-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: #172B36;
    line-height: 1.2;
    margin-bottom: 0.625rem;
    text-align: center;
  }
  .step-desc {
    font-size: 0.9375rem;
    color: #172B36;
    opacity: 0.65;
    line-height: 1.65;
    max-width: 540px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

    .choice-grid {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 2rem;
    max-width: 520px;
  }
  .choice-btn {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .choice-btn:hover {
    border-color: #172B36;
    background: #fff;
    transform: translateX(5px);
  }
  .choice-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .choice--yes  { background: #172B36; color: #FFC801; }
  .choice--help { background: rgba(23, 43, 54, 0.1); color: #172B36; }
  .choice-text  { flex: 1; }
  .choice-title {
    font-size: 1rem;
    font-weight: 700;
    color: #172B36;
    margin-bottom: 2px;
  }
  .choice-sub {
    font-size: 0.8125rem;
    color: #172B36;
    opacity: 0.55;
  }
  .choice-arrow {
    color: #172B36;
    opacity: 0.25;
    flex-shrink: 0;
    transition: transform 0.2s, opacity 0.2s;
  }
  .choice-btn:hover .choice-arrow { transform: translateX(4px); opacity: 0.7; }

    .lineas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .linea-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .linea-card:hover {
    border-color: #172B36;
    background: #fff;
    box-shadow: 0 4px 24px rgba(23, 43, 54, 0.10);
    transform: translateY(-3px);
  }
  .linea-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #FFC801;
    color: #172B36;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }
  .linea-icon-box {
    width: 44px;
    height: 44px;
    background: #172B36;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFC801;
    margin-bottom: 0.5rem;
  }
  .linea-nombre {
    font-size: 1rem;
    font-weight: 700;
    color: #172B36;
    line-height: 1.2;
  }
  .linea-sub {
    font-size: 0.8125rem;
    color: #172B36;
    opacity: 0.5;
  }
  .linea-tasa-pill {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #172B36;
    background: rgba(23, 43, 54, 0.07);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

    .sim-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
    align-items: start;
  }
  .sim-inputs {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

    .inputs-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  .input-blk { }
  .input-lbl {
    font-size: 0.875rem;
    font-weight: 700;
    color: #172B36;
    display: block;
    margin-bottom: 0.625rem;
  }

    .monto-input {
    font-family: var(--ff-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: #172B36;
    background: var(--color-surface);
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.875rem;
    width: 100%;
    margin-bottom: 0.875rem;
    transition: border-color 0.2s, background 0.2s;
    outline: none;
  }
  .monto-input:focus {
    border-color: #172B36;
    background: #fff;
  }

    .plazo-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }
  .plazo-input {
    font-family: var(--ff-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: #172B36;
    background: var(--color-surface);
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    width: 90px;
    text-align: center;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    -moz-appearance: textfield;
  }
  .plazo-input::-webkit-outer-spin-button,
  .plazo-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .plazo-input:focus {
    border-color: #172B36;
    background: #fff;
  }
  .plazo-unit {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #172B36;
    opacity: 0.45;
  }

  .sim-range {
    width: 100%;
    accent-color: #172B36;
    cursor: pointer;
    height: 4px;
  }
  .range-ends {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #172B36;
    opacity: 0.4;
    margin-top: 0.375rem;
    font-weight: 500;
  }

    .sim-result-panel {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .result-panel {
    background: #172B36;
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  .rp-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.5rem;
  }
  .rp-big {
    font-family: var(--ff-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: #FFC801;
    line-height: 1;
    margin-bottom: 1.75rem;
  }
  .rp-rows {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .rp-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }
  .rp-row span   { color: rgba(255, 255, 255, 0.5); }
  .rp-row strong { color: #fff; font-weight: 600; }
  .rp-nota {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .btn-rp {
    width: 100%;
    justify-content: center;
  }
  .sim-disclaimer {
    font-size: 0.7rem;
    color: #172B36;
    opacity: 0.4;
    line-height: 1.5;
    text-align: center;
  }

    @media (max-width: 1023px) {
    .sim-section { padding: 6rem 0; }
    .sim-layout { grid-template-columns: 1fr; gap: 2rem; }
    .sim-result-panel { position: static; }
  }
  @media (max-width: 767px) {
    .sim-section { padding: 3.5rem 0; }

    /* Tarjeta: bordes más suaves */
    .sim-card {
      border-radius: var(--radius-md);
    }

    /* Barra de progreso compacta */
    .sim-topbar { padding: 0.875rem 1.25rem; }
    .sim-bar-steps { gap: 1rem; }

    /* Steps con menos padding lateral */
    .sim-step { padding: 1.5rem 1.25rem; }

    /* Paso 0: encabezado horizontal compacto */
    .step-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      flex-shrink: 0;
    }
    .step-header { gap: 1rem; margin-bottom: 1.5rem; }
    .step-title { font-size: 1.125rem; }
    .step-desc { font-size: 0.875rem; max-width: 100%; }

    /* Paso 0: opciones apiladas, compactas */
    .choice-grid { max-width: 100%; margin-top: 1.25rem; gap: 0.75rem; }
    .choice-btn { padding: 1rem 1.125rem; gap: 1rem; }
    .choice-title { font-size: 0.9375rem; }
    .choice-sub { font-size: 0.75rem; }

    /* Paso 1: 1 columna, layout horizontal con grid */
    .lineas-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .linea-card {
      display: grid;
      grid-template-columns: 44px 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 1rem;
      row-gap: 0.2rem;
      padding: 1.25rem;
    }
    .linea-badge { display: none; }
    .linea-icon-box {
      grid-column: 1;
      grid-row: 1 / 4;
      align-self: center;
      width: 44px;
      height: 44px;
      margin-bottom: 0;
    }
    .linea-nombre { grid-column: 2; grid-row: 1; font-size: 0.9375rem; }
    .linea-sub    { grid-column: 2; grid-row: 2; font-size: 0.8125rem; }
    .linea-tasa-pill { grid-column: 2; grid-row: 3; font-size: 0.8125rem; margin-top: 0.25rem; align-self: flex-start; }

    /* Paso 2: campos apilados en móviles muy pequeños */
    @media (max-width: 480px) {
      .inputs-2col { 
        grid-template-columns: 1fr; 
        gap: 1.25rem; 
      }
      .monto-input, .plazo-input {
        font-size: 1.35rem; 
        padding: 0.75rem 1rem;
      }
      .plazo-input { width: 100%; text-align: left; }
    }

    /* Panel de resultado */
    .result-panel { padding: 1.5rem; border-radius: var(--radius-md); }
    .rp-big { font-size: 1.75rem; margin-bottom: 1.25rem; }
  }
</style>

<script>
  function setupSimulador() {
    let currentPath: 'a' | 'b' | null = null;
    let linea: { id: string; tasa: number; display: string; max: number; nota: string; nombre: string } | null = null;

    const el = (id: string) => document.getElementById(id);

    
    const fCOP = (n: number) =>
      new Intl.NumberFormat('es-CO', {
        style: 'currency', currency: 'COP', maximumFractionDigits: 0,
      }).format(Math.max(0, Math.round(n)));

    const fNum = (n: number) =>
      Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    
    function parseMonto(str: string): number {
      const clean = str.replace(/[^0-9]/g, '');
      return clean ? parseInt(clean) : 0;
    }

    
    // C = P × i / (1 − (1+i)^−n)
    function calcCuota(P: number, iPct: number, n: number): number {
      const i = iPct / 100;
      if (n <= 0 || P <= 0 || i <= 0) return 0;
      return (P * i) / (1 - Math.pow(1 + i, -n));
    }

    
    // P = C × (1 − (1+i)^−n) / i
    function calcMonto(C: number, iPct: number, n: number): number {
      const i = iPct / 100;
      if (n <= 0 || C <= 0 || i <= 0) return 0;
      return C * (1 - Math.pow(1 + i, -n)) / i;
    }

    
    const barFill = el('simBarFill');
    const barLabels = document.querySelectorAll<HTMLElement>('.sim-bar-lbl');

    function setProgress(pct: number, activeIdx: number) {
      if (barFill) barFill.style.width = pct + '%';
      barLabels.forEach((l, i) => l.classList.toggle('active', i <= activeIdx));
    }

    function showStep(id: string) {
      document.querySelectorAll('.sim-step').forEach(s => s.classList.remove('active'));
      const target = el(id);
      if (target) target.classList.add('active');

      const map: Record<string, [number, number]> = {
        'step-0':  [33,  0],
        'step-1':  [66,  1],
        'step-2a': [100, 2],
        'step-2b': [100, 2],
      };
      const [pct, idx] = map[id] ?? [100, 2];
      setProgress(pct, idx);

      const card = el('simCard');
      if (card) {
        const top = card.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    }

    
    el('btn-path-a')?.addEventListener('click', () => { currentPath = 'a'; showStep('step-1'); });
    el('btn-path-b')?.addEventListener('click', () => { currentPath = 'b'; showStep('step-1'); });

    
    el('back-1')?.addEventListener('click',  () => showStep('step-0'));
    el('back-2a')?.addEventListener('click', () => showStep('step-1'));
    el('back-2b')?.addEventListener('click', () => showStep('step-1'));

    
    document.querySelectorAll<HTMLElement>('.linea-card').forEach(card => {
      card.addEventListener('click', () => {
        linea = {
          id:     card.dataset.id!,
          tasa:   parseFloat(card.dataset.tasa!),
          display: card.dataset.display!,
          max:    parseInt(card.dataset.max!),
          nota:   card.dataset.nota!,
          nombre: card.dataset.nombre!,
        };

        
        const aPlazoRange = el('a-plazo-range') as HTMLInputElement | null;
        const aPlazoInput = el('a-plazo-input') as HTMLInputElement | null;
        const aHiddenPlazo = el('a-plazo') as HTMLInputElement | null;
        if (aPlazoRange && linea) {
          aPlazoRange.max = linea.max.toString();
          if (aPlazoInput) aPlazoInput.max = linea.max.toString();
          if (parseInt(aPlazoRange.value) > linea.max) {
            aPlazoRange.value = linea.max.toString();
            if (aHiddenPlazo) aHiddenPlazo.value = linea.max.toString();
            if (aPlazoInput) aPlazoInput.value = linea.max.toString();
          }
        }
        const aMaxLbl = el('a-max-lbl');
        if (aMaxLbl && linea) aMaxLbl.textContent = linea.max + ' meses';

        
        const bPlazoRange = el('b-plazo-range') as HTMLInputElement | null;
        const bPlazoInput = el('b-plazo-input') as HTMLInputElement | null;
        const bHiddenPlazo = el('b-plazo') as HTMLInputElement | null;
        if (bPlazoRange && linea) {
          bPlazoRange.max = linea.max.toString();
          if (bPlazoInput) bPlazoInput.max = linea.max.toString();
          if (parseInt(bPlazoRange.value) > linea.max) {
            bPlazoRange.value = linea.max.toString();
            if (bHiddenPlazo) bHiddenPlazo.value = linea.max.toString();
            if (bPlazoInput) bPlazoInput.value = linea.max.toString();
          }
        }
        const bMaxLbl = el('b-max-lbl');
        if (bMaxLbl && linea) bMaxLbl.textContent = linea.max + ' meses';

        
        const aTasa = el('a-tasa-disp'); if (aTasa && linea) aTasa.textContent = linea.display;
        const bTasa = el('b-tasa-disp'); if (bTasa && linea) bTasa.textContent = linea.display;
        const aNota = el('a-nota');      if (aNota && linea) aNota.textContent = linea.nota;
        const bNota = el('b-nota');      if (bNota && linea) bNota.textContent = linea.nota;

        updateA();
        updateB();
        showStep(currentPath === 'b' ? 'step-2b' : 'step-2a');
      });
    });

    // ════════════════════════════
    // RUTA A — monto + plazo → cuota
    // ════════════════════════════
    function updateA() {
      if (!linea) return;
      const monto = parseFloat((el('a-monto') as HTMLInputElement)?.value || '0');
      const plazo = parseInt((el('a-plazo') as HTMLInputElement)?.value || '0');
      const cuota = calcCuota(monto, linea.tasa, plazo);
      const cuotaEl = el('a-cuota');
      if (cuotaEl) cuotaEl.textContent = fCOP(cuota);
    }

    // Monto: slider → text
    const aMontoRange = el('a-monto-range') as HTMLInputElement | null;
    aMontoRange?.addEventListener('input', function (this: HTMLInputElement) {
      const hidden = el('a-monto') as HTMLInputElement | null;
      const txt = el('a-monto-text') as HTMLInputElement | null;
      if (hidden) hidden.value = this.value;
      if (txt) txt.value = '$' + fNum(parseInt(this.value));
      updateA();
    });

    // Monto: text → slider
    const aMontoText = el('a-monto-text') as HTMLInputElement | null;
    aMontoText?.addEventListener('input', function (this: HTMLInputElement) {
      const raw = parseMonto(this.value);
      const hidden = el('a-monto') as HTMLInputElement | null;
      if (hidden) hidden.value = raw.toString();
      if (aMontoRange) {
        const clamped = Math.min(Math.max(raw, parseInt(aMontoRange.min)), parseInt(aMontoRange.max));
        aMontoRange.value = clamped.toString();
      }
      updateA();
    });
    aMontoText?.addEventListener('blur', function (this: HTMLInputElement) {
      const min = aMontoRange ? parseInt(aMontoRange.min) : 500000;
      const max = aMontoRange ? parseInt(aMontoRange.max) : 50000000;
      const clamped = Math.min(Math.max(parseMonto(this.value) || min, min), max);
      this.value = '$' + fNum(clamped);
      const hidden = el('a-monto') as HTMLInputElement | null;
      if (hidden) hidden.value = clamped.toString();
      if (aMontoRange) aMontoRange.value = clamped.toString();
      updateA();
    });

    // Plazo A: slider → number input
    const aPlazoRange = el('a-plazo-range') as HTMLInputElement | null;
    aPlazoRange?.addEventListener('input', function (this: HTMLInputElement) {
      const hidden = el('a-plazo') as HTMLInputElement | null;
      const num = el('a-plazo-input') as HTMLInputElement | null;
      if (hidden) hidden.value = this.value;
      if (num) num.value = this.value;
      updateA();
    });

    // Plazo A: number input → slider
    const aPlazoInput = el('a-plazo-input') as HTMLInputElement | null;
    aPlazoInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === '-' || e.key === '+' || e.key === 'e') e.preventDefault();
    });
    aPlazoInput?.addEventListener('input', function (this: HTMLInputElement) {
      const maxVal = parseInt(this.max) || (linea ? linea.max : 60);
      const raw = parseInt(this.value);
      if (!isNaN(raw) && raw > maxVal) this.value = maxVal.toString();
      if (!isNaN(raw) && raw < 1)      this.value = '1';
      const val = Math.min(Math.max(parseInt(this.value) || 1, 1), maxVal);
      const hidden = el('a-plazo') as HTMLInputElement | null;
      if (hidden) hidden.value = val.toString();
      if (aPlazoRange) aPlazoRange.value = val.toString();
      updateA();
    });
    aPlazoInput?.addEventListener('blur', function (this: HTMLInputElement) {
      const maxVal = linea ? linea.max : 60;
      const val = Math.min(Math.max(parseInt(this.value) || 1, 1), maxVal);
      this.value = val.toString();
      const hidden = el('a-plazo') as HTMLInputElement | null;
      if (hidden) hidden.value = val.toString();
      if (aPlazoRange) aPlazoRange.value = val.toString();
      updateA();
    });

    // ════════════════════════════
    // RUTA B — cuota + plazo → monto
    // ════════════════════════════
    function updateB() {
      if (!linea) return;
      const cuota = parseFloat((el('b-cuota-hidden') as HTMLInputElement)?.value || '0');
      const plazo = parseInt((el('b-plazo') as HTMLInputElement)?.value || '0');
      const monto = calcMonto(cuota, linea.tasa, plazo);
      const montoEl = el('b-monto-max');
      if (montoEl) montoEl.textContent = fCOP(monto);
    }

    // Cuota B: slider → text
    const bCuotaRange = el('b-cuota-range') as HTMLInputElement | null;
    bCuotaRange?.addEventListener('input', function (this: HTMLInputElement) {
      const hidden = el('b-cuota-hidden') as HTMLInputElement | null;
      const txt = el('b-cuota-text') as HTMLInputElement | null;
      if (hidden) hidden.value = this.value;
      if (txt) txt.value = '$' + fNum(parseInt(this.value));
      updateB();
    });

    // Cuota B: text → slider
    const bCuotaText = el('b-cuota-text') as HTMLInputElement | null;
    bCuotaText?.addEventListener('input', function (this: HTMLInputElement) {
      const raw = parseMonto(this.value);
      const hidden = el('b-cuota-hidden') as HTMLInputElement | null;
      if (hidden) hidden.value = raw.toString();
      if (bCuotaRange) {
        const clamped = Math.min(Math.max(raw, parseInt(bCuotaRange.min)), parseInt(bCuotaRange.max));
        bCuotaRange.value = clamped.toString();
      }
      updateB();
    });
    bCuotaText?.addEventListener('blur', function (this: HTMLInputElement) {
      const min = bCuotaRange ? parseInt(bCuotaRange.min) : 50000;
      const max = bCuotaRange ? parseInt(bCuotaRange.max) : 5000000;
      const clamped = Math.min(Math.max(parseMonto(this.value) || min, min), max);
      this.value = '$' + fNum(clamped);
      const hidden = el('b-cuota-hidden') as HTMLInputElement | null;
      if (hidden) hidden.value = clamped.toString();
      if (bCuotaRange) bCuotaRange.value = clamped.toString();
      updateB();
    });

    // Plazo B: slider → number input
    const bPlazoRange = el('b-plazo-range') as HTMLInputElement | null;
    bPlazoRange?.addEventListener('input', function (this: HTMLInputElement) {
      const hidden = el('b-plazo') as HTMLInputElement | null;
      const num = el('b-plazo-input') as HTMLInputElement | null;
      if (hidden) hidden.value = this.value;
      if (num) num.value = this.value;
      updateB();
    });

    // Plazo B: number input → slider
    const bPlazoInput = el('b-plazo-input') as HTMLInputElement | null;
    bPlazoInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === '-' || e.key === '+' || e.key === 'e') e.preventDefault();
    });
    bPlazoInput?.addEventListener('input', function (this: HTMLInputElement) {
      const maxVal = parseInt(this.max) || (linea ? linea.max : 60);
      const raw = parseInt(this.value);
      if (!isNaN(raw) && raw > maxVal) this.value = maxVal.toString();
      if (!isNaN(raw) && raw < 1)      this.value = '1';
      const val = Math.min(Math.max(parseInt(this.value) || 1, 1), maxVal);
      const hidden = el('b-plazo') as HTMLInputElement | null;
      if (hidden) hidden.value = val.toString();
      if (bPlazoRange) bPlazoRange.value = val.toString();
      updateB();
    });
    bPlazoInput?.addEventListener('blur', function (this: HTMLInputElement) {
      const maxVal = linea ? linea.max : 60;
      const val = Math.min(Math.max(parseInt(this.value) || 1, 1), maxVal);
      this.value = val.toString();
      const hidden = el('b-plazo') as HTMLInputElement | null;
      if (hidden) hidden.value = val.toString();
      if (bPlazoRange) bPlazoRange.value = val.toString();
      updateB();
    });

    // Cálculo inicial
    updateA();
    updateB();
  }

  setupSimulador();
  document.addEventListener('astro:after-swap', setupSimulador);
</script>
