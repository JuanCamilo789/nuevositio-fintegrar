---
---

<section class="bg-[var(--color-navbar-bg)] overflow-hidden">
  <div class="relative w-full overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] border border-gray-100 rounded-full -translate-y-[60%] pointer-events-none"></div>

    <div class="relative z-10 px-8 py-16 md:px-16 md:py-20 flex flex-col items-center">
      
      <div class="flex flex-col items-center max-w-xl mx-auto text-center space-y-6">
        <p class="text-gray-800 text-lg md:text-xl font-medium leading-relaxed">
          " With our combined expertise and passion for celebration, we promise to deliver a summer party that's <span class="text-gray-400">not just an event</span>, a vibrant memory etched in the warmth of the sun. "
        </p>

        <div class="flex items-center gap-3 pt-2">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop" alt="Trisha Woodward" class="w-10 h-10 rounded-full object-cover shadow-sm" />
          <div class="text-left">
            <h4 class="text-sm font-bold text-gray-900">Trisha Woodward</h4>
            <p class="text-xs text-gray-400 font-medium">Co-founder at runaway</p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 pt-4">
          <div class="w-1 h-1 rounded-full bg-gray-300"></div>
          <div class="w-1 h-1 rounded-full bg-gray-800"></div>
          <div class="w-1 h-1 rounded-full bg-gray-300"></div>
          <div class="w-1 h-1 rounded-full bg-gray-300"></div>
        </div>
      </div>

      <div class="relative w-full mt-16 mb-24 flex justify-center items-center">
        <h1 class="font-sans text-[clamp(4rem,11vw,11rem)] font-bold tracking-tighter leading-none text-gray-950 uppercase whitespace-nowrap">
          SOMOS-FINTEGRAR
        </h1>

        <div class="absolute left-[5%] sm:left-[15%] bottom-[-20%] sm:bottom-[-30%] w-48 h-48 sm:w-64 sm:h-64 rounded-3xl overflow-hidden shadow-2xl rotate-[-2deg] transition-transform hover:rotate-0 duration-300 z-20">
          <img src="/assets/img/banner1.webp" alt="Summer pool party" class="w-full h-full object-cover" />
        </div>

        <div class="absolute right-[5%] sm:right-[15%] top-[-10%] sm:top-[-20%] w-40 h-48 sm:w-56 sm:h-64 rounded-3xl overflow-hidden shadow-xl rotate-[3deg] transition-transform hover:rotate-0 duration-300 z-20">
          <img src="/assets/img/banner2.webp" alt="Surfboards" class="w-full h-full object-cover" />
        </div>
      </div>

    </div>
  </div>
</section>
