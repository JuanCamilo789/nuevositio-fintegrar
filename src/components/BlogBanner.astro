---
const cards = [
  {
    title: "Blog Davivienda",
    desc: "Descubra las últimas tendencias económicas y nuestro compromiso con la sostenibilidad.",
    btnText: "Conocer el Blog",
    btnClass: "bg-[var(--color-red-bright)] hover:bg-[var(--color-red-deep)]",
    img: "https://images.unsplash.com/photo-1564564321837-a57b7070ac4f?q=80&w=600&auto=format&fit=crop",
    blob1: "bg-[var(--color-slate)]",
    blob2: "bg-[var(--color-border-faint)]"
  },
  {
    title: "Novedades",
    desc: "Entérese de los nuevos productos y beneficios que tenemos preparados para usted.",
    btnText: "Ver Novedades",
    btnClass: "bg-indigo-600 hover:bg-indigo-700",
    img: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=600&auto=format&fit=crop",
    blob1: "bg-indigo-500",
    blob2: "bg-blue-100"
  },
  {
    title: "Asistencia",
    desc: "Centro de apoyo rápido, asesoría en línea y preguntas frecuentes 24/7.",
    btnText: "Buscar Ayuda",
    btnClass: "bg-teal-600 hover:bg-teal-700",
    img: "https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=600&auto=format&fit=crop",
    blob1: "bg-teal-500",
    blob2: "bg-emerald-100"
  },
  {
    title: "Eventos",
    desc: "Participe en nuestros próximos seminarios web y charlas de educación financiera.",
    btnText: "Inscribirse",
    btnClass: "bg-orange-500 hover:bg-orange-600",
    img: "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?q=80&w=600&auto=format&fit=crop",
    blob1: "bg-orange-400",
    blob2: "bg-amber-100"
  }
];
---

<section class="py-24 bg-[var(--color-surface-faint)] overflow-hidden">
  
  <div class="mb-12 px-4 max-w-7xl mx-auto">
    <h2 class="font-display" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);margin-bottom:0.5rem;">Explora Nuestros Recursos</h2>
    <p class="text-gray-500">Desliza para descubrir todo lo que tenemos para ti</p>
  </div>

  <div class="relative flex overflow-x-hidden w-full group pause-on-hover">
    
    <div class="flex animate-marquee gap-8 px-4 w-max shrink-0">
      {cards.map((card) => (
        <div class="relative w-[85vw] sm:w-[500px] shrink-0 mt-8 mb-4">
          
          <div class="absolute inset-0 bg-white rounded-[2rem] shadow-[0_15px_50px_rgba(var(--color-black-rgb), 0.06)] overflow-hidden border border-white/50">
            <div class={`absolute -top-[100px] -left-[100px] sm:-top-[150px] sm:-left-[150px] w-[350px] sm:w-[450px] h-[350px] sm:h-[450px] ${card.blob2} rounded-full opacity-90`}></div>
            <div class={`absolute -bottom-[80px] -left-[100px] sm:-bottom-[120px] sm:-left-[150px] w-[300px] sm:w-[400px] h-[300px] sm:h-[400px] ${card.blob1} rounded-[40%] transform rotate-12`}></div>
          </div>

          <div class="relative flex flex-col sm:flex-row items-center min-h-[340px] z-10">
            
            <div class="w-full sm:w-[45%] relative h-[250px] sm:h-full flex justify-center sm:justify-start">
               <img 
                  src={card.img} 
                  alt={card.title} 
                  class="absolute bottom-0 sm:-bottom-0 left-1/2 sm:left-[10%] -translate-x-1/2 sm:-translate-x-0 h-[320px] sm:h-[400px] object-cover mix-blend-multiply pointer-events-none drop-shadow-lg"
               />
            </div>

            <div class="w-full sm:w-[55%] p-6 sm:py-12 sm:pr-10 sm:pl-0 flex flex-col justify-center items-center sm:items-end text-center sm:text-right">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-slate-dark)] mb-4 tracking-tight">
                {card.title}
              </h2>
              <p class="text-gray-600 font-medium leading-relaxed max-w-sm mb-6 text-sm sm:text-base">
                {card.desc}
              </p>
              <a href="#" class={`${card.btnClass} text-white font-bold py-3 px-6 rounded-full hover:scale-105 hover:shadow-lg transition-all duration-300 text-sm whitespace-nowrap`}>
                {card.btnText}
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>

    <div class="flex animate-marquee gap-8 px-4 w-max shrink-0" aria-hidden="true">
      {cards.map((card) => (
        <div class="relative w-[85vw] sm:w-[500px] shrink-0 mt-8 mb-4">
          <div class="absolute inset-0 bg-white rounded-[2rem] shadow-[0_15px_50px_rgba(var(--color-black-rgb), 0.06)] overflow-hidden border border-white/50">
            <div class={`absolute -top-[100px] -left-[100px] sm:-top-[150px] sm:-left-[150px] w-[350px] sm:w-[450px] h-[350px] sm:h-[450px] ${card.blob2} rounded-full opacity-90`}></div>
            <div class={`absolute -bottom-[80px] -left-[100px] sm:-bottom-[120px] sm:-left-[150px] w-[300px] sm:w-[400px] h-[300px] sm:h-[400px] ${card.blob1} rounded-[40%] transform rotate-12`}></div>
          </div>
          <div class="relative flex flex-col sm:flex-row items-center min-h-[340px] z-10">
            <div class="w-full sm:w-[45%] relative h-[250px] sm:h-full flex justify-center sm:justify-start">
               <img src={card.img} alt={card.title} class="absolute bottom-0 sm:-bottom-0 left-1/2 sm:left-[10%] -translate-x-1/2 sm:-translate-x-0 h-[320px] sm:h-[400px] object-cover mix-blend-multiply pointer-events-none drop-shadow-lg" />
            </div>
            <div class="w-full sm:w-[55%] p-6 sm:py-12 sm:pr-10 sm:pl-0 flex flex-col justify-center items-center sm:items-end text-center sm:text-right">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-slate-dark)] mb-4 tracking-tight">{card.title}</h2>
              <p class="text-gray-600 font-medium leading-relaxed max-w-sm mb-6 text-sm sm:text-base">{card.desc}</p>
              <a href="#" class={`${card.btnClass} text-white font-bold py-3 px-6 rounded-full hover:scale-105 hover:shadow-lg transition-all duration-300 text-sm whitespace-nowrap`}>
                {card.btnText}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(calc(-100% - 2rem)); } /* -2rem compensates for the gap-8 (32px) between the two tracks */
  }
  
  .animate-marquee {
    animation: marquee 25s linear infinite;
  }
  
  .pause-on-hover:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>
