---

<section class="cv-section" aria-labelledby="cv-title">
  <div class="max-w-7xl mx-auto px-6">

    <div class="cv-grid" id="cvGrid">
      {convenios.map((c) => (
        <button
          type="button"
          class="cv-tile"
          data-drawer-target={`drawer-${c.id}`}
          aria-label={`Ver detalle de ${c.nombre}`}
        >
          <img src={c.logo} alt={`Logo ${c.nombre}`} loading="lazy" />
        </button>
      ))}
    </div>

    <div class="cv-allies reveal">
      <h3 class="cv-allies-title">Entidades aliadas</h3>
      <div class="cv-grid cv-allies-row">
        {entidadesAliadas.map((e) => (
          <div class="cv-tile cv-tile--mono">
            {e.logo ? (
              <img src={e.logo} alt={`Logo ${e.nombre}`} loading="lazy" />
            ) : (
              <span class="cv-tile-placeholder" role="img" aria-label={`Logo ${e.nombre}`}>
                {e.nombre.split(' ').map((palabra, i) => (
                  <>
                    {i > 0 && <br />}
                    {palabra}
                  </>
                ))}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<div class="cv-drawer-backdrop" id="cvDrawerBackdrop"></div>

{convenios.map((c) => (
  <aside
    class="cv-drawer"
    id={`drawer-${c.id}`}
    role="dialog"
    aria-modal="true"
    aria-label={`Detalle del convenio ${c.nombre}`}
  >
    <div class="cv-drawer-banner">
      <button type="button" class="cv-drawer-close" data-drawer-close aria-label="Cerrar">
        <Icon name="tabler:x" class="w-4 h-4" aria-hidden="true" />
      </button>
    </div>
    <div class="cv-drawer-header">
      <div class="cv-drawer-logo">
        <img src={c.logo} alt={`Logo ${c.nombre}`} />
      </div>
      <h3 class="cv-drawer-titulo">{c.nombre}</h3>
    </div>
    <div class="cv-drawer-body">
      <p class="cv-drawer-desc">{c.descripcion}</p>
      <div class="cv-drawer-como">
        <div class="cv-drawer-como-title">
          <Icon name="tabler:info-circle" class="w-4 h-4" aria-hidden="true" />
          Cómo acceder al beneficio
        </div>
        <p>{c.comoUsar}</p>
      </div>
      <a href="mailto:bienestarsocial@fintegrar.com" class="btn btn-primary btn-sm cv-drawer-btn">
        <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
        Más información
      </a>
    </div>
  </aside>
))}

<style>
  .cv-section {
    background: var(--color-navbar-bg);
    padding: 4rem 0 6rem;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .cv-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .cv-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .cv-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    background: var(--color-white);
    border: 1px solid var(--color-surface);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    cursor: pointer;
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
    font-family: inherit;
  }
  .cv-tile:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    border-color: transparent;
  }


  .cv-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.25s, opacity 0.25s;
  }
  .cv-tile:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  .cv-tile--mono img {
    filter: invert(1) grayscale(1);
    opacity: 0.55;
  }
  .cv-tile--mono:hover img {
    filter: invert(1) grayscale(1);
    opacity: 1;
  }

  .cv-tile-placeholder {
    font-family: var(--ff-sans);
    font-size: 1.0625rem;
    font-weight: var(--fw-extrabold);
    line-height: var(--lh-115);
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .cv-allies {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-surface);
    text-align: center;
  }
  .cv-allies-title {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }
  .cv-allies-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
  }
  .cv-allies-row .cv-tile {
    flex: 0 0 calc((100% - 1 * 1rem) / 2);
  }
  @media (min-width: 640px) {
    .cv-allies-row .cv-tile { flex-basis: calc((100% - 2 * 1rem) / 3); }
  }
  @media (min-width: 1024px) {
    .cv-allies-row .cv-tile { flex-basis: calc((100% - 3 * 1rem) / 4); }
  }

  .cv-drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(var(--color-ink-rgb), 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }
  .cv-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .cv-drawer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-height: 40vh;
    background: var(--color-white);
    z-index: 1001;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    overflow-y: auto;
    box-shadow: none;
  }
  .cv-drawer.is-open {
    transform: translateY(0);
    box-shadow: 0 -20px 50px rgba(var(--color-black-rgb), 0.25);
  }

  @media (min-width: 640px) {
    .cv-drawer {
      left: auto;
      top: auto;
      bottom: 2rem;
      right: 2rem;
      width: min(400px, calc(100vw - 4rem));
      max-height: calc(100vh - 4rem);
      border-radius: var(--radius-lg);
      transform: translateY(16px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.35s;
    }
    .cv-drawer.is-open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      box-shadow: 0 20px 50px rgba(var(--color-black-rgb), 0.25);
    }
  }

  .cv-drawer-banner {
    position: relative;
    height: 64px;
    background: var(--color-brand-purple);
  }
  .cv-drawer-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(var(--color-white-rgb), 0.2);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-white);
  }

  .cv-drawer-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.75rem;
    margin-top: -20px;
  }
  .cv-drawer-logo {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(var(--color-black-rgb), 0.18);
    padding: 0.5rem;
  }
  .cv-drawer-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .cv-drawer-body {
    padding: 1.5rem 1.75rem 2rem;
  }
  .cv-drawer-titulo {
    font-size: 1.25rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    margin-top: 1.75rem;
  }
  .cv-drawer-desc {
    font-size: 0.9375rem;
    color: var(--color-ink);
    opacity: 0.7;
    line-height: var(--lh-165);
    margin-bottom: 1.5rem;
  }
  .cv-drawer-como {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding: 1rem 1.125rem;
    margin-bottom: 1.5rem;
  }
  .cv-drawer-como-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }
  .cv-drawer-como p {
    font-size: 0.8125rem;
    color: var(--color-ink);
    opacity: 0.7;
    line-height: var(--lh-155);
  }
  .cv-drawer-btn {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 639px) {
    .cv-section { padding: 2.5rem 0 4rem; }
    .cv-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  function initConveniosDirectorio() {
    const grid = document.getElementById('cvGrid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.cv-tile'));
    const backdrop = document.getElementById('cvDrawerBackdrop');
    const drawers = Array.from(document.querySelectorAll<HTMLElement>('.cv-drawer'));

    function closeDrawer() {
      drawers.forEach((d) => d.classList.remove('is-open'));
      backdrop?.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const targetId = card.dataset.drawerTarget;
        if (!targetId) return;
        const drawer = document.getElementById(targetId);
        if (!drawer) return;
        drawer.classList.add('is-open');
        backdrop?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    });

    backdrop?.addEventListener('click', closeDrawer);
    drawers.forEach((drawer) => {
      drawer.querySelector('[data-drawer-close]')?.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
  }

  initConveniosDirectorio();
  document.addEventListener('astro:after-swap', initConveniosDirectorio);
</script>
