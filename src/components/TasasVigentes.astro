---
import { Icon } from 'astro-icon/components';
import { fechaActualizacion, cdtCondiciones, creditos } from '../data/tasas';
---

<section class="tasas-section" aria-labelledby="tasas-title">
  <div class="max-w-7xl mx-auto px-6">
    <div class="section-header reveal">
      <div>
        <h2
          id="tasas-title"
          class="font-display"
          style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);"
        >
          CDAT y líneas de crédito
        </h2>
      </div>
      <p class="section-header-aside">
        Tasas informativas sujetas a cambio sin previo aviso, expresadas en Mes
        Vencido (M.V.) según el producto.
      </p>
    </div>

    <div class="cdt-panel reveal">
      <div class="cdt-panel-head">
        <div class="cdt-panel-heading">
          <div class="cdt-icon">
            <Icon name="tabler:wallet" class="w-5 h-5" aria-hidden="true" />
          </div>
          <div>
            <h3 class="cdt-titulo">CDAT — Certificado de Depósito de Ahorro a Término</h3>
            <p class="cdt-subtitulo">Invierta su dinero con excelente rentabilidad y seguridad</p>
          </div>
        </div>
        <span class="cdt-updated">
          <Icon name="tabler:clock" class="w-3.5 h-3.5" aria-hidden="true" />
          Actualizado {fechaActualizacion}
        </span>
      </div>

      <div class="cdt-ticker">
        {cdtCondiciones.map((c) => (
          <div class={`cdt-tile${c.destacado ? ' cdt-tile--destacado' : ''}`}>
            {c.destacado && <span class="cdt-badge">Personalizada</span>}
            <div class="cdt-tile-plazo">{c.label}</div>
            <div class="cdt-tile-tasa">{c.valor}</div>
          </div>
        ))}
      </div>
      <p class="cdt-nota">
        Usted elige el plazo, la periodicidad de pago de los intereses y la
        forma de entrega. Consulte con un asesor para conocer la tasa
        aplicable a su monto y plazo.
      </p>
    </div>

    <div class="creditos-panel card-base reveal reveal-delay-1">
      <div class="creditos-panel-head">
        <div class="cdt-icon">
          <Icon name="tabler:credit-card" class="w-5 h-5" aria-hidden="true" />
        </div>
        <h3 class="cdt-titulo">Líneas de crédito</h3>
      </div>

      <div class="creditos-table">
        <div class="creditos-row creditos-row--head" aria-hidden="true">
          <span>Producto</span>
          <span class="creditos-col-modalidad">Modalidad</span>
          <span class="creditos-col-tasa">Tasa</span>
        </div>
        {creditos.map((c) => (
          <div class="creditos-row">
            <span class="creditos-nombre">
              <Icon name={c.icon} class="w-4 h-4" aria-hidden="true" />
              {c.nombre}
            </span>
            <span class="creditos-col-modalidad creditos-modalidad">{c.modalidad}</span>
            <span class={`creditos-col-tasa creditos-tasa${c.muted ? ' creditos-tasa--muted' : ''}`}>
              {c.tasa}
            </span>
          </div>
        ))}
      </div>
    </div>

    <p class="tasas-footnote">
      * Tasas de referencia. Para conocer la tasa aplicable a su caso particular,
      consulte con un asesor o revise las condiciones al momento de la solicitud.
    </p>
  </div>
</section>

<style>
  .tasas-section {
    background: var(--color-navbar-bg);
    padding: 6rem 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4rem;
    margin-bottom: 2.5rem;
  }
  .section-header-aside {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.55;
    line-height: var(--lh-170);
    max-width: 340px;
    flex-shrink: 0;
  }

  .cdt-panel {
    position: relative;
    background: var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.25rem 2.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .cdt-panel::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-brand);
  }

  .cdt-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .cdt-panel-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cdt-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(var(--color-white-rgb), 0.08);
    color: var(--color-brand-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .creditos-panel .cdt-icon {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .cdt-titulo {
    font-size: 1rem;
    font-weight: var(--fw-bold);
    color: var(--color-white);
    line-height: var(--lh-130);
  }
  .creditos-panel .cdt-titulo {
    color: var(--color-ink);
  }

  .cdt-subtitulo {
    font-size: 0.8125rem;
    color: rgba(var(--color-white-rgb), 0.5);
    margin-top: 2px;
  }

  .cdt-updated {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: rgba(var(--color-white-rgb), 0.4);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cdt-ticker {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(var(--color-white-rgb), 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cdt-tile {
    position: relative;
    background: var(--color-ink);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.2s;
  }

  .cdt-tile:hover {
    background: rgba(var(--color-white-rgb), 0.04);
  }

  .cdt-tile--destacado {
    background: rgba(var(--color-brand-yellow-rgb), 0.08);
  }
  .cdt-tile--destacado:hover {
    background: rgba(var(--color-brand-yellow-rgb), 0.12);
  }

  .cdt-badge {
    position: absolute;
    top: 0.625rem;
    right: 0.75rem;
    font-size: 0.6rem;
    font-weight: var(--fw-extrabold);
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-brand-yellow);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .cdt-tile-plazo {
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    color: rgba(var(--color-white-rgb), 0.5);
    text-transform: uppercase;
  }

  .cdt-tile-tasa {
    font-size: 1.5rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-white);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .cdt-tile--destacado .cdt-tile-tasa {
    color: var(--color-brand-yellow);
  }

  .cdt-nota {
    font-size: 0.8125rem;
    color: rgba(var(--color-white-rgb), 0.5);
    line-height: var(--lh-160);
    margin-top: 1.25rem;
    max-width: 640px;
  }

  .creditos-panel {
    padding: 2rem 2.25rem 1.25rem;
    box-shadow: var(--shadow-md);
  }

  .creditos-panel-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .creditos-table {
    display: flex;
    flex-direction: column;
  }

  .creditos-row {
    display: grid;
    grid-template-columns: 1.4fr 1.4fr 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0.75rem;
    margin: 0 -0.75rem;
    border-bottom: 1px solid var(--color-surface);
    border-radius: var(--radius-sm);
    transition: background 0.15s;
  }
  .creditos-row:last-child {
    border-bottom: none;
  }
  .creditos-row:not(.creditos-row--head):hover {
    background: var(--color-surface);
  }

  .creditos-row--head {
    padding-top: 0;
    padding-bottom: 0.75rem;
    font-size: 0.7rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.4;
  }

  .creditos-nombre {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }
  .creditos-nombre svg {
    color: var(--color-ink);
    opacity: 0.5;
    flex-shrink: 0;
  }

  .creditos-modalidad {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.55;
  }

  .creditos-tasa {
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .creditos-tasa--muted {
    font-weight: var(--fw-semibold);
    opacity: 0.45;
  }

  .creditos-col-tasa {
    text-align: right;
  }

  .tasas-footnote {
    font-size: 0.75rem;
    color: var(--color-ink);
    opacity: 0.45;
    line-height: var(--lh-160);
    margin-top: 1.25rem;
    max-width: 640px;
  }

  @media (max-width: 1023px) {
    .tasas-section {
      padding: 4.5rem 0;
    }
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .section-header-aside {
      max-width: none;
    }
    .cdt-ticker {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .tasas-section {
      padding: 3rem 0;
    }
    .cdt-panel {
      padding: 1.5rem;
    }
    .cdt-panel-head {
      flex-direction: column;
      gap: 0.75rem;
    }
    .cdt-ticker {
      grid-template-columns: repeat(2, 1fr);
    }
    .creditos-panel {
      padding: 1.5rem;
    }
    .creditos-row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
      padding: 1rem 0;
    }
    .creditos-row--head {
      display: none;
    }
    .creditos-col-tasa {
      text-align: left;
    }
  }
</style>
