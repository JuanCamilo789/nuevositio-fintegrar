---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import developerLogo from "../assets/img/developers/logo-completo-negro.png";
---

<footer class="bg-white pt-20 pb-8 relative overflow-hidden" role="contentinfo">

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-10 pb-16 border-b border-slate-200">
      
      <!-- Columna 1: Marca y Contacto (span-4) -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-block mb-6" aria-label="Inicio">
          <img
            src="/assets/img/logo-menu.svg"
            alt="Cooperamigó Logo"
            class="h-9 w-auto"
          />
        </a>
        <p class="text-[0.9rem] text-slate-600 leading-relaxed mb-8 max-w-xs pr-4">
          Desde 1993 trabajamos día a día por el bienestar de nuestros asociados y sus familias, ofreciendo soluciones financieras responsables y cercanas.
        </p>
        
        <div class="flex flex-col gap-4 mb-8">
          <div class="flex items-center gap-3 text-[0.9rem] text-slate-600">
            <Icon name="tabler:map-pin" class="w-5 h-5 text-slate-600 shrink-0" aria-hidden="true" />
            <span>Calle 50 # 45 - 42 Oficina 120</span>
          </div>
          <a href="tel:+573054070612" class="flex items-center gap-3 text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
            <Icon name="tabler:phone" class="w-5 h-5 text-slate-600 shrink-0" aria-hidden="true" />
            <span>(604) 305 407 0612</span>
          </a>
          <a href="mailto:info@cooperamigo.coop" class="flex items-center gap-3 text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
            <Icon name="tabler:mail" class="w-5 h-5 text-slate-600 shrink-0" aria-hidden="true" />
            <span>info@cooperamigo.coop</span>
          </a>
        </div>
      </div>

      <!-- Columna 2: Institución (span-2) -->
      <div class="lg:col-span-2">
        <h3 class="text-[0.8rem] font-bold tracking-[0.15em] text-[#172B36] mb-6 uppercase flex flex-col items-start gap-3">
          Institución
        </h3>
        <ul class="flex flex-col gap-4">
          <li>
            <a href="/nosotros" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Quiénes somos
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/cuerpos-colegiados" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              C. de Administración
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/cuerpos-colegiados#junta" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Junta de Vigilancia
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/normatividad#informes" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Informe de Gestión
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/normatividad" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Normatividad
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/normatividad#sarlaft" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              SARLAFT
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Servicios (span-2) -->
      <div class="lg:col-span-2">
        <h3 class="text-[0.8rem] font-bold tracking-[0.15em] text-[#172B36] mb-6 uppercase flex flex-col items-start gap-3">
          Servicios
        </h3>
        <ul class="flex flex-col gap-4">
          <li>
            <a href="/creditos" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Líneas de crédito
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/nosotros#auxilios" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Beneficios sociales
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/nosotros#convenios" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Convenios
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/directorio" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Directorio
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
          <li>
            <a href="/pqrsf" class="group flex items-center justify-between text-[0.9rem] text-slate-600 hover:text-[#172B36] transition-colors">
              Radicar PQRSF
              <Icon name="tabler:chevron-right" class="w-4 h-4 text-slate-300 group-hover:text-[#172B36] transition-colors" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Accesos Directos (span-4) -->
      <div class="lg:col-span-4">
        <h3 class="text-[0.8rem] font-bold tracking-[0.15em] text-[#172B36] mb-6 uppercase flex flex-col items-start gap-3">
          Accesos Directos
        </h3>
        
        <div class="flex flex-col gap-4">
          <!-- Card Portal Asociados -->
          <a href="https://serviciosdigitales.cooperamigo.coop/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-5 rounded-md bg-slate-50 hover:bg-slate-100 transition-colors">
            <div class="w-12 h-12 rounded-sm bg-white border border-slate-100 flex items-center justify-center shrink-0">
              <Icon name="tabler:user" class="w-6 h-6 text-slate-600" />
            </div>
            <div class="flex-grow">
              <h4 class="text-[0.95rem] font-bold text-[#172B36] mb-1">Portal Asociados</h4>
              <p class="text-[0.8rem] text-slate-500 leading-tight">Gestione su información, consultas y solicitudes.</p>
            </div>
            <Icon name="tabler:arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-[#172B36] transition-colors shrink-0" />
          </a>

          <!-- Card PSE -->
          <a href="https://www.zonapagos.net/formulariosNV/?cod=BTK3a53qAPJK5dFzuUb9xoOMEi6GjxTVEz6jgj8WOG4kf7Z7mmbU2N6iG2sClbz5isF7xpuvz4ec%2FstAKWghYq2ihH6ea5Ab%2BfJXSgfBIPShwQxb9hHbzgY1XqGlsllif2sqgYeyszPfE%2Fq5SNonDhF9ZhqXm7OyDm%2Ba4lfdMItrvmOCQ5Py2gAq%2BvwFtoRMoNDPxeZKzglBDlEyqykoMK2kz6zyhc7dmjJO23oOZfDrWY5p5hfLu%2BH0xUIIx2%2F2zJLthSgc28WEY9rneC44s4DORf3zdoMntL1Bmxpscus%3D" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-5 rounded-md bg-slate-50 hover:bg-slate-100 transition-colors">
            <div class="w-12 h-12 rounded-sm bg-white border border-slate-100 flex items-center justify-center shrink-0">
              <Icon name="tabler:credit-card" class="w-6 h-6 text-slate-600" />
            </div>
            <div class="flex-grow">
              <h4 class="text-[0.95rem] font-bold text-[#172B36] mb-1">Pague en línea (PSE)</h4>
              <p class="text-[0.8rem] text-slate-500 leading-tight">Realice sus pagos de forma segura y rápida.</p>
            </div>
            <Icon name="tabler:arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-[#172B36] transition-colors shrink-0" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-8 flex flex-col lg:flex-row lg:flex-nowrap items-center justify-between gap-6 lg:gap-8">
      <!-- Copyright -->
      <div class="text-[0.8rem] text-slate-500 text-center lg:text-left order-3 lg:order-1 lg:whitespace-nowrap">
        © 2026 Cooperativa Multiactiva Luis Amigó. Todos los derechos reservados.
      </div>

      <!-- Links -->
      <div class="flex flex-wrap lg:flex-nowrap justify-center items-center gap-3 text-[0.8rem] text-slate-500 whitespace-nowrap order-1 lg:order-2">
        <a href="/aviso-privacidad" class="hover:text-[#172B36] transition-colors">Privacidad</a>
        <span class="text-slate-300">|</span>
        <a href="/politica-tratamiento-datos" class="hover:text-[#172B36] transition-colors">Políticas de Tratamiento</a>
        <span class="text-slate-300">|</span>
        <a href="/terminos-condiciones" class="hover:text-[#172B36] transition-colors">Términos y Condiciones</a>
      </div>

      <!-- Dev -->
      <div class="flex items-center gap-2 text-[0.7rem] text-slate-400 whitespace-nowrap order-2 lg:order-3">
        Desarrollado por
        <a href="https://centratechnologiesdc.com/" target="_blank" rel="noopener noreferrer" class="opacity-70 hover:opacity-100 transition-opacity">
          <Image src={developerLogo} alt="Centra Technologies DC" class="h-5 w-auto" />
        </a>
      </div>
    </div>
  </div>
</footer>
