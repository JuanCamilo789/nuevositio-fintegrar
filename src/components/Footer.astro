---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import developerLogo from "../assets/img/developers/logo-completo-blanco.png";
---

<!-- ════════════════════════════════════
     FOOTER
════════════════════════════════════ -->
<footer class="site-footer" role="contentinfo" data-dark-bg>
  <!-- Marca de agua: mismo isotipo en blanco que usa el hero -->
  <div class="footer-watermark" aria-hidden="true">
    <img src="/favicon.svg" alt="" loading="lazy" decoding="async" />
  </div>
  <div class="max-w-7xl mx-auto px-6" style="position:relative;z-index:1;">
    <div
      class="grid sm:grid-cols-2 lg:grid-cols-12 gap-12 pb-16"
      style="border-bottom:1px solid rgba(255,255,255,0.08);"
    >
      <!-- Marca -->
      <div class="lg:col-span-4">
        <div style="display:flex;align-items:center;margin-bottom:1.5rem;">
          <img
            src="/assets/img/logo-menu.svg"
            alt="Cooperamigó Logo"
            class="h-9 w-auto brightness-0 invert"
          />
        </div>
        <p
          style="font-size:0.875rem;color:rgba(255,255,255,0.6);line-height:1.8;margin-bottom:2rem;max-width:320px;"
        >
          Desde 1993, brindamos soluciones financieras y bienestar real para
          mejorar la calidad de vida de nuestros asociados.
        </p>
        <div
          style="display:flex;flex-direction:column;gap:0.875rem;margin-bottom:2rem;"
        >
          <a href="mailto:info@cooperamigo.coop" class="footer-contact-link">
            <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
            <span>info@cooperamigo.coop</span>
          </a>
          <div class="footer-contact-link" style="cursor:default;">
            <Icon name="tabler:map-pin" class="w-4 h-4" aria-hidden="true" />
            <span>Calle 50 65 - 42, Oficina 120 Medellín</span>
          </div>
        </div>

        <!-- Redes Sociales -->
        <div style="display:flex;align-items:center;gap:1rem;">
          <!-- Facebook: aún sin página, se muestra sin enlace por ahora -->
          <span class="footer-social-link" aria-label="Facebook">
            <Icon name="tabler:brand-facebook" class="w-5 h-5" />
          </span>
          <a
            href="https://www.instagram.com/cooperamigo.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="Síguenos en Instagram"
          >
            <Icon name="tabler:brand-instagram" class="w-5 h-5" />
          </a>
          <a
            href="https://www.linkedin.com/company/cooperativamultiactivaluisamigo/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="Síguenos en LinkedIn"
          >
            <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Institución -->
      <div class="lg:col-span-2">
        <div class="footer-col-title">Institución</div>
        <ul
          style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;"
        >
          <li><a href="/nosotros" class="footer-link">Quiénes somos</a></li>
          <li>
            <a href="/cuerpos-colegiados" class="footer-link"
              >Cuerpos Colegiados</a
            >
          </li>
          <li><a href="/normatividad" class="footer-link">Normatividad</a></li>
          <li><a href="/normatividad" class="footer-link">SARLAFT</a></li>
        </ul>
      </div>

      <!-- Servicios -->
      <div class="lg:col-span-2">
        <div class="footer-col-title">Servicios</div>
        <ul
          style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;"
        >
          <li><a href="/creditos" class="footer-link">Líneas de crédito</a></li>
          <li>
            <a href="/nosotros#auxilios" class="footer-link">Bienestar social</a
            >
          </li>
          <li>
            <a href="/nosotros#convenios" class="footer-link">Convenios</a>
          </li>
          <li><a href="/directorio" class="footer-link">Directorio</a></li>
          <li>
            <a href="/pqrsf" class="footer-link">Radicar PQRSF</a>
          </li>
        </ul>
      </div>

      <!-- Acceso rápido -->
      <div class="lg:col-span-4">
        <div class="footer-col-title">Accesos Directos</div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <a href="#" class="footer-quick-link">
            <Icon
              name="tabler:layout-dashboard"
              class="w-5 h-5"
              style="color:#FFC801;flex-shrink:0;"
              aria-hidden="true"
            />
            <div>
              <div style="font-size:0.875rem;font-weight:600;color:#fff;">
                Portal Asociados
              </div>
              <div style="font-size:0.75rem;color:rgba(255,255,255,0.5);">
                Consulte información de aportes y créditos
              </div>
            </div>
          </a>

          <a
            href="https://www.zonapagos.net/formulariosNV/?cod=BTK3a53qAPJK5dFzuUb9xoOMEi6GjxTVEz6jgj8WOG4kf7Z7mmbU2N6iG2sClbz5isF7xpuvz4ec%2FstAKWghYq2ihH6ea5Ab%2BfJXSgfBIPShwQxb9hHbzgY1XqGlsllif2sqgYeyszPfE%2Fq5SNonDhF9ZhqXm7OyDm%2Ba4lfdMItrvmOCQ5Py2gAq%2BvwFtoRMoNDPxeZKzglBDlEyqykoMK2kz6zyhc7dmjJO23oOZfDrWY5p5hfLu%2BH0xUIIx2%2F2zJLthSgc28WEY9rneC44s4DORf3zdoMntL1Bmxpscus%3D"
            class="footer-quick-link footer-quick-link--accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon
              name="tabler:device-mobile-dollar"
              class="w-5 h-5"
              style="color:#FFC801;flex-shrink:0;"
              aria-hidden="true"
            />
            <div>
              <div style="font-size:0.875rem;font-weight:600;color:#FFC801;">
                Pagos en línea (PSE)
              </div>
              <div style="font-size:0.75rem;color:rgba(255,200,1,0.45);">
                Pague su cuota de forma segura
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        <span class="copyright-desktop"
          >© 2026 Cooperativa Multiactiva Luis Amigó. Todos los derechos
          reservados.</span
        >
        <span class="copyright-mobile"
          >© 2026 Cooperamigó. All rights reserved.</span
        >
      </p>

      <div class="footer-bottom-right">
        <div class="footer-bottom-links">
          <a href="/aviso-privacidad" class="footer-bottom-link">Privacidad</a>
          <span class="footer-dot" aria-hidden="true">·</span>
          <a href="/politica-tratamiento-datos" class="footer-bottom-link"
            >Política Datos</a
          >
          <span class="footer-dot" aria-hidden="true">·</span>
          <a href="/terminos-condiciones" class="footer-bottom-link">Términos</a
          >
        </div>
        <span class="footer-bottom-sep"></span>
        <p
          class="footer-dev-text"
          style="display: flex; align-items: center; gap: 0.75rem;"
        >
          Sitio desarrollado por
          <a
            href="https://centratechnologiesdc.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-dev-link"
            style="display: flex;"
          >
            <Image
              src={developerLogo}
              alt="Centra Technologies DC"
              class="h-6 w-auto"
            />
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-col-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 1.5rem;
  }

  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-contact-link:hover {
    color: #fff;
  }

  .footer-link {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition:
      color 0.15s,
      transform 0.15s;
  }
  .footer-link:hover {
    color: #fff;
    transform: translateX(4px);
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.6);
    transition: all 0.2s ease;
  }
  .footer-social-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffc801;
    transform: translateY(-3px);
  }

  .footer-quick-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    padding: 1.125rem 1.25rem;
    text-decoration: none;
    transition:
      background 0.15s,
      transform 0.15s;
  }
  .footer-quick-link:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }
  .footer-quick-link--accent {
    background: rgba(255, 200, 1, 0.06);
  }
  .footer-quick-link--accent:hover {
    background: rgba(255, 200, 1, 0.12);
  }

  .footer-bottom-link {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.15s;
    padding: 0.5rem 0.25rem;
    display: inline-block;
  }
  .footer-bottom-link:hover {
    color: #fff;
  }

  .footer-erp-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.15s;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-erp-link:hover {
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.8);
  }

  .site-footer {
    background: #172b36;
    padding: 6rem 0 0;
    position: relative;
    /* Por encima del CTA (z-10): la marca de agua puede dibujarse sobre la
       costura entre ambas secciones sin verse recortada */
    z-index: 11;
  }

  /* Marca de agua: isotipo del favicon en blanco, asomándose desde la
     esquina inferior derecha del footer. El wrapper se extiende 20rem
     hacia arriba (sobre el CTA, mismo color) para que la figura no se
     moche en la costura; el overflow hidden recorta lados y fondo sin
     dejar espacio fantasma en el scroll. */
  .footer-watermark {
    position: absolute;
    top: -20rem;
    right: 0;
    left: 0;
    bottom: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .footer-watermark img {
    position: absolute;
    right: -10%;
    bottom: -18rem;
    height: 68rem;
    width: auto;
    transform: rotate(-10deg);
    /* El SVG trae sus propios colores; esto lo aplana a blanco puro */
    filter: brightness(0) invert(1);
    opacity: 0.012;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem 0;
  }
  .footer-copyright {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .footer-bottom-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .footer-dot {
    display: none;
  }
  .footer-bottom-sep {
    width: 1px;
    height: 12px;
    background: rgba(255, 255, 255, 0.1);
  }
  .footer-dev-text {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 767px) {
    .site-footer {
      padding: 4rem 0 0;
    }
    .footer-quick-link {
      padding: 0.875rem 1rem;
    }
    .footer-link {
      font-size: 0.875rem;
    }
  }

  .copyright-mobile {
    display: none;
  }

  @media (max-width: 639px) {
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.75rem;
    }
    .copyright-desktop {
      display: none;
    }
    .copyright-mobile {
      display: inline;
    }
    .footer-bottom-right {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    .footer-bottom-links {
      gap: 0.375rem;
    }
    .footer-dot {
      display: inline;
      color: rgba(255, 255, 255, 0.3);
    }
    .footer-bottom-sep {
      display: none;
    }
  }
  .footer-dev-link {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-dev-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }
</style>
