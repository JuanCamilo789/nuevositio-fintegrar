---
import { Icon } from 'astro-icon/components';
---

<!-- ════════════════════════════════════
     CTA BANNER
════════════════════════════════════ -->
<section class="cta-section" aria-label="Llamado a la acción" data-dark-bg>
  <div class="max-w-7xl mx-auto px-6">
    <div class="cta-inner reveal">

      <div class="cta-texto">
        <h2 class="cta-titulo">Construye tu futuro con Cooperamigó</h2>
        <p class="cta-desc">
          Únase a una comunidad sólida que trabaja por el bienestar de sus asociados.
          Descubra todos los beneficios de ser parte de nuestra cooperativa de aporte y crédito.
        </p>
      </div>

      <div class="cta-acciones">
        <a href="https://serviciosdigitales.cooperamigo.coop/" class="btn btn-accent btn-lg" target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:user-plus" class="w-5 h-5" aria-hidden="true" />
          Quiero ser asociado
        </a>
        <a href="https://serviciosdigitales.cooperamigo.coop/" class="btn btn-ghost-light" target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:credit-card" class="w-5 h-5" aria-hidden="true" />
          Solicitar crédito
        </a>
        <a href="/nosotros#auxilios" class="cta-link">
          Conocer beneficios
          <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .cta-section {
    /* Mismo color de fondo que el footer para que se fundan en un solo bloque */
    background: #172b36;
    padding: 8rem 0;
    position: relative;
    z-index: 10;
    /* overflow hidden recorta los círculos decorativos para que no se
       asomen fuera del banner */
    overflow: hidden;
  }

  /* Círculo decorativo de fondo */
  .cta-section::before {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(17, 76, 90, 0.25) 0%, transparent 70%);
    top: -150px;
    right: -100px;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .cta-inner {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
    }
  }

  .cta-texto {
    max-width: 820px;
  }

  .cta-titulo {
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    color: #fff;
    line-height: 1.15;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .cta-desc {
    font-size: 1.0625rem;
    color: rgba(241, 246, 244, 0.7);
    line-height: 1.7;
  }

  .cta-acciones {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.875rem;
    flex-shrink: 0;
    min-width: 280px;
  }

  .cta-acciones .btn {
    justify-content: center;
  }

  /* Acción terciaria: enlace de texto */
  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    padding: 0.5rem 0;
    transition: color 0.2s;
  }
  .cta-link:hover {
    color: #FFC801;
  }
  .cta-link:hover :global(svg) {
    transform: translateX(4px);
  }
  .cta-link :global(svg) {
    transition: transform 0.2s;
  }

  @media (max-width: 1023px) {
    .cta-section { padding: 6rem 0; }
  }
  @media (max-width: 767px) {
    .cta-section { padding: 3.5rem 0; }
    .cta-titulo { font-size: clamp(1.75rem, 6vw, 2.25rem); }
    .cta-desc { font-size: 0.9375rem; }
    .cta-acciones { min-width: 0; width: 100%; }
  }
</style>
