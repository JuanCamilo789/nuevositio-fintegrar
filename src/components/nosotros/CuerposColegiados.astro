<style>
  .cc-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0 6rem;
  }

  .cc-intro {
    margin: 0 0 2.5rem;
    text-align: left;
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.7;
    line-height: var(--lh-175);
  }

  .cc-org-title-main {
    font-family: var(--ff-heading);
    font-weight: var(--fw-extrabold);
    font-size: clamp(2rem, 2.6vw, 2.75rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
  }

  .cc-org-title-sub {
    font-family: var(--ff-heading);
    font-weight: var(--fw-regular);
    font-size: clamp(2rem, 2.6vw, 2.75rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
    margin-left: 0.4rem;
  }

  .cc-org-desc {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.65;
    line-height: var(--lh-150);
  }

  .cc-members {
    margin-top: 2.5rem;
  }

  .cc-members-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2rem;
  }

  .cc-members-title {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }

  .cc-members-sub {
    font-size: 0.9375rem;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .member-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3.5rem 0;
  }

  .member-card-head {
    text-align: center;
    max-width: 64rem;
    margin: 0 auto;
  }

  .member-card-body {
    min-width: 0;
  }

  .member-role-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .member-role {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    text-align: center;
    width: 17.5rem;
  }

  .member-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-md);
    background: var(--color-navbar-bg);
    border: 1px dashed rgba(var(--color-brand-purple-rgb), 0.35);
    color: rgba(var(--color-brand-purple-rgb), 0.4);
    margin-bottom: 0.25rem;
  }

  .member-photo svg {
    width: 42%;
    height: 42%;
  }

  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .member-role-suplente-spaced {
    margin-bottom: 0.75rem;
  }

  .member-photo-suplente {
    margin-top: 0.5rem;
  }

  .member-role-title {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-purple);
  }

  .member-role-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .member-role-suplente {
    font-size: 0.8125rem;
    color: var(--color-ink);
    opacity: 0.6;
    white-space: nowrap;
    margin-top: -0.1rem;
  }

  .member-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
  }

  .member-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    text-align: center;
    width: 17.5rem;
  }

  .member-list-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-purple);
  }

  .member-list-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .cc-section {
      padding: 3.5rem 0 4.5rem;
    }
  }

  @media (max-width: 767px) {
    .cc-section {
      padding: 2.5rem 0 3rem;
    }
    .member-card {
      gap: 1.5rem;
      padding: 1.75rem 0;
    }
    .member-role,
    .member-list li {
      width: 8rem;
    }
    .member-photo {
      width: 6rem;
      height: 6rem;
    }
  }

  .cc-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.21, 0.6, 0.35, 1),
      transform 0.6s cubic-bezier(0.21, 0.6, 0.35, 1);
    will-change: opacity, transform;
  }

  .cc-fade.cc-fade-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const ccFadeEls = document.querySelectorAll(".cc-fade");
  const ccFadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("cc-fade-visible", entry.isIntersecting);
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
  );
  ccFadeEls.forEach((el) => ccFadeObserver.observe(el));
</script>
