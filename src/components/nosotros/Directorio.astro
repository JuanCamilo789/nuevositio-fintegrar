---
const equipo = [
  {
    nombre: "Cindy Vanesa Olaya Hidalgo",
    cargo: "Gerente y Representante Legal",
    email: ["gerencia@fintegrar.com"],
    foto: "/assets/img/nosotros/equipo/11.webp",
  },
  {
    nombre: "Astrid Arroyave Mazo",
    cargo: "Auxiliar Administrativa",
    email: ["auxiliar@fintegrar.com"],
  },
  {
    nombre: "Francy Elena Gómez Vélez",
    cargo: "Auxiliar Comercial",
    email: ["auxiliar@fintegrar.com"],
  },
  {
    nombre: "Alba Luz Marín Mejía",
    cargo: "Oficial de Cumplimiento",
    email: ["sarlaft@fintegrar.com"],
    foto: "/assets/img/nosotros/equipo/13.webp",
  },
];
---

<section id="directorio" class="dir-section" aria-labelledby="dir-title">
  <h2 id="dir-title" class="sr-only">Nuestro Equipo de Trabajo</h2>
  <div class="max-w-7xl mx-auto px-6">
    <div class="dir-grid reveal">
      {
        equipo.map((p) => (
          <div class="dir-card">
            {p.foto ? (
              <div class="dir-photo">
                <img src={p.foto} alt={p.nombre} loading="lazy" />
              </div>
            ) : (
              <div class="dir-photo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
                  <path d="M4.5 19.5c1.5-3.5 4.5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </div>
            )}
            <span class="dir-card-name">{p.nombre}</span>
            <span class="dir-card-role">{p.cargo}</span>
            <span class="dir-card-emails">
              {p.email.map((e) => (
                <a href={`mailto:${e}`} class="dir-card-email">
                  {e}
                </a>
              ))}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir-section {
    background: var(--color-white);
    padding: 4rem 0;
  }

  .dir-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 15rem));
    justify-content: center;
    gap: 2.5rem 2rem;
  }

  .dir-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    text-align: center;
  }

  .dir-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-md);
    background: var(--color-navbar-bg);
    border: 1px dashed rgba(var(--color-brand-purple-rgb), 0.35);
    color: rgba(var(--color-brand-purple-rgb), 0.4);
    margin-bottom: 0.25rem;
  }

  .dir-photo svg {
    width: 42%;
    height: 42%;
  }

  .dir-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .dir-card-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .dir-card-role {
    font-size: 0.8125rem;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .dir-card-emails {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dir-card-email {
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-brand-purple);
    text-decoration: none;
  }
  .dir-card-email:hover {
    text-decoration: underline;
  }

  @media (max-width: 639px) {
    .dir-section {
      padding: 3rem 0;
    }
    .dir-grid {
      grid-template-columns: repeat(2, minmax(0, 8rem));
    }
    .dir-photo {
      width: 6rem;
      height: 6rem;
    }
    .dir-card-name {
      white-space: normal;
    }
  }
</style>
