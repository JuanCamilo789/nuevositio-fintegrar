---
// Textarea con label encima del campo, hermano de FloatingInput.
interface Props {
  id: string;
  label: string;
  class?: string;
  rows?: number;
  [key: string]: any;
}

const { id, label, class: className, rows = 4, ...rest } = Astro.props;
const requerido = "required" in rest && rest.required !== false;
---

<div class="ff-field">
  <label for={id}>{label}{requerido && <span class="ff-req" aria-hidden="true">*</span>}</label>
  <textarea id={id} class={className} rows={rows} {...rest}></textarea>
</div>

<style>
  .ff-field {
    margin-bottom: 1.125rem;
    display: flex;
    flex-direction: column;
  }
  .ff-field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }
  .ff-req {
    color: var(--color-danger);
    margin-left: 0;
  }
  .ff-field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(var(--color-navy-rgb), 0.1);
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.875rem;
    color: var(--color-ink);
    background: transparent;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    resize: none;
    height: 100px;
  }
  .ff-field textarea:focus {
    outline: none;
    background: var(--color-white);
    border-color: var(--color-accent-teal, var(--color-brand-teal));
  }
</style>
