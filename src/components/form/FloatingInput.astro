---
// Campo con label encima del input (negrita, oscuro, asterisco rojo si es
// requerido) e input rectangular simple. Reutilizable en cualquier
// formulario del sitio: cambiar el estilo acá lo cambia en todos los
// campos que usen este componente.
interface Props {
  id: string;
  label: string;
  type?: string;
  class?: string;
  [key: string]: any;
}

const { id, label, type = "text", class: className, ...rest } = Astro.props;
const requerido = "required" in rest && rest.required !== false;
---

<div class="ff-field">
  <label for={id}>{label}{requerido && <span class="ff-req" aria-hidden="true">*</span>}</label>
  <input id={id} type={type} class={className} {...rest} />
</div>

<style>
  .ff-field {
    margin-bottom: 1.125rem;
  }
  .ff-field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #172b36;
  }
  .ff-req {
    color: #dc2626;
    margin-left: 2px;
  }
  .ff-field input {
    width: 100%;
    height: 48px;
    box-sizing: border-box;
    padding: 0 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.9375rem;
    color: #172b36;
    background: #fff;
    font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .ff-field input:focus {
    outline: none;
    border-color: #114c5a;
    box-shadow: 0 0 0 3px rgba(17, 76, 90, 0.1);
  }

  /* Neutraliza el fondo amarillo/azul que el navegador aplica al
     autocompletar, para que el input prellenado se vea igual que uno
     escrito a mano — sin heredar estilos por defecto del navegador. */
  .ff-field input:-webkit-autofill,
  .ff-field input:-webkit-autofill:hover,
  .ff-field input:-webkit-autofill:focus {
    -webkit-text-fill-color: #172b36;
    -webkit-box-shadow: 0 0 0px 1000px #fff inset;
    box-shadow: 0 0 0px 1000px #fff inset;
    transition: background-color 9999s ease-in-out 0s;
  }
</style>
