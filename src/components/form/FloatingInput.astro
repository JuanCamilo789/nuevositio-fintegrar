---
// Campo con label encima del input (negrita, oscuro, asterisco rojo si es
// requerido) e input rectangular simple. Reutilizable en cualquier
// formulario del sitio: cambiar el estilo acá lo cambia en todos los
// campos que usen este componente.
interface Props {
  id: string;
  label: string;
  type?: string;
  class?: string;
  [key: string]: any;
}

const { id, label, type = "text", class: className, ...rest } = Astro.props;
const requerido = "required" in rest && rest.required !== false;
---

<div class="ff-field">
  <label for={id}>{label}{requerido && <span class="ff-req" aria-hidden="true">&nbsp;*</span>}</label>
  <input id={id} type={type} class={className} {...rest} />
  <slot name="error" />
</div>

<style>
  .ff-field {
    margin-bottom: 1.125rem;
    display: flex;
    flex-direction: column;
  }
  .ff-field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }
  .ff-req {
    color: var(--color-danger);
    margin-left: 0;
  }
  .ff-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(var(--color-navy-rgb), 0.1);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.875rem;
    color: var(--color-ink);
    background: transparent;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .ff-field input:focus {
    outline: none;
    background: var(--color-white);
    border-color: var(--color-accent-teal, var(--color-brand-teal));
  }

  /* Neutraliza el fondo amarillo/azul que el navegador aplica al autocompletar */
  .ff-field input:-webkit-autofill,
  .ff-field input:-webkit-autofill:hover,
  .ff-field input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-ink);
    -webkit-box-shadow: 0 0 0px 1000px transparent inset;
    box-shadow: 0 0 0px 1000px transparent inset;
    transition: background-color 9999s ease-in-out 0s;
  }
</style>
