---
import { Icon } from 'astro-icon/components';
---

<div class="unificada-card" style="border: 5px solid red !important;">
  <div class="unificada-content">
    <div style="background: red; color: white; padding: 10px; font-weight: bold; text-align: center; margin-bottom: 20px;">
      ESTOY EDITANDO ESTE COMPONENTE
    </div>
    <!-- Logo/Favicon -->
    <div class="mb-8">
      <img src="/favicon.svg" alt="Cooperamigó" class="w-12 h-12" />
    </div>

    <!-- Título y Descripción -->
    <h1 class="unificada-title">¡Te damos la bienvenida! <span style="color:red;">●</span></h1>
    <p class="unificada-subtitle">Accede a los trámites digitales o inicia tu proceso de vinculación como asociado de la Cooperativa. <span style="color:red;">●</span></p>

    <!-- Opciones -->
    <div class="unificada-grid">
      <button class="btn-unificado btn-unificado--active">
        <span class="btn-unificado-label">
          <em class="btn-unificado-num">1.</em> Soy asociado <span style="color:red;">●</span>
        </span>
        <span class="btn-unificado-circle">
          <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </span>
      </button>

      <button class="btn-unificado">
        <span class="btn-unificado-label">
          <em class="btn-unificado-num">2.</em> Quiero afiliarme <span style="color:red;">●</span>
        </span>
        <span class="btn-unificado-circle">
          <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </span>
      </button>
    </div>
  </div>
</div>
