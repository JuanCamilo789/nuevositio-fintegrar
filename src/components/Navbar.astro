<script>
  const siteHeader = document.getElementById('siteHeader');
  const menuBtn    = document.getElementById('mobileMenuToggle');
  const closeBtn   = document.getElementById('closeMenu');
  const mobileMenu = document.getElementById('mobileMenu');
  const backdrop   = document.getElementById('megaBackdrop');

  // ── Scroll shadow ──
  window.addEventListener('scroll', () => {
    siteHeader?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // ── Mobile menu ──
  function openMobile() {
    mobileMenu?.classList.add('open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMobile() {
    mobileMenu?.classList.remove('open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  menuBtn?.addEventListener('click', openMobile);
  closeBtn?.addEventListener('click', closeMobile);
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMobile));

  // ── Mega menu ──
  let activeTrigger: HTMLElement | null = null;
  let activePanel:   HTMLElement | null = null;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function openMega(trigger: HTMLElement) {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    if (activeTrigger && activeTrigger !== trigger) closeMega();
    const target = trigger.dataset.target;
    const panel  = document.getElementById(`mega-${target}`);
    if (!panel) return;
    trigger.setAttribute('aria-expanded', 'true');
    panel.classList.add('is-active');
    backdrop?.classList.add('is-active');
    activeTrigger = trigger;
    activePanel   = panel;
  }

  function closeMega() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    activeTrigger?.setAttribute('aria-expanded', 'false');
    activePanel?.classList.remove('is-active');
    backdrop?.classList.remove('is-active');
    activeTrigger = null;
    activePanel   = null;
  }

  function scheduleClose() {
    closeTimer = setTimeout(closeMega, 120);
  }

  document.querySelectorAll<HTMLElement>('.mega-trigger').forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      activeTrigger === trigger ? closeMega() : openMega(trigger);
    });
    trigger.addEventListener('mouseenter', () => openMega(trigger));
    trigger.addEventListener('mouseleave', scheduleClose);
  });

  document.querySelectorAll<HTMLElement>('.mega-panel').forEach((panel) => {
    panel.addEventListener('mouseenter', () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    });
    panel.addEventListener('mouseleave', scheduleClose);
  });

  backdrop?.addEventListener('click', closeMega);

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (activePanel && !activePanel.contains(t) && siteHeader && !siteHeader.contains(t)) {
      closeMega();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeMega(); closeMobile(); }
  });

  document.querySelectorAll('.mega-panel a').forEach((a) => {
    a.addEventListener('click', closeMega);
  });

  // ── Portal Asociados Dropdown ──
  const portalDropdownBtn = document.getElementById('portalDropdownBtn');
  const portalDropdown = document.getElementById('portalDropdown');
  const portalDropdownContainer = portalDropdownBtn?.parentElement;

  if (portalDropdownContainer && portalDropdownBtn && portalDropdown) {
    let closeTimeout: ReturnType<typeof setTimeout> | null = null;

    // Función para abrir el dropdown
    function openPortalDropdown() {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      portalDropdown.classList.remove('hidden');
      portalDropdownBtn.setAttribute('aria-expanded', 'true');
    }

    // Función para cerrar el dropdown con un pequeño delay
    function closePortalDropdown() {
      closeTimeout = setTimeout(() => {
        portalDropdown.classList.add('hidden');
        portalDropdownBtn.setAttribute('aria-expanded', 'false');
      }, 150);
    }

    // Eventos de hover
    portalDropdownContainer.addEventListener('mouseenter', openPortalDropdown);
    portalDropdownContainer.addEventListener('mouseleave', closePortalDropdown);

    // También mantener el comportamiento de clic por si acaso
    portalDropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = portalDropdown.classList.contains('hidden') === false;
      if (isOpen) {
        portalDropdown.classList.add('hidden');
        portalDropdownBtn.setAttribute('aria-expanded', 'false');
      } else {
        openPortalDropdown();
      }
    });
  }

  // Acordeón de Portal Asociados en menú móvil
  const portalAccordionBtn = document.getElementById('portalAccordionBtn');
  const portalAccordionContent = document.getElementById('portalAccordionContent');
  const portalAccordionIcon = document.getElementById('portalAccordionIcon');

  if (portalAccordionBtn && portalAccordionContent && portalAccordionIcon) {
    portalAccordionBtn.addEventListener('click', () => {
      const isOpen = !portalAccordionContent.classList.contains('hidden');
      if (isOpen) {
        portalAccordionContent.classList.add('hidden');
        portalAccordionIcon.style.transform = 'rotate(0deg)';
      } else {
        portalAccordionContent.classList.remove('hidden');
        portalAccordionIcon.style.transform = 'rotate(180deg)';
      }
    });
  }
</script>

