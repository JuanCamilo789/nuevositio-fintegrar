---
import { Icon } from 'astro-icon/components';
---

<!-- 
     SITE HEADER (topbar + navbar only — mega panels are siblings below)
 -->
<div id="siteHeader" class="site-header">

  <!-- ── Topbar (contact info only) ── -->
  <div class="topbar">
    <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
      <div class="flex items-center gap-5">
        <a href="mailto:info@cooperamigo.coop" class="topbar-item">
          <Icon name="tabler:mail" class="w-3.5 h-3.5" aria-hidden="true" />
          info@cooperamigo.coop
        </a>
        <span class="topbar-sep hidden lg:block"></span>
        <span class="topbar-item hidden lg:flex">
          <Icon name="tabler:map-pin" class="w-3.5 h-3.5" aria-hidden="true" />
          Calle 50 65 - 42, Oficina 120, Medellín
        </span>
        <span class="topbar-sep hidden xl:block"></span>
        <span class="topbar-item hidden xl:flex">
          <Icon name="tabler:clock" class="w-3.5 h-3.5" aria-hidden="true" />
          Lunes a jueves de 8 a 4:30 y viernes de 8 a 3:30 pm
        </span>
      </div>

      <!-- Social links (Right) -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="https://www.instagram.com/cooperamigo.co/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="Instagram">
          <Icon name="tabler:brand-instagram" class="w-4 h-4" />
        </a>
        <a href="https://www.linkedin.com/company/cooperativamultiactivaluisamigo/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="LinkedIn">
          <Icon name="tabler:brand-linkedin" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  <!-- ── Navbar ── -->
  <header class="navbar" id="navbar">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center justify-between lg:grid lg:grid-cols-3 h-16">

        <!-- Logo (Izquierda) -->
        <div class="flex justify-start">
          <a href="/" class="flex items-center flex-shrink-0" aria-label="Cooperamigó inicio">
            <img 
              src="/assets/img/logo-menu.svg" 
              alt="Cooperamigó Logo" 
              class="h-8 lg:h-9 w-auto"
              fetchpriority="high"
            >
          </a>
        </div>

        <!-- Desktop Nav (Centro) -->
        <nav class="hidden lg:flex items-center justify-center gap-1" aria-label="Navegación principal">
          <a href="/" class="nav-link active">Inicio</a>

          <button
            class="mega-trigger nav-link"
            data-target="nosotros"
            aria-expanded="false"
            aria-controls="mega-nosotros"
            aria-haspopup="true"
          >
            Nosotros
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="creditos"
            aria-expanded="false"
            aria-controls="mega-creditos"
            aria-haspopup="true"
          >
            Créditos
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="bienestar"
            aria-expanded="false"
            aria-controls="mega-bienestar"
            aria-haspopup="true"
          >
            Bienestar Social
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <a href="/directorio" class="nav-link">Directorio</a>
        </nav>

        <!-- CTA Buttons (Derecha) -->
        <div class="hidden lg:flex items-center justify-end gap-2">
          <!-- Portal Asociados Dropdown -->
          <div class="relative">
            <button class="btn btn-dark btn-sm flex items-center gap-1.5" id="portalDropdownBtn" aria-expanded="false" aria-haspopup="true">
              <Icon name="tabler:layout-dashboard" class="w-4 h-4" aria-hidden="true" />
              Portal Asociados
              <Icon name="tabler:chevron-down" class="w-3 h-3" aria-hidden="true" />
            </button>
            <div class="absolute right-0 top-full mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-100 py-2 z-50 hidden" id="portalDropdown">
              <a href="https://serviciosdigitales.cooperamigo.coop/" class="block px-4 py-2.5 text-sm text-gray-800 hover:bg-gray-50 transition-colors" target="_blank" rel="noopener noreferrer">
                <div class="flex items-center gap-2">
                  <Icon name="tabler:user-plus" class="w-4 h-4" aria-hidden="true" />
                  Solicitar afiliación
                </div>
              </a>
              <a href="https://serviciosdigitales.cooperamigo.coop/" class="block px-4 py-2.5 text-sm text-gray-800 hover:bg-gray-50 transition-colors" target="_blank" rel="noopener noreferrer">
                <div class="flex items-center gap-2">
                  <Icon name="tabler:credit-card" class="w-4 h-4" aria-hidden="true" />
                  Solicitar crédito
                </div>
              </a>
              <a href="https://serviciosdigitales.cooperamigo.coop/" class="block px-4 py-2.5 text-sm text-gray-800 hover:bg-gray-50 transition-colors" target="_blank" rel="noopener noreferrer">
                <div class="flex items-center gap-2">
                  <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
                  Consultar estado
                </div>
              </a>
            </div>
          </div>
          
          <a href="https://www.zonapagos.net/formulariosNV/?cod=BTK3a53qAPJK5dFzuUb9xoOMEi6GjxTVEz6jgj8WOG4kf7Z7mmbU2N6iG2sClbz5isF7xpuvz4ec%2FstAKWghYq2ihH6ea5Ab%2BfJXSgfBIPShwQxb9hHbzgY1XqGlsllif2sqgYeyszPfE%2Fq5SNonDhF9ZhqXm7OyDm%2Ba4lfdMItrvmOCQ5Py2gAq%2BvwFtoRMoNDPxeZKzglBDlEyqykoMK2kz6zyhc7dmjJO23oOZfDrWY5p5hfLu%2BH0xUIIx2%2F2zJLthSgc28WEY9rneC44s4DORf3zdoMntL1Bmxpscus%3D" class="btn btn-accent btn-sm" target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:device-mobile-dollar" class="w-4 h-4" aria-hidden="true" />
            Pagos PSE
          </a>
        </div>

        <!-- Mobile Toggle (Solo visible en móvil) -->
        <div class="lg:hidden flex justify-end">
          <button
            id="mobileMenuToggle"
            class="p-2 -mr-2 text-[#172B36] flex flex-col items-center"
            aria-label="Abrir menú"
            aria-expanded="false"
          >
            <Icon name="tabler:menu-2" class="w-7 h-7" id="iconMenu" />
            <Icon name="tabler:x" class="w-7 h-7 hidden" id="iconClose" />
            <span class="text-xs font-semibold mt-0">Menú</span>
          </button>
        </div>

      </div>
    </div>
  </header>

</div><!-- /site-header -->

<!-- ════════════════════════════════════
     MEGA PANELS (fixed, outside site-header for correct positioning)
════════════════════════════════════ -->

<!-- Nosotros -->
