          <a href="/" class="flex items-center flex-shrink-0" aria-label="Cooperamigó inicio">
            <img 
              src="/assets/img/logo-menu.svg" 
              alt="Cooperamigó Logo" 
              class="h-9 w-auto"
              fetchpriority="high"
            >
          </a>
        </div>

        <!-- Desktop Nav (Centro) -->
        <nav class="hidden lg:flex items-center justify-center gap-1" aria-label="Navegación principal">
          <a href="/" class="nav-link active">Inicio</a>

          <button
            class="mega-trigger nav-link"
            data-target="nosotros"
            aria-expanded="false"
            aria-controls="mega-nosotros"
            aria-haspopup="true"
          >
            Nosotros
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="creditos"
            aria-expanded="false"
            aria-controls="mega-creditos"
            aria-haspopup="true"
          >
            Créditos
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <button
            class="mega-trigger nav-link"
            data-target="bienestar"
            aria-expanded="false"
            aria-controls="mega-bienestar"
            aria-haspopup="true"
          >
            Bienestar Social
            <Icon name="tabler:chevron-down" class="mega-arrow w-3.5 h-3.5" aria-hidden="true" />
          </button>

          <a href="/directorio" class="nav-link">Directorio</a>
        </nav>

        <!-- CTA Buttons (Derecha) -->
        <div class="hidden lg:flex items-center justify-end gap-2">
          <a href="#" class="btn btn-dark btn-sm">
            <Icon name="tabler:layout-dashboard" class="w-4 h-4" aria-hidden="true" />
            Portal Asociados
          </a>
          <a href="https://www.zonapagos.net/formulariosNV/?cod=BTK3a53qAPJK5dFzuUb9xoOMEi6GjxTVEz6jgj8WOG4kf7Z7mmbU2N6iG2sClbz5isF7xpuvz4ec%2FstAKWghYq2ihH6ea5Ab%2BfJXSgfBIPShwQxb9hHbzgY1XqGlsllif2sqgYeyszPfE%2Fq5SNonDhF9ZhqXm7OyDm%2Ba4lfdMItrvmOCQ5Py2gAq%2BvwFtoRMoNDPxeZKzglBDlEyqykoMK2kz6zyhc7dmjJO23oOZfDrWY5p5hfLu%2BH0xUIIx2%2F2zJLthSgc28WEY9rneC44s4DORf3zdoMntL1Bmxpscus%3D" class="btn btn-accent btn-sm" target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:device-mobile-dollar" class="w-4 h-4" aria-hidden="true" />
            Pagos PSE
          </a>
        </div>

        <!-- Mobile Toggle (Solo visible en móvil) -->
        <div class="lg:hidden flex justify-end">
          <button
            id="mobileMenuToggle"
            class="p-2 -mr-2 text-[#172B36]"
            aria-label="Abrir menú"
            aria-expanded="false"
          >
            <Icon name="tabler:menu-2" class="w-7 h-7" id="iconMenu" />
            <Icon name="tabler:x" class="w-7 h-7 hidden" id="iconClose" />
          </button>
