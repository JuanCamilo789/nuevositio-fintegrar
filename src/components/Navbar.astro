        <a href="/nosotros#auxilios" class="mega-item">
          <div>
            <div class="mega-item-title">Calamidad doméstica</div>
            <div class="mega-item-sub">Apoyo en emergencias</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Convenios</div>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Salud y medicina</div>
            <div class="mega-item-sub">Clínicas, laboratorios, ópticas</div>
          </div>
        </a>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Turismo y recreación</div>
            <div class="mega-item-sub">Agencias y hoteles aliados</div>
          </div>
        </a>
        <a href="/convenios" class="mega-item">
          <div>
            <div class="mega-item-title">Tecnología</div>
            <div class="mega-item-sub">Equipos y telecomunicaciones</div>
          </div>
        </a>
      </div>

      <div class="mega-col">
        <div class="mega-col-title">Información</div>
        <a href="/nosotros#novedades" class="mega-item">
          <div>
            <div class="mega-item-title">Novedades</div>
            <div class="mega-item-sub">Noticias y comunicados</div>
          </div>
        </a>
        <a href="/nosotros#calendario" class="mega-item">
          <div>
            <div class="mega-item-title">Calendario de actividades</div>
            <div class="mega-item-sub">Jornadas y eventos del semestre</div>
          </div>
        </a>
      </div>

      <div class="mega-featured" style="background:var(--color-white);color:var(--color-ink);margin-left:1.5rem;border:1px solid var(--color-surface);">
        <div class="mega-featured-icon" style="background:var(--color-surface);border:1px solid var(--color-surface);">
          <Icon name="tabler:heart" class="w-5 h-5" style="color:var(--color-ink);" aria-hidden="true" />
        </div>
        <div class="mega-featured-title" style="color:var(--color-ink);">Bienestar para todos</div>
        <div class="mega-featured-sub" style="color:var(--color-ink); opacity: 0.6;">
          Programas y beneficios diseñados para mejorar la calidad de vida de nuestra comunidad.
        </div>
        <a href="/nosotros#auxilios" class="mega-featured-cta" style="background:var(--color-ink);color:var(--color-white);">
          Ver beneficios
          <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
        </a>
      </div>

    </div>
  </div>
</div>

