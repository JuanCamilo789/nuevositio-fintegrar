---
import { Icon } from 'astro-icon/components';
---

<!-- ════════════════════════════════════
     SITE HEADER (topbar + navbar only — mega panels are siblings below)
════════════════════════════════════ -->
<div id="siteHeader" class="site-header">

  <!-- ── Topbar (contact info only) ── -->
  <div class="topbar">
    <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
      <div class="flex items-center gap-5">
        <a href="mailto:info@cooperamigo.coop" class="topbar-item">
          <Icon name="tabler:mail" class="w-3.5 h-3.5" aria-hidden="true" />
          info@cooperamigo.coop
        </a>
        <span class="topbar-sep hidden lg:block"></span>
        <span class="topbar-item hidden lg:flex">
          <Icon name="tabler:map-pin" class="w-3.5 h-3.5" aria-hidden="true" />
          Calle 50 65 - 42, Oficina 120, Medellín
        </span>
        <span class="topbar-sep hidden xl:block"></span>
        <span class="topbar-item hidden xl:flex">
          <Icon name="tabler:clock" class="w-3.5 h-3.5" aria-hidden="true" />
          Lun–Vie 8:00 am – 5:00 pm
        </span>
      </div>

      <!-- Social links (Right) -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="https://www.instagram.com/cooperamigo.co/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="Instagram">
          <Icon name="tabler:brand-instagram" class="w-4 h-4" />
