        <a href="https://www.linkedin.com/company/cooperativamultiactivaluisamigo/" target="_blank" rel="noopener noreferrer" class="topbar-item hover:text-white transition-colors" aria-label="LinkedIn">
          <Icon name="tabler:brand-linkedin" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  <!-- ── Navbar ── -->
  <header class="navbar" id="navbar">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center justify-between lg:grid lg:grid-cols-3 h-16">

        <!-- Logo (Izquierda) -->
