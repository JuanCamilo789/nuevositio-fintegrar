<script>
  const siteHeader = document.getElementById('siteHeader');
  const menuBtn    = document.getElementById('mobileMenuToggle');
  const closeBtn   = document.getElementById('closeMenu');
  const mobileMenu = document.getElementById('mobileMenu');
  const backdrop   = document.getElementById('megaBackdrop');

  
  window.addEventListener('scroll', () => {
    siteHeader?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  
  function openMobile() {
    mobileMenu?.classList.add('open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMobile() {
    mobileMenu?.classList.remove('open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  menuBtn?.addEventListener('click', openMobile);
  closeBtn?.addEventListener('click', closeMobile);
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMobile));

  
  let activeTrigger: HTMLElement | null = null;
  let activePanel:   HTMLElement | null = null;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  function openMega(trigger: HTMLElement) {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    if (activeTrigger && activeTrigger !== trigger) closeMega();
    const target = trigger.dataset.target;
    const panel  = document.getElementById(`mega-${target}`);
    if (!panel) return;
    trigger.setAttribute('aria-expanded', 'true');
    panel.classList.add('is-active');
    backdrop?.classList.add('is-active');
    activeTrigger = trigger;
    activePanel   = panel;
  }

  function closeMega() {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    activeTrigger?.setAttribute('aria-expanded', 'false');
    activePanel?.classList.remove('is-active');
    backdrop?.classList.remove('is-active');
    activeTrigger = null;
    activePanel   = null;
  }

  function scheduleClose() {
    closeTimer = setTimeout(closeMega, 120);
  }

  document.querySelectorAll<HTMLElement>('.mega-trigger').forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      activeTrigger === trigger ? closeMega() : openMega(trigger);
    });
    trigger.addEventListener('mouseenter', () => openMega(trigger));
    trigger.addEventListener('mouseleave', scheduleClose);
  });

  document.querySelectorAll<HTMLElement>('.mega-panel').forEach((panel) => {
    panel.addEventListener('mouseenter', () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    });
    panel.addEventListener('mouseleave', scheduleClose);
  });

  backdrop?.addEventListener('click', closeMega);

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (activePanel && !activePanel.contains(t) && siteHeader && !siteHeader.contains(t)) {
      closeMega();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeMega(); closeMobile(); }
  });

  document.querySelectorAll('.mega-panel a').forEach((a) => {
    a.addEventListener('click', closeMega);
  });

</script>

