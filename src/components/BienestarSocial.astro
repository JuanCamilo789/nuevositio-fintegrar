---
import { Icon } from 'astro-icon/components';

const beneficios = [
  {
    icon: 'tabler:home-heart',
    titulo: 'Calamidad doméstica',
    desc: 'Facilitamos el acceso a servicios aliados para atender situaciones inesperadas en el entorno familiar.',
  },
  {
    icon: 'tabler:candle',
    titulo: 'Fallecimiento',
    desc: 'Ponemos a disposición convenios con entidades que ofrecen servicios especializados en estos momentos.',
  },
  {
    icon: 'tabler:baby-carriage',
    titulo: 'Nacimiento',
    desc: 'Celebramos cada nuevo integrante de su familia.',
  },
  {
    icon: 'tabler:calendar-event',
    titulo: 'Actividades culturales y recreativas',
    desc: 'Programas de bienestar, deporte y cultura durante el año.',
  },
];
---

<section class="bienestar-section" aria-labelledby="bienestar-title">
  <div class="max-w-7xl mx-auto px-6">
    <div class="bienestar-content reveal">
        <h2
          id="bienestar-title"
          class="font-display"
          style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--color-ink);line-height: var(--lh-120);margin-bottom:1.25rem;"
        >
          Beneficios que marcan la diferencia
        </h2>
        <p style="font-size:0.9375rem;color:var(--color-ink);opacity:0.8;line-height: var(--lh-175);margin-bottom:1.75rem;">
          Nuestro programa de bienestar social está orientado a gestionar, buscar y consolidar convenios que permitan a nuestros asociados acceder a una amplia gama de servicios y beneficios,
          contribuyendo al mejoramiento de su calidad de vida en diferentes ámbitos.
        </p>

        <div class="beneficios-list">
          {beneficios.map((b) => (
            <div class="beneficio-row">
              <div class="beneficio-icon">
                <Icon name={b.icon} class="w-5 h-5" aria-hidden="true" />
              </div>
              <div>
                <div class="beneficio-titulo">{b.titulo}</div>
                <div class="beneficio-desc">{b.desc}</div>
              </div>
            </div>
          ))}
        </div>


    </div>
  </div>
</section>

<style>
  .bienestar-section {
    background: var(--color-navbar-bg);
    padding: 8rem 0;
  }

  .bienestar-content {
    max-width: 1200px;
  }

  .beneficios-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 1023px) {
    .beneficios-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .beneficios-list { grid-template-columns: 1fr; }
  }
  .beneficio-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 4px rgba(var(--color-navy-rgb), 0.05);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .beneficio-row:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .beneficio-icon {
    width: 40px;
    height: 40px;
    background: rgba(var(--color-navy-rgb), 0.08);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-ink);
  }
  .beneficio-titulo {
    font-size: 0.875rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 2px;
  }
  .beneficio-desc {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-150);
  }

  @media (max-width: 1023px) {
    .bienestar-section { padding: 6rem 0; }
  }
  @media (max-width: 767px) {
    .bienestar-section { padding: 3.5rem 0; }
  }
</style>
