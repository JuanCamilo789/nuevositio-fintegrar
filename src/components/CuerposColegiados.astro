<style>
  .cc-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0 6rem;
  }

  .cc-intro {
    margin: 0 0 2.5rem;
    text-align: left;
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.7;
    line-height: var(--lh-175);
  }

  .cc-org-title-main {
    font-family: var(--ff-heading);
    font-weight: var(--fw-extrabold);
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
    white-space: nowrap;
  }

  .cc-org-title-sub {
    font-family: var(--ff-heading);
    font-weight: var(--fw-regular);
    font-size: clamp(1.625rem, 2.6vw, 2.125rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
    white-space: nowrap;
  }

  .cc-members {
    margin-top: 2.5rem;
  }

  .cc-members-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2rem;
  }

  .cc-members-title {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }

  .cc-members-sub {
    font-size: 0.9375rem;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .member-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .member-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 5rem 3rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .member-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .member-card-head {
    flex-shrink: 0;
    width: 23rem;
    text-align: right;
  }

  .member-role-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .member-role {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .member-role-title {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-purple);
  }

  .member-role-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }

  .member-role-suplente {
    font-size: 0.8125rem;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .member-list {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .member-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .member-list-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-purple);
  }

  .member-list-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .cc-section {
      padding: 3.5rem 0 4.5rem;
    }
  }

  @media (max-width: 767px) {
    .cc-section {
      padding: 2.5rem 0 3rem;
    }
    .member-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.75rem;
    }
    .member-card-head {
      width: auto;
      text-align: left;
    }
    .member-role-grid,
    .member-list {
      width: 100%;
      grid-template-columns: 1fr;
    }
  }

  .cc-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.21, 0.6, 0.35, 1),
      transform 0.6s cubic-bezier(0.21, 0.6, 0.35, 1);
    will-change: opacity, transform;
  }

  .cc-fade.cc-fade-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const ccFadeEls = document.querySelectorAll(".cc-fade");
  const ccFadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("cc-fade-visible", entry.isIntersecting);
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
  );
  ccFadeEls.forEach((el) => ccFadeObserver.observe(el));
</script>
