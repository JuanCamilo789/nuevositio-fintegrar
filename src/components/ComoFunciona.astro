---
import { Icon } from 'astro-icon/components';

// Geometría real del círculo: los pines se calculan con trigonometría
// (no con porcentajes a ojo) para que caigan exactamente sobre el borde
// de la foto sin importar la altura a la que estén.
const STAGE = 340;
const CENTER = STAGE / 2;
const PIN_RADIUS = 197; // radio de la foto (170) + ~27px hacia afuera

function pinPos(angleDeg: number) {
  const rad = (angleDeg * Math.PI) / 180;
  const x = CENTER + PIN_RADIUS * Math.cos(rad);
  const y = CENTER + PIN_RADIUS * Math.sin(rad);
  return {
    left: `${((x / STAGE) * 100).toFixed(2)}%`,
    top: `${((y / STAGE) * 100).toFixed(2)}%`,
  };
}

const pasosBase = [
  {
    num: '1',
    side: 'left',
    angle: -145,
    texto: 'Solicite asesoría en línea o visite cualquiera de nuestras oficinas.',
    lineWidth: '220px',
  },
  {
    num: '2',
    side: 'left',
    angle: 180,
    texto: 'Aporte la documentación solicitada y complete su vinculación.',
    lineWidth: '270px',
  },
  {
    num: '3',
    side: 'left',
    angle: 145,
    texto: 'Realice su aporte inicial y active su cuenta de asociado.',
    lineWidth: '240px',
  },
  {
    num: '4',
    side: 'right',
    angle: -35,
    texto: 'Reciba acompañamiento y empiece a disfrutar los beneficios FINTEGRAR.',
    lineWidth: '255px',
  },
  {
    num: '5',
    side: 'right',
    angle: 35,
    texto: 'Acceda al Portal de Servicios Digitales para gestionar sus productos.',
    lineWidth: '200px',
  },
];

const pasos = pasosBase.map((p) => ({ ...p, pin: pinPos(p.angle) }));

const textLeft = (side: string) => (side === 'left' ? '-300px' : '410px');
---

<section class="cf-section" aria-labelledby="cf-title">
  <div class="max-w-6xl mx-auto px-6">
    <h2 id="cf-title" class="cf-title">Cómo vincularse a FINTEGRAR</h2>

    <div class="cf-stage">
      <div class="cf-orbit-wrap">
        <div class="cf-photo-blob" aria-hidden="true"></div>
        <svg class="cf-arc" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="92" />
        </svg>
        <img
          src="/assets/img/orbit-familia.webp"
          alt="Familia asociada a FINTEGRAR"
          class="cf-photo"
          loading="lazy"
        />

        <div class="cf-pins" aria-hidden="true">
          {pasos.map((p) => (
            <span class="cf-pin-num" style={`top:${p.pin.top}; left:${p.pin.left};`}>{p.num}</span>
          ))}
        </div>
      </div>

      <div class="cf-steps">
        {pasos.map((p, i) => (
          <div
            class={`cf-step cf-step-${p.side}`}
            style={`--step-top:${p.pin.top}; --step-left:${textLeft(p.side)}; --step-line-width:${p.lineWidth};`}
          >
            <span class="cf-step-num">{p.num}</span>
            <p class="cf-step-text">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="cf-cta">
      <a href="https://tramitesvirtuales.fintegrar.com/" class="btn btn-primary cf-btn-ink" target="_blank" rel="noopener noreferrer">
        <Icon name="tabler:user-plus" class="w-4 h-4" aria-hidden="true" />
        Solicitar asesoría
      </a>
    </div>

    <div class="cf-requisitos">
      <h3 class="cf-req-title">Requisitos para ser asociado</h3>

      <div class="cf-req-cards">
        <div class="cf-req-member-card cf-req-fade">
          <div class="cf-req-card-head">
            <span class="cf-req-org-main">Persona</span>
            <br />
            <span class="cf-req-org-sub">Natural</span>
            <p class="cf-req-card-note">Artículo 11° del Estatuto</p>
          </div>
          <div class="cf-req-item-col">
            <span class="cf-req-items-label">Requisitos</span>
            <div class="cf-req-item-grid">
              <div class="cf-req-item">
                <span class="cf-req-item-num">1</span>
                <span class="cf-req-item-text">Ser mayor de dieciocho (18) años y no estar afectado por incapacidad legal.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">2</span>
                <span class="cf-req-item-text">Diligenciar el formato destinado para tal efecto.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">3</span>
                <span class="cf-req-item-text">Pagar la primera cuota de aportes sociales y depósito permanente establecida en el estatuto vigente.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="cf-req-member-card cf-req-fade">
          <div class="cf-req-card-head">
            <span class="cf-req-org-main">Persona</span>
            <br />
            <span class="cf-req-org-sub">Jurídica</span>
            <p class="cf-req-card-note">Artículo 12° del Estatuto<br />Sector salud, comercial y de servicios</p>
          </div>
          <div class="cf-req-item-col">
            <span class="cf-req-items-label">Requisitos</span>
            <div class="cf-req-item-grid">
              <div class="cf-req-item">
                <span class="cf-req-item-num">1</span>
                <span class="cf-req-item-text">Diligenciar el formato dispuesto para tal efecto.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">2</span>
                <span class="cf-req-item-text">Presentar la autorización de vinculación a FINTEGRAR expedida por el órgano competente.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">3</span>
                <span class="cf-req-item-text">Presentar cámara de comercio, RUT vigentes, y copia de cédula del representante legal.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">4</span>
                <span class="cf-req-item-text">Estados financieros del último año.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">5</span>
                <span class="cf-req-item-text">Pagar los aportes sociales consagrados en el estatuto vigente.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cf-section {
    background: var(--color-surface);
    padding: 6rem 0;
    overflow: hidden;
  }

  .cf-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    line-height: var(--lh-120);
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .cf-orbit-wrap {
    position: relative;
    width: 340px;
    height: 340px;
    margin: 0 auto;
    display: none;
  }

  .cf-photo-blob {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--color-brand-purple-rgb), 0.28) 0%, rgba(var(--color-brand-purple-rgb), 0.14) 60%, transparent 75%);
  }

  .cf-arc {
    position: absolute;
    inset: -34px;
    width: calc(100% + 68px);
    height: calc(100% + 68px);
    fill: none;
    stroke: var(--color-brand-purple);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 180 400;
    transform: rotate(100deg);
  }

  .cf-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 20px 45px rgba(var(--color-ink-rgb), 0.18);
  }

  /* Números-insignia: anclados exactamente sobre el borde del círculo,
     con top/left fijos por paso (ver frontmatter) y centrados sobre ese
     punto con translate(-50%,-50%). */
  .cf-pins {
    position: absolute;
    inset: 0;
  }

  .cf-pin-num {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-brand-purple);
    color: var(--color-white);
    font-weight: var(--fw-extrabold);
    font-size: 1.0625rem;
    font-family: var(--ff-heading);
    box-shadow: 0 4px 14px rgba(var(--color-ink-rgb), 0.3);
    border: 3px solid var(--color-white);
    z-index: 2;
  }

  .cf-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .cf-step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    text-align: left;
  }

  .cf-step-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-brand-purple);
    color: var(--color-white);
    font-weight: var(--fw-extrabold);
    font-size: 0.9375rem;
    font-family: var(--ff-heading);
  }

  .cf-step-text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: var(--lh-160);
    padding-top: 0.3rem;
  }

  .cf-cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .cf-btn-ink {
    background: var(--color-ink);
    color: var(--color-white);
  }

  /* A partir de desktop: la foto se muestra centrada con los números sobre
     su borde, y el texto de cada paso flota alrededor en columnas fijas
     (izquierda / derecha). El número visible pasa a vivir en .cf-pins
     (sobre la foto); en .cf-steps se oculta para no duplicarlo, dejando
     solo el texto con una línea divisoria del ancho del bloque. */
  @media (min-width: 1024px) {
    .cf-stage {
      position: relative;
      width: 340px;
      height: 340px;
      margin: 0 auto;
    }

    .cf-orbit-wrap {
      display: block;
      position: absolute;
      inset: 0;
      margin: 0;
    }

    .cf-steps {
      max-width: none;
      display: block;
      position: absolute;
      inset: 0;
      margin: 0;
    }

    .cf-step {
      position: absolute;
      top: var(--step-top);
      left: var(--step-left);
      width: 210px;
      padding-top: 0.75rem;
      display: block;
    }
    .cf-step-num { display: none; }

    .cf-step::before {
      content: '';
      position: absolute;
      top: 0;
      width: var(--step-line-width, 40px);
      height: 2px;
      background: var(--color-ink);
    }

    /* El borde que da hacia el círculo queda fijo/alineado; el que varía
       en ancho es el extremo exterior (lejos del círculo). */
    .cf-step-left::before {
      right: 0;
    }

    .cf-step-right::before {
      left: 0;
    }
  }

  @media (max-width: 639px) {
    .cf-section { padding: 3.5rem 0; }
    .cf-title { margin-bottom: 2.25rem; }
  }

  .cf-requisitos {
    margin-top: 7rem;
  }

  .cf-req-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    line-height: var(--lh-120);
    text-align: center;
    margin-bottom: 2rem;
  }

  .cf-req-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  .cf-req-member-card {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding: 3rem 2.5rem;
    min-height: 18.5rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: left;
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .cf-req-member-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .cf-req-card-head {
    flex-shrink: 0;
    width: 15rem;
    text-align: right;
  }

  .cf-req-org-main {
    font-family: var(--ff-heading);
    font-weight: var(--fw-extrabold);
    font-size: clamp(2.25rem, 3.5vw, 2.75rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
  }

  .cf-req-org-sub {
    font-family: var(--ff-heading);
    font-weight: var(--fw-regular);
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
  }

  .cf-req-card-note {
    font-size: 0.8125rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    line-height: var(--lh-140);
    margin-top: 0.75rem;
  }

  .cf-req-item-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cf-req-items-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-brand-purple);
  }

  .cf-req-item-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .cf-req-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .cf-req-item-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--color-brand-purple);
    color: var(--color-white);
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    margin-top: 0.0625rem;
  }

  .cf-req-item-text {
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    line-height: var(--lh-150);
  }

  @media (max-width: 767px) {
    .cf-req-member-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.75rem;
      min-height: 0;
    }
    .cf-req-card-head {
      width: auto;
      text-align: left;
    }
  }

  @media (max-width: 639px) {
    .cf-requisitos {
      margin-top: 4rem;
    }
  }

  .cf-req-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.21, 0.6, 0.35, 1),
      transform 0.6s cubic-bezier(0.21, 0.6, 0.35, 1);
    will-change: opacity, transform;
  }

  .cf-req-fade.cf-req-fade-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const cfReqFadeEls = document.querySelectorAll('.cf-req-fade');
  const cfReqFadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('cf-req-fade-visible', entry.isIntersecting);
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
  );
  cfReqFadeEls.forEach((el) => cfReqFadeObserver.observe(el));
</script>
