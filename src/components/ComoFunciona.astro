---
import { Icon } from 'astro-icon/components';
---

<section class="cf-section" aria-labelledby="cf-req-title">
  <div class="max-w-6xl mx-auto px-6">

    <div class="cf-requisitos" id="requisitos">
      <h3 id="cf-req-title" class="cf-req-title">Requisitos para ser asociado</h3>

      <div class="cf-req-cards">
        <!-- Tarjeta 1: Persona Natural -->
        <div class="cf-req-member-card cf-req-fade">
          <div class="cf-req-card-head">
            <span class="cf-req-org-main">Persona</span>
            <br />
            <span class="cf-req-org-sub">Natural</span>
            <p class="cf-req-card-note">Artículo 11° del Estatuto</p>
          </div>
          <div class="cf-req-item-col">
            <span class="cf-req-items-label">Requisitos</span>
            <div class="cf-req-item-grid">
              <div class="cf-req-item">
                <span class="cf-req-item-num">1</span>
                <span class="cf-req-item-text">Ser mayor de dieciocho (18) años y no estar afectado por incapacidad legal.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">2</span>
                <span class="cf-req-item-text">Diligenciar el formato destinado para tal efecto.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">3</span>
                <span class="cf-req-item-text">Pagar la primera cuota de aportes sociales y depósito permanente establecida en el estatuto vigente.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta 2: Persona Jurídica -->
        <div class="cf-req-member-card cf-req-fade">
          <div class="cf-req-card-head">
            <span class="cf-req-org-main">Persona</span>
            <br />
            <span class="cf-req-org-sub">Jurídica</span>
            <p class="cf-req-card-note">Artículo 12° del Estatuto<br />Sector salud, comercial y de servicios</p>
          </div>
          <div class="cf-req-item-col">
            <span class="cf-req-items-label">Requisitos</span>
            <div class="cf-req-item-grid">
              <div class="cf-req-item">
                <span class="cf-req-item-num">1</span>
                <span class="cf-req-item-text">Diligenciar el formato dispuesto para tal efecto.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">2</span>
                <span class="cf-req-item-text">Presentar la autorización de vinculación a FINTEGRAR expedida por el órgano competente.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">3</span>
                <span class="cf-req-item-text">Presentar cámara de comercio, RUT vigentes, y copia de cédula del representante legal.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">4</span>
                <span class="cf-req-item-text">Estados financieros del último año.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">5</span>
                <span class="cf-req-item-text">Pagar los aportes sociales consagrados en el estatuto vigente.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta 3: Proceso de Vinculación -->
        <div class="cf-req-member-card cf-req-member-card--proceso cf-req-fade">
          <div class="cf-req-card-head">
            <span class="cf-req-org-main">Proceso</span>
            <br />
            <span class="cf-req-org-sub">de Vinculación</span>
            <p class="cf-req-card-note">5 sencillos pasos para asociarse</p>
            <div class="cf-card-cta-wrap mt-6 hidden md:block">
              <a href="https://api.whatsapp.com/send/?phone=573174879669&text=Hola%2C+quisiera+informaci%C3%B3n+sobre+cr%C3%A9dito%2Fcartera.&type=phone_number&app_absent=0" class="btn btn-primary cf-btn-ink inline-flex items-center gap-2 text-sm px-5 py-2.5 rounded-full font-semibold" target="_blank" rel="noopener noreferrer">
                <Icon name="tabler:user-plus" class="w-4 h-4" aria-hidden="true" />
                Solicitar asesoría
              </a>
            </div>
          </div>
          <div class="cf-req-item-col">
            <span class="cf-req-items-label">Pasos para asociarse</span>
            <div class="cf-req-item-grid">
              <div class="cf-req-item">
                <span class="cf-req-item-num">1</span>
                <span class="cf-req-item-text"><strong>Solicite Asesoría:</strong> Solicite asesoría en línea o visite cualquiera de nuestras oficinas.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">2</span>
                <span class="cf-req-item-text"><strong>Documentación:</strong> Aporte la documentación solicitada y complete su vinculación.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">3</span>
                <span class="cf-req-item-text"><strong>Aporte Inicial:</strong> Realice su aporte inicial y active su cuenta de asociado.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">4</span>
                <span class="cf-req-item-text"><strong>Acompañamiento:</strong> Reciba acompañamiento y empiece a disfrutar los beneficios FINTEGRAR.</span>
              </div>
              <div class="cf-req-item">
                <span class="cf-req-item-num">5</span>
                <span class="cf-req-item-text"><strong>Portal Digital:</strong> Acceda al Portal de Servicios Digitales para gestionar sus productos.</span>
              </div>
            </div>
            <div class="mt-4 block md:hidden">
              <a href="https://api.whatsapp.com/send/?phone=573174879669&text=Hola%2C+quisiera+informaci%C3%B3n+sobre+cr%C3%A9dito%2Fcartera.&type=phone_number&app_absent=0" class="btn btn-primary cf-btn-ink inline-flex items-center justify-center gap-2 text-sm px-5 py-2.5 rounded-full font-semibold w-full" target="_blank" rel="noopener noreferrer">
                <Icon name="tabler:user-plus" class="w-4 h-4" aria-hidden="true" />
                Solicitar asesoría
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .cf-section {
    background: var(--color-surface);
    padding: 6rem 0;
    overflow: hidden;
  }

  .cf-requisitos {
    margin-top: 0;
  }

  .cf-req-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    line-height: var(--lh-120);
    text-align: center;
    margin-bottom: 2rem;
  }

  .cf-req-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  .cf-req-member-card {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding: 3rem 2.5rem;
    min-height: 18.5rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: left;
  }
  .cf-req-member-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .cf-req-member-card--proceso {
    background: var(--color-brand-purple);
    color: var(--color-white);
  }
  .cf-req-member-card--proceso .cf-req-org-main,
  .cf-req-member-card--proceso .cf-req-org-sub {
    color: var(--color-white);
  }
  .cf-req-member-card--proceso .cf-req-card-note {
    color: rgba(255, 255, 255, 0.85);
  }
  .cf-req-member-card--proceso .cf-req-items-label {
    color: var(--color-brand-yellow, #EFC747);
  }
  .cf-req-member-card--proceso .cf-req-item-num {
    background: var(--color-white);
    color: var(--color-brand-purple);
  }
  .cf-req-member-card--proceso .cf-req-item-text {
    color: var(--color-white);
  }
  .cf-req-member-card--proceso .btn-primary {
    background: var(--color-white);
    color: var(--color-brand-purple);
  }
  .cf-req-member-card--proceso .btn-primary:hover {
    background: rgba(255, 255, 255, 0.92);
  }

  .cf-req-card-head {
    flex-shrink: 0;
    width: 15rem;
    text-align: right;
  }

  .cf-req-org-main {
    font-family: var(--ff-heading);
    font-weight: var(--fw-extrabold);
    font-size: clamp(2.25rem, 3.5vw, 2.75rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
  }

  .cf-req-org-sub {
    font-family: var(--ff-heading);
    font-weight: var(--fw-regular);
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    line-height: var(--lh-100);
    color: var(--color-brand-purple);
  }

  .cf-req-card-note {
    font-size: 0.8125rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    line-height: var(--lh-140);
    margin-top: 0.75rem;
  }

  .cf-btn-ink {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .cf-req-item-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cf-req-items-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-brand-purple);
  }

  .cf-req-item-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .cf-req-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .cf-req-item-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--color-brand-purple);
    color: var(--color-white);
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    margin-top: 0.0625rem;
  }

  .cf-req-item-text {
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    line-height: var(--lh-150);
  }

  @media (max-width: 767px) {
    .cf-req-member-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.75rem;
      min-height: 0;
    }
    .cf-req-card-head {
      width: auto;
      text-align: left;
    }
  }

  .cf-req-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.21, 0.6, 0.35, 1),
      transform 0.6s cubic-bezier(0.21, 0.6, 0.35, 1);
    will-change: opacity, transform;
  }

  .cf-req-fade.cf-req-fade-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const cfReqFadeEls = document.querySelectorAll('.cf-req-fade');
  const cfReqFadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('cf-req-fade-visible', entry.isIntersecting);
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
  );
  cfReqFadeEls.forEach((el) => cfReqFadeObserver.observe(el));
</script>
