---
import { Icon } from 'astro-icon/components';
import { creditos, tasaNumero } from '@data/tasas';

// Nombres, modalidad, tasas y plazos máximos salen de src/data/tasas.ts (misma fuente que TasasVigentes).
// Las tasas son efectivas mensuales, expresadas en M.V. (mes vencido).
const extras: Record<string, { icon: string; nota?: string }> = {
  'ordinario':                { icon: 'tabler:credit-card',    nota: 'Se cancela con deducciones quincenales antes del 30 de noviembre del año en que se apruebe.' },
  'ahorro-navideno-anticipo': { icon: 'tabler:sparkles' },
  'eventos-especiales':       { icon: 'tabler:calendar-event' },
  'cuota-especial':           { icon: 'tabler:wallet' },
  'calamidad':                { icon: 'tabler:home-heart',     nota: 'Plazo máximo de 12 meses.' },
  'vacacional':               { icon: 'tabler:plane' },
  'largo-plazo':              { icon: 'tabler:calendar-check', nota: 'Las garantías se exigen de acuerdo con el monto solicitado.' },
  'educacion':                { icon: 'tabler:school' },
  'mejoras-vivienda':         { icon: 'tabler:home' },
  'compra-cartera':           { icon: 'tabler:refresh' },
};

const lineas = creditos.map((c) => ({
  id: c.id,
  nombre: c.nombre,
  subtitulo: c.modalidad,
  displayTasa: c.tasa,
  tasa: tasaNumero(c.tasa),
  // Solo el plazo confirmado en /creditos; si no hay, el simulador usa el tope técnico.
  maxMeses: c.maxMeses ?? 0,
  hastaNoviembre: Boolean(c.hastaNoviembre),
  icon: extras[c.id]?.icon ?? 'tabler:credit-card',
  nota: extras[c.id]?.nota ?? '',
  simulable: /\d/.test(c.tasa),
}))
  // Las líneas "según estudio" (con asesor) van al final; el resto conserva el orden de tasas.ts.
  .sort((a, b) => Number(b.simulable) - Number(a.simulable));
---

<section id="simulador" class="sim-section">
  <div class="max-w-7xl mx-auto px-6">
    <div class="sim-card reveal" id="simCard">

      <aside class="sim-aside">
        <h2 class="font-display sim-heading">Simulador de Crédito</h2>
        <p class="sim-lead">Haz tus cuentas con calma y sin compromiso. Te acompañamos a validar cuánto pagarías cada mes, para que decidas tranquilo y sigas creciendo.</p>

        <div class="sim-topbar" aria-hidden="true">
          <div class="sim-bar-track">
            <div class="sim-bar-fill" id="simBarFill"></div>
          </div>
          <ol class="sim-bar-steps">
            <li class="sim-bar-lbl" data-bar="0"><span class="sim-bar-num">1</span>Línea de crédito</li>
            <li class="sim-bar-lbl" data-bar="1"><span class="sim-bar-num">2</span>Cuota aproximada</li>
          </ol>
        </div>
      </aside>

      <div class="sim-body">

        <div class="sim-step active" id="step-1">
          <h3 class="step-title">1. Selecciona la línea de crédito</h3>

          <fieldset class="linea-select-wrap">
            <legend class="sr-only">Línea de crédito</legend>
            <div class="linea-opts" role="radiogroup">
              {lineas.map(l => l.simulable ? (
                <label class="linea-opt">
                  <input
                    type="radio"
                    name="linea"
                    class="linea-radio"
                    value={l.id}
                    data-tasa={l.tasa}
                    data-display={l.displayTasa}
                    data-max={l.maxMeses}
                    data-hasta-nov={l.hastaNoviembre ? '1' : undefined}
                    data-nota={l.nota}
                    data-nombre={l.nombre}
                    data-sub={l.subtitulo}
                  />
                  <span class="linea-opt-name">{l.nombre}</span>
                  <span class="linea-opt-tasa">{l.displayTasa}</span>
                  <span class="linea-opt-dot" aria-hidden="true"></span>
                </label>
              ) : (
                <div class="linea-opt linea-opt--consulta">
                  <span class="linea-opt-name">{l.nombre}</span>
                  <span class="linea-opt-tasa">Según estudio</span>
                  <span class="linea-opt-dot" aria-hidden="true"></span>
                </div>
              ))}
            </div>
            <p class="linea-leyenda"><strong>M.V.</strong> significa mes vencido: es la tasa que se aplica cada mes sobre tu saldo.<br />Cuota Especial y Compra de Cartera no tienen una tasa fija: un asesor analizará la solicitud e informará la tasa aplicable.</p>
          </fieldset>
        </div>

        <div class="sim-step" id="step-2">
          <a href="https://tramitesvirtuales.fintegrar.com" class="btn btn-accent btn-rp" target="_blank" rel="noopener noreferrer">
            Solicitar crédito
            <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
          </a>
          <button type="button" class="btn-back" id="back-2">
            <Icon name="tabler:arrow-left" class="w-4 h-4" aria-hidden="true" /> Cambiar línea
          </button>
          <h3 class="step-title">2. Cuota aproximada</h3>

          <div class="sim-layout">
            <div class="sim-inputs">
              <div class="inputs-2col">

                <div class="input-blk">
                  <label class="input-lbl" for="monto-text">¿Cuánto necesitas?</label>
                  <input type="text" class="monto-input" id="monto-text" value="" placeholder="Ej. $5.000.000" inputmode="numeric" autocomplete="off" />
                  <input type="hidden" id="monto" value="" />
                </div>

                <div class="input-blk">
                  <label class="input-lbl" for="plazo-input">¿En cuántos meses?</label>
                  <div class="plazo-input-wrap">
                    <input type="number" class="plazo-input" id="plazo-input" value="" placeholder="Ej. 12" min="1" />
                    <span class="plazo-unit">meses</span>
                  </div>
                  <input type="hidden" id="plazo" value="" />
                  <p class="field-hint" id="plazo-hint" hidden></p>
                </div>

              </div>
            </div>

            <div class="sim-result-panel">
              <div class="result-panel">
                <div class="rp-linea" id="linea-info"></div>
                <div class="sr-only">Tu cuota mensual aproximada</div>
                <div class="rp-big" id="cuota" aria-live="polite">—</div>
                <div class="rp-rows">
                  <div class="rp-row"><span>Tasa efectiva mensual</span><strong id="tasa-disp">—</strong></div>
                </div>
                <div class="rp-nota" id="nota"></div>
              </div>
            </div>
            <p class="sim-disclaimer">Este resultado es una guía para que te hagas una idea. La cuota final se confirma cuando estudiamos tu solicitud; esta simulación no es una oferta comercial ni la aprobación de un crédito.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .sim-section {
    background: var(--color-navbar-bg);
    padding: 8rem 0;
  }

  /* ── Tarjeta: aside oscuro + panel de trabajo ── */
  .sim-card {
    display: grid;
    grid-template-columns: 340px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .sim-aside {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.75rem 2.25rem;
    background: var(--color-brand-purple);
    color: var(--color-white);
    overflow: hidden;
  }
  .sim-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--fw-extrabold);
    line-height: var(--lh-115);
    color: var(--color-white);
    margin-bottom: 1rem;
  }
  .sim-lead {
    font-size: 0.9375rem;
    line-height: var(--lh-165);
    color: rgba(var(--color-white-rgb), 0.88);
  }

  /* ── Progreso (la barra se mantiene; el JS controla su ancho) ── */
  .sim-topbar {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .sim-bar-track {
    height: 4px;
    background: rgba(var(--color-white-rgb), 0.25);
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
    overflow: hidden;
  }
  .sim-bar-fill {
    height: 100%;
    width: 33%;
    background: var(--color-white);
    border-radius: var(--radius-full);
    transition: width var(--transition-slow);
  }
  .sim-bar-steps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sim-bar-lbl {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: rgba(var(--color-white-rgb), 0.65);
    transition: color var(--transition-base);
  }
  .sim-bar-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    border: 1.5px solid rgba(var(--color-white-rgb), 0.45);
    border-radius: var(--radius-full);
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }
  .sim-bar-lbl.active { color: var(--color-white); }
  .sim-bar-lbl.active .sim-bar-num {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  /* ── Panel de pasos ── */
  .sim-body { min-width: 0; }
  .sim-step {
    display: none;
    padding: 2rem 2.25rem;
    animation: simFadeIn 0.22s ease both;
  }
  .sim-step { position: relative; }
  .sim-step.active { display: block; }
  @keyframes simFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-brand-purple);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: 1.5rem;
    transition: opacity var(--transition-fast);
  }
  .btn-back { align-self: flex-start; }
  .btn-back:hover { opacity: 0.7; }

  .step-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    line-height: var(--lh-110);
    margin-bottom: 0.25rem;
  }
  .step-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: var(--lh-130);
    max-width: 520px;
  }

  /* ── Selector de línea (opciones compactas) ── */
  .linea-select-wrap { margin: 1.25rem 0 0; padding: 0; border: 0; min-width: 0; }
  .linea-select-wrap .input-lbl { padding: 0; }
  .linea-opts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .linea-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-white);
    cursor: pointer;
    transition: background var(--transition-base);
  }
  .linea-opt:hover { background: var(--color-surface); }
  .linea-radio {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .linea-opt-name {
    flex: 1;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    line-height: var(--lh-125);
  }
  .linea-opt-tasa {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-brand-purple);
    white-space: nowrap;
  }
  .linea-opt-dot {
    display: block;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid var(--color-border-mid);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
  }
  .linea-opt:has(.linea-radio:checked) { background: var(--color-surface); }
  .linea-opt:has(.linea-radio:checked) .linea-opt-dot {
    border-color: var(--color-ink);
    background: var(--color-ink);
    box-shadow: inset 0 0 0 3px var(--color-surface);
  }
  .linea-opt:has(.linea-radio:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }
  .linea-opt--consulta { cursor: default; background: var(--color-surface); }
  .linea-opt--consulta:hover { background: var(--color-surface); }
  .linea-opt--consulta .linea-opt-name,
  .linea-opt--consulta .linea-opt-tasa { color: var(--color-text-muted); }
  .linea-opt--consulta .linea-opt-dot { opacity: 0.35; border-style: dashed; }
  .linea-leyenda {
    margin-top: 0.75rem;
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    line-height: var(--lh-150);
  }

  /* ── Paso 2: entradas + resultado ── */
  .sim-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin-top: 1.25rem;
    align-items: stretch;
  }
  .sim-result-panel { display: flex; flex-direction: column; gap: 0.5rem; }
  .sim-result-panel .result-panel { flex: 1; }
  .inputs-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .input-lbl {
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-label);
    display: block;
    margin-bottom: 0.375rem;
  }
  .monto-input,
  .plazo-input {
    font-family: var(--ff-heading);
    font-size: 1.25rem;
    font-weight: var(--fw-extrabold);
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1.5px solid transparent;
    border-radius: var(--radius-md);
    padding: 0.4375rem 0.875rem;
    outline: none;
    transition: border-color var(--transition-base), background var(--transition-base);
  }
  .monto-input { width: 100%; margin-bottom: 0.375rem; }
  .monto-input:focus,
  .plazo-input:focus {
    border-color: var(--color-ink);
    background: var(--color-white);
  }
  .plazo-input-wrap {
    position: relative;
    margin-bottom: 0.375rem;
  }
  .plazo-input {
    width: 100%;
    padding-right: 4.5rem;
    -moz-appearance: textfield;
  }
  .plazo-input::-webkit-outer-spin-button,
  .plazo-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .plazo-unit {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
  }

  .field-hint[hidden] { display: none; }
  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-weight: var(--fw-medium);
  }

  /* Resultado: tarjeta compacta a la derecha */
  .result-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    background: var(--color-ink);
    border-radius: var(--radius-lg);
  }
  .rp-linea {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    margin-bottom: 0.75rem;
  }
  /* El contenido se inyecta por JS (sin el atributo de scope de Astro), por eso :global */
  .rp-linea :global(strong) {
    font-size: 0.875rem;
    font-weight: var(--fw-bold);
    color: var(--color-white);
    line-height: var(--lh-125);
  }
  .rp-linea :global(span) {
    font-size: 0.75rem;
    color: rgba(var(--color-white-rgb), 0.65);
    line-height: var(--lh-130);
  }
  .rp-big {
    font-family: var(--ff-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--fw-extrabold);
    color: var(--color-white);
    line-height: var(--lh-100);
  }
  .rp-rows {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-top: 1px solid rgba(var(--color-white-rgb), 0.12);
    align-self: stretch;
    margin-top: 1rem;
    padding-top: 0.75rem;
  }
  .rp-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
  }
  .rp-row span   { color: rgba(var(--color-white-rgb), 0.6); }
  .rp-row strong { color: var(--color-white); font-weight: var(--fw-semibold); }
  .rp-nota {
    align-self: stretch;
    text-align: left;
    font-size: 0.6875rem;
    color: rgba(var(--color-white-rgb), 0.55);
    line-height: var(--lh-140);
  }
  .rp-nota:not(:empty) { margin-top: 0.625rem; }
  .btn-rp {
    /* Incrustado en la esquina superior derecha del contenedor (la tarjeta recorta la esquina redondeada) */
    position: absolute;
    top: 0;
    right: 0;
    padding: 1rem 1.75rem 1rem 2rem;
    border-radius: 0 0 0 var(--radius-lg);
    background: var(--color-brand-purple);
    color: var(--color-white);
  }
  .btn-rp:hover {
    background: var(--color-brand-purple);
    filter: brightness(1.12);
    box-shadow: none;
  }
  .sim-disclaimer {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    line-height: var(--lh-150);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .sim-section { padding: 5rem 0; }
    .sim-card { grid-template-columns: 1fr; }
    .sim-aside { padding: 2rem 1.75rem; }
    .sim-topbar { padding-top: 1.5rem; }
    .sim-bar-steps { flex-direction: row; gap: 1.25rem; flex-wrap: wrap; }
    .sim-step { padding: 2rem 1.75rem; }
    /* Con el panel morado arriba, la esquina ya no es la de la tarjeta: botón flotante */
    .btn-rp { top: 1.25rem; right: 1.75rem; padding: 0.625rem 1.25rem; border-radius: var(--radius-full); }
  }
  @media (max-width: 767px) {
    .sim-section { padding: 3rem 0; }
    .linea-opts { grid-template-columns: 1fr; max-height: 17rem; overflow-y: auto; }
    .linea-opt { padding: 0.75rem 0.875rem; }
    .sim-card { border-radius: var(--radius-lg); }
    .sim-lead { display: none; }
    .sim-aside { padding: 1.5rem 1.25rem; }
    .sim-heading { margin-bottom: 0; }
    .sim-step { padding: 1.5rem 1.25rem; }
    .step-title { font-size: 1.25rem; }
    .inputs-2col { grid-template-columns: 1fr; gap: 1.25rem; }
    .sim-layout { grid-template-columns: 1fr; gap: 1.25rem; }
    .result-panel { padding: 1.25rem; }
    /* En celular el botón baja al final del paso, a todo el ancho */
    #step-2.active { display: flex; flex-direction: column; }
    .btn-rp { position: static; order: 10; width: 100%; margin-top: 1.25rem; padding: 0.75rem 1.25rem; border-radius: var(--radius-full); }
  }
</style>

<script>
  function setupSimulador() {
    let linea: { tasa: number; display: string; max: number | null; nota: string; nombre: string } | null = null;

    const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

    const fCOP = (n: number) =>
      new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 })
        .format(Math.max(0, Math.round(n)));
    const fNum = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    const parseMonto = (s: string) => parseInt(s.replace(/[^0-9]/g, '')) || 0;

    // Cuota fija con tasa efectiva mensual vencida: C = P × i / (1 − (1+i)^−n). Con tasa 0% → P / n.
    function calcCuota(P: number, iPct: number, n: number): number {
      if (n <= 0 || P <= 0) return 0;
      const i = iPct / 100;
      return i > 0 ? (P * i) / (1 - Math.pow(1 + i, -n)) : P / n;
    }

    // Plazo máximo: el confirmado en /creditos; Ordinario, los meses que faltan hasta el 30 de noviembre;
    // las demás líneas no publican máximo: null = sin límite de plazo.
    function maxPlazo(opt: HTMLElement): number | null {
      if (opt.dataset.hastaNov) {
        const ahora = new Date();
        const fin = new Date(ahora.getFullYear(), 10, 30);
        return Math.min(Math.max(Math.ceil((fin.getTime() - ahora.getTime()) / (30.44 * 86400000)), 1), 12);
      }
      const max = parseInt(opt.dataset.max || '0');
      return max > 0 ? max : null;
    }

    const barFill = el('simBarFill');
    const barLabels = document.querySelectorAll<HTMLElement>('.sim-bar-lbl');

    function showStep(idx: 0 | 1) {
      el('step-1')?.classList.toggle('active', idx === 0);
      el('step-2')?.classList.toggle('active', idx === 1);
      if (barFill) barFill.style.width = (idx === 0 ? 50 : 100) + '%';
      barLabels.forEach((l, i) => l.classList.toggle('active', i <= idx));
    }

    const montoHidden = el<HTMLInputElement>('monto');
    const montoText   = el<HTMLInputElement>('monto-text');
    // Aún no hay límites de monto definidos: sin mínimo y con un máximo provisional solo interno (no se muestra).
    const MONTO_MAX = 100000000;
    const plazoHidden = el<HTMLInputElement>('plazo');
    const plazoInput  = el<HTMLInputElement>('plazo-input');

    function update() {
      if (!linea) return;
      const monto = parseFloat(montoHidden?.value || '0');
      const plazo = parseInt(plazoHidden?.value || '0');
      const c = el('cuota');
      // Sin monto y plazo elegidos por la persona no se muestra ningún valor.
      if (c) c.textContent = monto > 0 && plazo > 0 ? fCOP(calcCuota(monto, linea.tasa, plazo)) : '—';
    }

    function setMonto(raw: number, formatText: boolean) {
      const v = Math.min(Math.max(raw, 0), MONTO_MAX);
      if (montoHidden) montoHidden.value = (formatText ? v : raw).toString();
      if (formatText && montoText) montoText.value = '$' + fNum(v);
      update();
    }

    function setPlazo(raw: number) {
      if (!raw) {
        if (plazoHidden) plazoHidden.value = '';
        if (plazoInput) plazoInput.value = '';
        update();
        return;
      }
      const max = linea?.max ?? Infinity;
      const v = Math.min(Math.max(raw, 1), max);
      if (plazoHidden) plazoHidden.value = v.toString();
      if (plazoInput) plazoInput.value = v.toString();
      update();
    }

    document.querySelectorAll<HTMLInputElement>('.linea-radio').forEach((opt) => opt.addEventListener('change', () => {
      if (!opt.checked || !opt.dataset.tasa) return;
      linea = {
        tasa: parseFloat(opt.dataset.tasa),
        display: opt.dataset.display!,
        max: maxPlazo(opt),
        nota: opt.dataset.nota!,
        nombre: opt.dataset.nombre!,
      };
      if (plazoInput) {
        if (linea.max) plazoInput.max = linea.max.toString();
        else plazoInput.removeAttribute('max');
      }
      const hint = el('plazo-hint');
      if (hint) {
        hint.textContent = linea.max ? `Entre 1 y ${linea.max} meses` : '';
        hint.hidden = !linea.max;
      }
      const tasa = el('tasa-disp'); if (tasa) tasa.textContent = linea.display;
      const nota = el('nota'); if (nota) nota.textContent = linea.nota;
      const info = el('linea-info');
      if (info) info.innerHTML = `<strong>${linea.nombre}</strong><span>${opt.dataset.sub}</span>`;
      // Cada línea nueva empieza con monto y plazo vacíos.
      if (montoHidden) montoHidden.value = '';
      if (montoText) montoText.value = '';
      setPlazo(0);
      showStep(1);
    }));

    el('back-2')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLInputElement>('.linea-radio').forEach((r) => (r.checked = false));
      showStep(0);
    });

    montoText?.addEventListener('input', () => setMonto(parseMonto(montoText.value), false));
    montoText?.addEventListener('blur', () => {
      if (parseMonto(montoText.value) > 0) setMonto(parseMonto(montoText.value), true);
      else { montoText.value = ''; setMonto(0, false); }
    });

    plazoInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', '+', 'e', ',', '.'].includes(e.key)) e.preventDefault();
    });
    plazoInput?.addEventListener('input', () => setPlazo(parseInt(plazoInput.value)));
    plazoInput?.addEventListener('blur', () => setPlazo(parseInt(plazoInput.value)));

    showStep(0);
  }

  setupSimulador();
  document.addEventListener('astro:after-swap', setupSimulador);
</script>
