---
import { convenios } from '@data/convenios';

// Se reparten los logos en dos filas y se duplica cada una para el loop
// infinito del marquee (ver @keyframes cvc-scroll / cvc-scroll-reverse).
const mitad = Math.ceil(convenios.length / 2);
const filaUno = convenios.slice(0, mitad);
const filaDos = convenios.slice(mitad);
const filaUnoLogos = [...filaUno, ...filaUno];
const filaDosLogos = [...filaDos, ...filaDos];
---

<section class="cvc-section" aria-labelledby="cvc-title">
  <div class="max-w-7xl mx-auto px-6">
    <h2 id="cvc-title" class="cvc-title">Convenios y alianzas para asociados</h2>
  </div>

  <div class="cvc-marquee" data-cvc-marquee>
    <div class="cvc-track">
      {filaUnoLogos.map((c) => (
        <div class="cvc-tile">
          <img src={c.logo} alt="Logo de convenio aliado FINTEGRAR" loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <div class="cvc-marquee cvc-marquee--reverse" data-cvc-marquee>
    <div class="cvc-track cvc-track--reverse">
      {filaDosLogos.map((c) => (
        <div class="cvc-tile">
          <img src={c.logo} alt="Logo de convenio aliado FINTEGRAR" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cvc-section {
    background: var(--color-navbar-bg);
    padding: 4rem 0;
    overflow: hidden;
  }

  .cvc-title {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    text-align: center;
    margin-bottom: 2rem;
  }

  .cvc-marquee {
    /* Ancho tope ≈ 6 tarjetas + 5 separaciones, para que en pantallas anchas
       nunca se vean más de 6 a la vez ni quede espacio vacío al hacer loop
       (el track siempre es más ancho que este contenedor). */
    box-sizing: border-box;
    max-width: calc(1040px + 3rem);
    margin-inline: auto;
    padding-inline: 1.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .cvc-marquee + .cvc-marquee {
    margin-top: 1rem;
  }

  .cvc-track {
    display: flex;
    width: max-content;
    gap: 1rem;
    animation: cvc-scroll 35s linear infinite;
  }
  .cvc-track--reverse {
    animation-name: cvc-scroll-reverse;
    animation-duration: 40s;
  }
  .cvc-marquee:hover .cvc-track {
    animation-play-state: paused;
  }

  .cvc-tile {
    flex-shrink: 0;
    width: 160px;
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-white);
    border: 1px solid var(--color-surface);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: border-color 0.25s;
  }
  .cvc-tile:hover {
    border-color: transparent;
  }
  .cvc-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.25s, opacity 0.25s;
  }
  .cvc-tile:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  @keyframes cvc-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes cvc-scroll-reverse {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cvc-track { animation: none; }
  }

  @media (max-width: 639px) {
    .cvc-section { padding: 2.5rem 0; }
    .cvc-tile { width: 128px; padding: 1.125rem; }
  }
</style>
