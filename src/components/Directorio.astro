---
const equipo = [
  {
    nombre: "Luis Hernando Loaiza Gallego",
    cargo: "Gerente · Representante Legal",
    email: ["lhloaiza@fintegrar.com"],
  },
  {
    nombre: "Juan Camilo Álvarez",
    cargo: "Sección Jurídica",
    email: ["juridica@fintegrar.com"],
  },
  {
    nombre: "Juan Camilo Álvarez",
    cargo: "Coordinación Crédito y Cartera",
    email: ["creditos@fintegrar.com", "cartera@fintegrar.com"],
  },
  {
    nombre: "Edilson Alzate Herrera",
    cargo: "Tesorería y Contabilidad",
    email: ["tesoreria@fintegrar.com"],
  },
  {
    nombre: "Diana María Sánchez",
    cargo: "Bienestar Social · Auxiliar Administrativa",
    email: ["bienestarsocial@fintegrar.com"],
  },
  {
    nombre: "Juan Pablo Bustamante",
    cargo: "Líder Marketing",
    email: ["marketing@fintegrar.com"],
  },
  {
    nombre: "Lina María Restrepo",
    cargo: "Ejecutiva Comercial",
    email: ["comercial@fintegrar.com"],
  },
];
---

<section id="directorio" class="dir-section" aria-labelledby="dir-title">
  <h2 id="dir-title" class="sr-only">Nuestro Equipo de Trabajo</h2>
  <div class="max-w-7xl mx-auto px-6">
    <div class="dir-grid reveal">
      {
        equipo.map((p) => (
          <div class="dir-card">
            <div class="dir-photo" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M4.5 19.5c1.5-3.5 4.5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </div>
            <span class="dir-card-name">{p.nombre}</span>
            <span class="dir-card-role">{p.cargo}</span>
            <span class="dir-card-emails">
              {p.email.map((e) => (
                <a href={`mailto:${e}`} class="dir-card-email">
                  {e}
                </a>
              ))}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir-section {
    background: var(--color-white);
    padding: 4rem 0;
  }

  .dir-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 15rem));
    justify-content: center;
    gap: 2.5rem 2rem;
  }

  .dir-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
  }

  .dir-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-md);
    background: var(--color-navbar-bg);
    border: 1px dashed rgba(var(--color-brand-purple-rgb), 0.35);
    color: rgba(var(--color-brand-purple-rgb), 0.4);
    margin-bottom: 0.5rem;
  }

  .dir-photo svg {
    width: 42%;
    height: 42%;
  }

  .dir-card-name {
    font-size: 0.9375rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .dir-card-role {
    font-size: 0.8125rem;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .dir-card-emails {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.35rem;
  }

  .dir-card-email {
    font-size: 0.8125rem;
    font-weight: var(--fw-bold);
    color: var(--color-brand-purple);
    text-decoration: none;
  }
  .dir-card-email:hover {
    text-decoration: underline;
  }

  @media (max-width: 639px) {
    .dir-section {
      padding: 3rem 0;
    }
    .dir-grid {
      grid-template-columns: repeat(2, minmax(0, 8rem));
    }
    .dir-photo {
      width: 6rem;
      height: 6rem;
    }
    .dir-card-name {
      white-space: normal;
    }
  }
</style>
