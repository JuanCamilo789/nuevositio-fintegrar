---
const gerente = {
  iniciales: "LH",
  nombre: "Luis Hernando Loaiza Gallego",
  cargo: "Gerente · Representante Legal",
  email: "lhloaiza@fintegrar.com",
};

const equipo = [
  {
    iniciales: "JU",
    nombre: "Abog. Juan Camilo Álvarez",
    cargo: "Sección Jurídica",
    email: ["juridica@fintegrar.com"],
  },
  {
    iniciales: "JU",
    nombre: "Juan Camilo Álvarez",
    cargo: "Coordinación Crédito y Cartera",
    email: ["creditos@fintegrar.com", "cartera@fintegrar.com"],
  },
  {
    iniciales: "TC",
    nombre: "Edilson Alzate Herrera",
    cargo: "Tesorería y Contabilidad",
    email: ["tesoreria@fintegrar.com"],
  },
  {
    iniciales: "BS",
    nombre: "Diana María Sánchez",
    cargo: "Bienestar Social · Auxiliar Administrativa",
    email: ["bienestarsocial@fintegrar.com"],
  },
  {
    iniciales: "JP",
    nombre: "Juan Pablo Bustamante",
    cargo: "Líder Marketing",
    email: ["marketing@fintegrar.com"],
  },
  {
    iniciales: "LR",
    nombre: "Lina María Restrepo",
    cargo: "Ejecutiva Comercial",
    email: ["comercial@fintegrar.com"],
  },
];
---

<section id="directorio" class="dir-section" aria-labelledby="dir-title">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-12 reveal">
      <h2 id="dir-title" class="font-display dir-heading">
        Nuestro Equipo de Trabajo
      </h2>
      <p class="dir-intro">
        Conozca las personas que hacen posible el funcionamiento de
        Fintegrar.
      </p>
    </div>

    <div class="dir-chief-wrap reveal">
      <div class="dir-chief">
        <div class="dir-chief-avatar">{gerente.iniciales}</div>
        <div>
          <div class="dir-chief-name">{gerente.nombre}</div>
          <div class="dir-chief-role">{gerente.cargo}</div>
          <a href={`mailto:${gerente.email}`} class="dir-email">
            <svg
              width="13"
              height="13"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
              ></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
              ></path>
            </svg>
            {gerente.email}
          </a>
        </div>
      </div>
    </div>

    <div class="dir-grid reveal">
      {
        equipo.map((p, i) => (
          <div
            class={`dir-card${i > 0 ? ` reveal-delay-${Math.min(i, 4)}` : ""}`}
          >
            <div class="dir-avatar">{p.iniciales}</div>
            <div class="dir-card-body">
              <div class="dir-name">{p.nombre}</div>
              <div class="dir-role">{p.cargo}</div>
              <div class="dir-emails">
                {p.email.map((e) => (
                  <a href={`mailto:${e}`} class="dir-email-sm">
                    {e}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir-section {
    background: var(--color-navbar-bg);
    padding: 5rem 0 6rem;
  }

  .dir-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    line-height: var(--lh-120);
    margin-bottom: 1rem;
  }
  .dir-intro {
    font-size: 1rem;
    color: var(--color-ink);
    opacity: 0.6;
    line-height: var(--lh-170);
  }

  .dir-chief-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .dir-chief {
    background: var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 8px 32px rgba(var(--color-navy-rgb), 0.22);
    max-width: 480px;
    width: 100%;
  }

  .dir-chief-avatar {
    width: 64px;
    height: 64px;
    background: rgba(var(--color-white-rgb), 0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-extrabold);
    font-size: 1.25rem;
    color: var(--color-white);
    flex-shrink: 0;
  }

  .dir-chief-name {
    font-size: 1rem;
    font-weight: var(--fw-bold);
    color: var(--color-white);
    line-height: var(--lh-130);
    margin-bottom: 0.25rem;
  }

  .dir-chief-role {
    font-size: 0.68rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-brand-yellow);
    margin-bottom: 0.5rem;
  }

  .dir-email {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.78rem;
    color: rgba(var(--color-white-rgb), 0.65);
    text-decoration: none;
    transition: color 0.15s;
  }
  .dir-email:hover {
    color: var(--color-white);
  }

  .dir-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .dir-grid > :nth-child(5) { grid-column-start: 2; }
  .dir-grid > :nth-child(6) { grid-column-start: 3; }

  .dir-card {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.125rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    box-shadow: 0 2px 8px rgba(var(--color-navy-rgb), 0.07);
    transition:
      box-shadow 0.25s,
      transform 0.25s;
  }
  .dir-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .dir-avatar {
    width: 48px;
    height: 48px;
    background: rgba(var(--color-navy-rgb), 0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.875rem;
    font-weight: var(--fw-bold);
    font-size: 0.875rem;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .dir-name {
    font-size: 0.875rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
    line-height: var(--lh-130);
    margin-bottom: 0.375rem;
  }

  .dir-role {
    font-size: 0.68rem;
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.8;
    line-height: var(--lh-135);
    margin-bottom: 0.75rem;
  }

  .dir-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .dir-emails {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: auto;
  }

  .dir-email-sm {
    font-size: 0.68rem;
    color: var(--color-ink);
    opacity: 0.6;
    text-decoration: none;
    transition:
      color 0.15s,
      opacity 0.15s;
    word-break: break-all;
  }
  .dir-email-sm:hover {
    color: var(--color-ink);
    opacity: 1;
  }

  @media (max-width: 1023px) {
    .dir-section {
      padding: 3.5rem 0 4.5rem;
    }
    .dir-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .dir-grid > :nth-child(5),
    .dir-grid > :nth-child(6) {
      grid-column-start: auto;
    }
  }
  @media (max-width: 767px) {
    .dir-section {
      padding: 3rem 0 3.5rem;
    }
  }
  @media (max-width: 639px) {
    .dir-section {
      padding: 2.5rem 0 3rem;
    }
    .dir-chief {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.5rem 1.25rem;
      max-width: 100%;
      gap: 1rem;
    }
    .dir-chief .dir-email {
      justify-content: center;
    }
    .dir-grid {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
    .dir-card {
      flex-direction: row;
      align-items: center;
      text-align: left;
      padding: 0.875rem 1rem;
      gap: 0.875rem;
    }
    .dir-avatar {
      width: 42px;
      height: 42px;
      font-size: 0.75rem;
      flex-shrink: 0;
      margin-bottom: 0;
    }
    .dir-card-body {
      align-items: flex-start;
      flex: 1;
      min-width: 0;
    }
    .dir-name {
      font-size: 0.8125rem;
    }
    .dir-role {
      font-size: 0.625rem;
      margin-bottom: 0.375rem;
    }
    .dir-email-sm {
      font-size: 0.625rem;
    }
  }
</style>
