---
const equipoBase = [
  {
    nombre: "Luis Hernando Loaiza Gallego",
    cargo: "Gerente · Representante Legal",
    email: ["lhloaiza@fintegrar.com"],
  },
  {
    nombre: "Juan Camilo Álvarez",
    cargo: "Sección Jurídica",
    email: ["juridica@fintegrar.com"],
  },
  {
    nombre: "Juan Camilo Álvarez",
    cargo: "Coordinación Crédito y Cartera",
    email: ["creditos@fintegrar.com", "cartera@fintegrar.com"],
  },
  {
    nombre: "Edilson Alzate Herrera",
    cargo: "Tesorería y Contabilidad",
    email: ["tesoreria@fintegrar.com"],
  },
  {
    nombre: "Diana María Sánchez",
    cargo: "Bienestar Social · Auxiliar Administrativa",
    email: ["bienestarsocial@fintegrar.com"],
  },
  {
    nombre: "Juan Pablo Bustamante",
    cargo: "Líder Marketing",
    email: ["marketing@fintegrar.com"],
  },
  {
    nombre: "Lina María Restrepo",
    cargo: "Ejecutiva Comercial",
    email: ["comercial@fintegrar.com"],
  },
];

const equipo = equipoBase.map((p) => ({
  ...p,
  iniciales: p.nombre
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join(""),
}));
---

<section id="directorio" class="dir-section" aria-labelledby="dir-title">
  <h2 id="dir-title" class="sr-only">Nuestro Equipo de Trabajo</h2>
  <div class="max-w-5xl mx-auto px-6">
    <div class="dir-list-card reveal">
      {
        equipo.map((p) => (
          <div class="dir-row">
            <span class="dir-row-avatar">{p.iniciales}</span>
            <span class="dir-row-name">{p.nombre}</span>
            <span class="dir-row-meta">
              <span class="dir-row-role">{p.cargo}</span>
              <span class="dir-row-emails">
                {p.email.map((e) => (
                  <a href={`mailto:${e}`} class="dir-row-email">
                    {e}
                  </a>
                ))}
              </span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir-section {
    background: var(--color-white);
    padding: 4rem 0;
  }

  .dir-list-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid rgba(var(--color-brand-purple-rgb), 0.12);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 0.5rem 1.75rem;
  }

  .dir-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    row-gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(var(--color-brand-purple-rgb), 0.1);
    margin: 0 -1.75rem;
    padding-left: 1.75rem;
    padding-right: 1.75rem;
    transition: background 0.15s;
  }

  .dir-row:hover {
    background: rgba(var(--color-brand-purple-rgb), 0.04);
  }

  .dir-row:last-child {
    border-bottom: none;
  }

  .dir-row-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-brand-purple-rgb), 0.12);
    color: var(--color-brand-purple);
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    margin-right: 0.25rem;
  }

  .dir-row-name {
    flex: 1 1 auto;
    font-size: 1rem;
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }

  .dir-row-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .dir-row-role {
    font-size: 0.875rem;
    color: var(--color-ink);
    opacity: 0.65;
  }

  .dir-row-emails {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .dir-row-email {
    font-size: 0.875rem;
    font-weight: var(--fw-bold);
    color: var(--color-brand-purple);
    text-decoration: none;
  }
  .dir-row-email:hover {
    text-decoration: underline;
  }

  @media (max-width: 639px) {
    .dir-section {
      padding: 3rem 0;
    }
    .dir-list-card {
      padding: 0.5rem 1.25rem;
    }
    .dir-row {
      flex-wrap: wrap;
      align-items: center;
      row-gap: 0.5rem;
      padding: 1rem 0;
      margin: 0 -1.25rem;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
    .dir-row-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      width: 100%;
      padding-left: calc(36px + 0.25rem);
    }
  }
</style>
