---
import { Icon } from 'astro-icon/components';
import { noticias } from '../data/noticias';

const eventos = [
  {
    fecha: '15 ago',
    items: [
      {
        titulo: 'Taller de Educación Financiera y Ahorro',
        desc: 'Cuidamos tu futuro: aprende estrategias prácticas para optimizar tus finanzas personales...',
        href: '/eventos/taller-educacion-financiera',
      },
    ],
  },
  {
    fecha: '20 ago',
    items: [
      {
        titulo: 'Feria Virtual de Vivienda y Crédito Educativo',
        desc: 'Conoce las tasas preferenciales y asesoría personalizada para tus metas familiares...',
        href: '/eventos/feria-vivienda-educacion',
      },
    ],
  },
  {
    fecha: '25 ago',
    items: [
      {
        titulo: 'Sorteo Semanal de Asociados y Beneficios',
        desc: 'Participa automáticamente por ser asociado activo al día con tus aportes sociales...',
        href: '/eventos/sorteo-semanal',
      },
      {
        titulo: 'Jornada de Salud y Bienestar Familiar',
        desc: 'Chequeos preventivos y beneficios exclusivos gracias a nuestras alianzas IPS...',
        href: '/eventos/jornada-salud',
      },
    ],
  },
  {
    fecha: '30 ago',
    items: [
      {
        titulo: 'Webinar: Inversión Segura y Rentabilidad con CDAT',
        desc: 'Descubre cómo hacer crecer tus ahorros con el respaldo y solidez de FINTEGRAR...',
        href: '/eventos/webinar-cdat',
      },
    ],
  },
];
---

<section id="novedades" class="news-events-section text-white" aria-labelledby="novedades-title" data-dark-bg>
  <div class="max-w-7xl mx-auto px-6">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

      <!-- COLUMNA IZQUIERDA: Últimas Noticias -->
      <div class="lg:col-span-7 space-y-6">

        <!-- Header Noticias -->
        <div class="pb-2">
          <h2 id="novedades-title" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-heading">
            Novedades
          </h2>
        </div>

        <!-- Grid de 3 Tarjetas de Noticias -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {noticias.slice(0, 3).map((n) => (
            <article class="bg-white text-slate-800 rounded-sm p-2.5 pb-4 shadow-md hover:shadow-lg transition-shadow flex flex-col justify-between group">
              <div>
                <!-- Top Meta -->
                <div class="text-[11px] font-medium text-slate-400 mb-2">
                  <span>{n.fecha}</span>
                </div>

                <!-- Sin imagen -->
                <div class="aspect-[4/3] w-full rounded-sm overflow-hidden mb-3 bg-slate-100 border border-dashed border-slate-200 flex flex-col items-center justify-center gap-1.5 text-slate-300">
                  <Icon name="tabler:photo-off" class="w-8 h-8" aria-hidden="true" />
                  <span class="text-[10px] font-medium text-slate-400">Sin imagen</span>
                </div>

                <!-- Título -->
                <h3 class="text-sm font-bold text-slate-800 leading-snug group-hover:text-[var(--color-brand-purple)] transition-colors line-clamp-3">
                  <a href={`/noticias/${n.slug}`}>
                    {n.titulo}
                  </a>
                </h3>
              </div>
            </article>
          ))}
        </div>

      </div>

      <!-- COLUMNA DERECHA: Próximos Eventos -->
      <div class="lg:col-span-5 space-y-6">

        <!-- Header Eventos -->
        <div class="pb-2">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-heading">
            Programación
          </h2>
        </div>

        <!-- Lista de Eventos -->
        <div class="divide-y divide-white/20">
          {eventos.map((evGroup) => (
            <div class="py-3.5 first:pt-0 last:pb-0 flex items-start gap-4">
              <!-- Columna de Fecha -->
              <div class="w-16 sm:w-20 flex-shrink-0 pt-0.5">
                <span class="text-base sm:text-lg font-extrabold text-white font-heading">
                  {evGroup.fecha}
                </span>
              </div>

              <!-- Lista de ítems del día -->
              <div class="flex-1 space-y-3">
                {evGroup.items.map((item) => (
                  <div class="space-y-0.5">
                    <h3 class="text-sm font-bold text-white leading-tight hover:text-[var(--color-brand-yellow)] transition-colors">
                      <a href={item.href} class="flex items-start gap-1.5">
                        <span class="text-white/60 font-bold">•</span>
                        <span>{item.titulo}</span>
                      </a>
                    </h3>
                    <p class="text-xs text-white/70 leading-snug pl-3 line-clamp-1">
                      {item.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .news-events-section {
    background: #00132B;
    padding: 5rem 0;
  }

  @media (max-width: 1023px) {
    .news-events-section {
      padding: 4rem 0;
    }
  }

  @media (max-width: 639px) {
    .news-events-section {
      padding: 3rem 0;
    }
  }
</style>
