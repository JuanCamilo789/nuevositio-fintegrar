---
---

<div class="hero-banner relative w-full mt-0 overflow-hidden" data-dark-bg>
  <img
    src="/assets/img/banner-completo.png"
    alt=""
    class="w-full h-full object-cover"
    loading="lazy"
  />
  <div class="hero-banner-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="hero-banner-text absolute inset-0 flex items-center">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <div class="hero-banner-row flex items-center gap-6 sm:gap-8">
        <img
          src="/assets/logos/logo1.png"
          alt="FINTEGRAR"
          class="hero-banner-logo brightness-0 invert flex-shrink-0"
        />
        <span class="hero-banner-divider flex-shrink-0" aria-hidden="true"></span>
        <div>
          <h2 class="hero-banner-title whitespace-nowrap">Crecer juntos es nuestro propósito.</h2>
          <p class="hero-banner-lead whitespace-nowrap">Soluciones pensadas para acompañarle hoy y construir un mejor mañana.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-banner {
    aspect-ratio: 21 / 4;
  }
  @media (max-width: 639px) {
    .hero-banner {
      aspect-ratio: 4 / 3;
    }
  }

  .hero-banner-logo {
    height: 3rem;
    width: auto;
  }
  @media (max-width: 639px) {
    .hero-banner-logo {
      height: 2rem;
    }
  }

  .hero-banner-divider {
    width: 1px;
    height: 3rem;
    background: rgba(var(--color-white-rgb), 0.4);
  }
  @media (max-width: 639px) {
    .hero-banner-divider {
      height: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-banner-row {
      gap: 1rem;
    }
  }

  .hero-banner-scrim {
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(var(--color-ink-rgb), 0.9) 0%,
      rgba(var(--color-ink-rgb), 0.65) 40%,
      rgba(var(--color-ink-rgb), 0.2) 70%,
      rgba(var(--color-ink-rgb), 0) 90%
    );
  }

  .hero-banner-text {
    z-index: 2;
  }

  .hero-banner-title {
    font-family: var(--ff-heading);
    font-size: clamp(0.9375rem, 2.9vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-white);
    text-shadow: 0 2px 12px rgba(var(--color-ink-rgb), 0.35);
  }

  .hero-banner-lead {
    font-family: var(--ff-heading);
    font-size: clamp(0.6875rem, 1vw, 0.9375rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: var(--lh-160);
    color: rgba(var(--color-white-rgb), 0.75);
    margin-top: 0.375rem;
    text-shadow: 0 1px 8px rgba(var(--color-ink-rgb), 0.3);
  }

  @media (max-width: 639px) {
    .hero-banner-lead {
      display: none;
    }
  }
</style>
