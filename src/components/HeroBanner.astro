---
---

<div class="hero-banner relative w-full mt-0 overflow-hidden" data-dark-bg>
  <img
    src="/assets/img/banner-completo.png"
    alt=""
    class="w-full h-full object-cover"
    loading="lazy"
  />
  <div class="hero-banner-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="hero-banner-text absolute inset-0 flex items-center z-[3]">
    <div class="max-w-7xl mx-auto px-6 w-full relative">
      <div class="relative inline-block w-full">
        <!-- Watermark -->
        <div class="hero-banner-watermark absolute top-1/2 left-0 -translate-y-1/2 pointer-events-none select-none z-[-1]" aria-hidden="true">
          <span class="block font-bold whitespace-nowrap">Crecer juntos es</span>
          <span class="block font-normal whitespace-nowrap">nuestro propósito.</span>
        </div>

        <!-- Foreground Title -->
        <h2 class="hero-banner-title whitespace-nowrap text-left relative z-10">
          <span class="block font-bold">Crecer juntos es</span>
          <span class="block font-normal">nuestro propósito.</span>
        </h2>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-banner {
    aspect-ratio: 21 / 4;
  }
  @media (max-width: 639px) {
    .hero-banner {
      aspect-ratio: 4 / 3;
    }
  }

  .hero-banner-logo {
    height: 3rem;
    width: auto;
  }
  @media (max-width: 639px) {
    .hero-banner-logo {
      height: 2rem;
    }
  }

  .hero-banner-divider {
    width: 1px;
    height: 3rem;
    background: rgba(var(--color-white-rgb), 0.4);
  }
  @media (max-width: 639px) {
    .hero-banner-divider {
      height: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-banner-row {
      gap: 1rem;
    }
  }

  .hero-banner-scrim {
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(var(--color-ink-rgb), 0.9) 0%,
      rgba(var(--color-ink-rgb), 0.65) 40%,
      rgba(var(--color-ink-rgb), 0.2) 70%,
      rgba(var(--color-ink-rgb), 0) 90%
    );
  }

  .hero-banner-text {
    z-index: 2;
  }

  .hero-banner-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.5rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-white);
    text-shadow: 0 2px 12px rgba(var(--color-ink-rgb), 0.35);
  }

  .hero-banner-watermark {
    font-family: var(--ff-heading);
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.08); /* Solid color, low opacity */
    -webkit-text-stroke: 0;
  }

  .hero-banner-lead {
    font-family: var(--ff-heading);
    font-size: clamp(0.6875rem, 1vw, 0.9375rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: var(--lh-160);
    color: rgba(var(--color-white-rgb), 0.75);
    margin-top: 0.375rem;
    text-shadow: 0 1px 8px rgba(var(--color-ink-rgb), 0.3);
  }

  @media (max-width: 639px) {
    .hero-banner-lead {
      display: none;
    }
  }
</style>
