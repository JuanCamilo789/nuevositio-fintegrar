---
import InnerLayout from './InnerLayout.astro';

interface Props {
  pageTitle: string;
  pageSubtitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
  updateDate?: string;
  maxWidth?: string;
}

const { 
  pageTitle, 
  pageSubtitle, 
  breadcrumbs, 
  updateDate,
  maxWidth = 'max-w-3xl'
} = Astro.props;
---

<InnerLayout
  pageTitle={pageTitle}
  pageSubtitle={pageSubtitle}
  breadcrumbs={breadcrumbs}
>
  <section class="legal-section">
    <div class={`${maxWidth} mx-auto px-6`}>
      <div class="legal-body">
        <slot />

        {updateDate && (
          <p class="legal-update">
            <strong>Última actualización:</strong> {updateDate}
          </p>
        )}
      </div>
    </div>
  </section>
</InnerLayout>

<style is:global>
  .legal-section {
    background: #fff;
    padding: 4rem 0 5rem;
  }
  .legal-body h2 {
    font-family: var(--ff-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: #172B36;
    margin: 4rem 0 1.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-surface);
    line-height: 1.25;
  }
  .legal-body h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .legal-body p {
    font-size: 0.875rem;
    color: #172B36;
    opacity: 0.9;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .legal-body ul, .legal-body ol {
    padding-left: 2rem;
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .legal-body ul {
    list-style-type: disc;
  }
  .legal-body ol {
    list-style-type: decimal;
  }
  .legal-body li {
    font-size: 0.875rem;
    color: #172B36;
    opacity: 0.9;
    line-height: 1.5;
    padding-left: 0.5rem;
  }
  /* Soporte para datos del editor */
  .legal-body li[data-list="alpha"], .legal-body ol ol { list-style-type: lower-alpha; }
  .legal-body li[data-list="roman"], .legal-body ol ol ol { list-style-type: lower-roman; }
  .legal-body li[data-list="ordered"] { list-style-type: decimal; }
  .legal-body li[data-list="bullet"] { list-style-type: disc; }
  /* Estilo para los títulos generados por Quill (h3) */
  .legal-body h3 {
    font-family: var(--ff-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: #172B36;
    margin: 3rem 0 1.25rem;
    line-height: 1.3;
  }
  .legal-body a {
    color: #172B36;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }
  .legal-body a:hover { opacity: 0.8; }

  .legal-update {
    margin-top: 4rem !important;
    padding-top: 2rem;
    border-top: 1px solid var(--color-surface);
    font-size: 0.875rem !important;
    opacity: 0.5 !important;
    text-align: right;
  }

  @media (max-width: 640px) {
    .legal-section {
      padding: 2rem 0 3rem;
    }
    .legal-body h2 {
      margin: 2rem 0 1rem;
      padding-top: 1.5rem;
    }
    .legal-body h3 {
      margin: 1.5rem 0 0.75rem;
    }
    .legal-body p {
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    .legal-body li {
      line-height: 1.4;
    }
    .legal-body ul, .legal-body ol {
      margin: 1.25rem 0;
      gap: 0.75rem;
      padding-left: 1.5rem;
    }
    .legal-update {
      margin-top: 2.5rem !important;
    }
  }
</style>
