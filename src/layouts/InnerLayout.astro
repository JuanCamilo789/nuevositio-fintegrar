---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  pageTitle: string;
  pageSubtitle?: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  pageTitle,
  pageSubtitle,
  description,
  breadcrumbs = [],
} = Astro.props;

const metaTitle = `${pageTitle} — Fintegrar`;
const metaDesc  = description ?? `${pageTitle} — Fondo de Empleados Fintegrar.`;
---

<Layout title={metaTitle} description={metaDesc}>
  <Navbar />

  <div class="page-hero">
    <div class="max-w-7xl mx-auto px-6">
      <nav class="pg-breadcrumb" aria-label="Rutas">
        <a href="/" class="pg-breadcrumb-link pg-breadcrumb-home">
          <Icon name="tabler:home" class="w-3.5 h-3.5" aria-hidden="true" />
          Inicio
        </a>
        {breadcrumbs.map((crumb) =>
          crumb.href
            ? <><Icon name="tabler:chevron-right" class="pg-breadcrumb-sep w-3.5 h-3.5" aria-hidden="true" /><a href={crumb.href} class="pg-breadcrumb-link">{crumb.label}</a></>
            : <><Icon name="tabler:chevron-right" class="pg-breadcrumb-sep w-3.5 h-3.5" aria-hidden="true" /><span class="pg-breadcrumb-current">{crumb.label}</span></>
        )}
        {breadcrumbs.length === 0 &&
          <><Icon name="tabler:chevron-right" class="pg-breadcrumb-sep w-3.5 h-3.5" aria-hidden="true" /><span class="pg-breadcrumb-current">{pageTitle}</span></>
        }
      </nav>

      <h1 class="pg-title">{pageTitle}</h1>
      {pageSubtitle && <p class="pg-subtitle">{pageSubtitle}</p>}
    </div>
  </div>

  <main>
    <slot />
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    background: var(--gradient-brand);
    padding: calc(var(--header-h) + 4.5rem) 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .pg-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    margin-bottom: 1.5rem;
  }
  .pg-breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: rgba(var(--color-mint-white-rgb), 0.65);
    text-decoration: none;
    font-weight: var(--fw-medium);
    transition: color 0.15s;
  }
  .pg-breadcrumb-link:hover { color: var(--color-brand-yellow); }
  .pg-breadcrumb-home svg {
    opacity: 0.8;
  }
  .pg-breadcrumb-sep {
    width: 13px;
    height: 13px;
    color: rgba(var(--color-mint-white-rgb), 0.35);
    flex-shrink: 0;
  }
  .pg-breadcrumb-current {
    color: var(--color-white);
    font-weight: var(--fw-semibold);
  }

  .pg-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: var(--fw-bold);
    color: var(--color-white);
    line-height: var(--lh-115);
    letter-spacing: -0.015em;
    position: relative;
    z-index: 1;
  }
  .pg-subtitle {
    font-size: 0.9375rem;
    color: rgba(var(--color-mint-white-rgb), 0.68);
    margin-top: 0.625rem;
    position: relative;
    z-index: 1;
    line-height: var(--lh-160);
    max-width: 640px;
  }
  @media (min-width: 1024px) {
    .pg-subtitle { max-width: none; }
  }
  @media (max-width: 639px) {
    .page-hero { padding: calc(var(--header-h) + 3rem) 0 2.5rem; }
  }
</style>
